page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  background: #f6f7fa;
  color: #111827;
  font-size: 32rpx;
  line-height: 1.58;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button::after {
  border: 0;
}

button {
  box-sizing: border-box;
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 0 0 calc(36rpx + env(safe-area-inset-bottom));
  background: #f6f7fa;
}

.page-card {
  overflow: hidden;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.035);
}

.arrow {
  margin-top: 4rpx;
  flex: none;
  color: #acafb5;
  font-size: 37rpx;
  font-weight: 300;
  line-height: 1;
}

.screen-section-title {
  display: flex;
  min-height: 74rpx;
  padding: 26rpx 28rpx 14rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #6d7178;
  font-size: 28rpx;
  font-weight: 600;
}

.screen-section-title text:last-child {
  color: #90949a;
  font-size: 26rpx;
  font-weight: 500;
}

/* 页面底部的返回控件。微信自带的返回箭头在左上角且很小，
   对主要用户群不够好按，所以在正文流末尾再给一组大按钮。 */
.page-nav {
  display: flex;
  padding: 28rpx;
  gap: 16rpx;
}

.page-nav-button {
  display: flex;
  min-height: 92rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 20rpx;
  background: #ffffff;
  color: #334155;
  font-size: 29rpx;
  font-weight: 620;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.03);
  transition: transform 0.12s ease, background-color 0.12s ease;
}

.page-nav-button:last-child {
  border-color: #1d5fd1;
  background: linear-gradient(135deg, #2568dc 0%, #1d5fd1 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(29, 95, 209, 0.22);
}

.page-nav-button.tap-active {
  transform: scale(0.985);
  background: #eef2f7;
}

.page-nav-button:last-child.tap-active {
  transform: scale(0.985);
  background: #174ea9;
}

@media (max-width: 340px) {
  page {
    font-size: 28rpx;
  }

  .page-shell {
    width: 100%;
  }

  .screen-section-title {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
}

@media (min-width: 700px) {
  .page-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    margin: 0;
    padding-right: 0;
    padding-left: 0;
  }

  .screen-section-title {
    padding-right: 32px;
    padding-left: 32px;
  }
}
