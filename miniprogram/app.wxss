page {
  box-sizing: border-box;
  width: 100%;
  min-height: 100%;
  background: #f5f5f5;
  color: #111111;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button::after {
  border: 0;
}

button {
  box-sizing: border-box;
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 100vh;
  padding: 0 0 calc(36rpx + env(safe-area-inset-bottom));
  background: #f5f5f5;
}

.page-card {
  overflow: hidden;
  border-radius: 0;
  background: #ffffff;
}

.screen-section-title {
  display: flex;
  min-height: 70rpx;
  padding: 24rpx 28rpx 13rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #8a8a8a;
  font-size: 27rpx;
  font-weight: 600;
}

.screen-section-title text:last-child {
  color: #9a9a9a;
  font-size: 24rpx;
  font-weight: 500;
}

/* 页面底部的返回控件。微信自带的返回箭头在左上角且很小，
   对主要用户群不够好按，所以在正文流末尾再给一组大按钮。 */
.page-nav {
  display: flex;
  padding: 28rpx;
  gap: 20rpx;
}

.page-nav-button {
  display: flex;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid #dfe4e1;
  border-radius: 16rpx;
  background: #ffffff;
  color: #2f4a3c;
  font-size: 28rpx;
  font-weight: 600;
}

.page-nav-button.tap-active {
  background: #eef3f0;
}

@media (max-width: 340px) {
  page {
    font-size: 28rpx;
  }

  .page-shell {
    width: 100%;
  }

  .screen-section-title {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
}

@media (min-width: 700px) {
  .page-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    margin: 0;
    padding-right: 0;
    padding-left: 0;
  }

  .screen-section-title {
    padding-right: 32px;
    padding-left: 32px;
  }
}
