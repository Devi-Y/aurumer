.partner-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.partner-card {
  box-sizing: border-box;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 20rpx;
  background: #ffffff;
}

.partner-card.is-brand {
  border-color: rgba(29, 95, 209, 0.14);
  background: linear-gradient(135deg, #ffffff 0%, #f5f8ff 100%);
}

.partner-tap {
  opacity: 0.78;
}

.partner-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.partner-badge {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #64748b;
  font-size: 19rpx;
  font-weight: 640;
  line-height: 1.45;
}

.partner-badge.is-brand {
  background: #e9f1ff;
  color: #1d5fd1;
}

.partner-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1e293b;
  font-size: 26rpx;
  font-weight: 660;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.partner-go {
  flex: none;
  color: #1d5fd1;
  font-size: 23rpx;
  font-weight: 640;
}

.partner-tagline {
  display: block;
  margin-top: 8rpx;
  color: #475569;
  font-size: 23rpx;
  line-height: 1.5;
}

.partner-disclosure {
  display: block;
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.45;
}
