.admin-shell { min-height: 100vh; padding: 28rpx 20rpx; background: #f4f6f9; box-sizing: border-box; }
.admin-card { display: flex; flex-direction: column; gap: 18rpx; padding: 28rpx; background: #fff; border-radius: 20rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1a1f27; }
.note { font-size: 26rpx; line-height: 1.6; color: #5c6470; }
.label { font-size: 27rpx; font-weight: 600; color: #2b313b; }
.field { padding: 20rpx; background: #f4f6f9; border-radius: 12rpx; font-size: 28rpx; color: #222; }
.action { width: 100%; margin: 0; background: #1d5fd1; color: white; font-size: 28rpx; }
.status { font-size: 28rpx; color: #1555ad; font-weight: 600; }
.error { font-size: 26rpx; color: #b42318; }
.back { padding: 30rpx; color: #1d5fd1; font-size: 28rpx; }
