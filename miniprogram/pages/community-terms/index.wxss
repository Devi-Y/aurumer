.terms-head { display:flex; flex-direction:column; gap:12rpx; padding:28rpx; }
.terms-title { font-size:38rpx; font-weight:650; color:#1a1f27; }
.terms-muted { color:#7a8390; font-size:23rpx; line-height:1.7; }
.terms-card { display:flex; flex-direction:column; gap:18rpx; margin:0 20rpx 20rpx; padding:26rpx; color:#2b313b; font-size:27rpx; line-height:1.7; }
.terms-price { font-size:36rpx; font-weight:650; color:#1a1f27; }
.terms-heading { font-size:29rpx; font-weight:650; color:#1a1f27; }
.terms-contact { margin:8rpx 0 0; font-size:27rpx; color:#1d5fd1; background:#f1f5fb; }
