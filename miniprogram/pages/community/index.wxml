<view class="page-shell community-shell">
  <!-- 交流群页：群里聊什么、适合谁、怎么加入。收费写在复制按钮正下方，没有「下一步」。 -->
  <view class="community-head">
    <text class="community-title">会员群</text>
    <text class="community-sub">公开资料与工具使用交流</text>
  </view>

  <view class="page-card community-card">
    <view class="sec">
      <text class="sec-title">群里聊什么</text>
      <view class="sec-rows">
        <view wx:for="{{topics}}" wx:key="key" class="sec-row">
          <text class="row-label">{{item.label}}</text>
          <text class="row-value">{{item.value}}</text>
        </view>
      </view>
    </view>
    <view class="sec">
      <text class="sec-title">适合谁</text>
      <view wx:for="{{fit}}" wx:key="*this" class="sec-point">
        <text>{{item}}</text>
      </view>
      <text class="sec-muted">{{unfit}}</text>
    </view>
    <view class="sec">
      <text class="sec-title">怎么加入</text>
      <text class="community-price">{{priceLabel}}</text>
      <text class="join-disclosure">{{promotionNote}}</text>
      <text class="join-disclosure">{{purchaseNote}}</text>
      <view class="terms-link" bindtap="openTerms" hover-class="tap-active" aria-role="button">查看服务与退款约定 ›</view>
      <block wx:if="{{join}}">
        <text class="sec-text">复制微信号，在微信「添加朋友」里粘贴搜索。</text>
        <view class="join-action" bindtap="copyWechat" hover-class="join-action-active" aria-role="button" aria-label="{{join.label}}">{{join.label}}</view>
        <text class="join-disclosure">{{join.disclosure}}</text>
      </block>
      <text wx:else class="sec-muted">加入方式整理中。</text>
    </view>
  </view>

  <view class="page-footer">
    <text class="footer-note">{{footerDisclaimer}}</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
