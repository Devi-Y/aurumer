<view class="page-shell community-shell">
  <!-- 对标问岳会员收银台：一进页即亮价格、核心权益标签、一键直拉微信支付 -->
  <view class="page-card community-pay-hero">
    <view class="cp-kicker-row">
      <text class="cp-kicker">年度会员群</text>
      <text class="cp-refund-pill">入群7天内无理由全额退</text>
    </view>
    <text class="community-title">公开资料共读 · 工具答疑交流</text>

    <view class="cp-price-row">
      <text class="cp-currency">¥</text>
      <text class="cp-price-num">{{priceCny}}</text>
      <text class="cp-price-term">/ {{termLabel}}</text>
      <text class="cp-no-auto">不自动续费</text>
    </view>

    <view class="cp-tags-row">
      <text class="cp-tag">一手财报与公告交流</text>
      <text class="cp-tag">望潮使用一对一答疑</text>
      <text class="cp-tag">纯净交流 · 不荐股喊单</text>
    </view>

    <!-- 已开通 / 核对异常 / 待支付 主操作区 -->
    <block wx:if="{{order && order.paid && !verificationPending}}">
      <view class="cp-paid-box">
        <text class="cp-paid-badge">✓ 已开通会员群</text>
        <text wx:if="{{order.paid && !verificationPending && order.endsText}}" class="cp-paid-meta">有效期至 {{order.endsText}}</text>
        <text wx:else class="cp-paid-meta">已付款成功，请打开二维码添加群主进群（服务期从入群日算起）</text>
        <button wx:if="{{qrReady}}" class="wxpay-btn" bindtap="openPaidQr">打开群主微信二维码</button>
        <view class="cp-order-foot">
          <text wx:if="{{order.orderId}}" class="sec-muted">订单 {{order.orderId}}</text>
          <text wx:if="{{order.orderId}}" class="inline-link" bindtap="copyOrderId" aria-role="button">复制单号</text>
          <button class="inline-btn-link" bindtap="refreshOrder" loading="{{checking}}" disabled="{{checking}}">刷新状态</button>
        </view>
      </view>
    </block>

    <block wx:elif="{{(checkoutReady || (checking && canPayConfig)) && (!order || !order.paid)}}">
      <button class="wxpay-btn" bindtap="buy" loading="{{paying}}" disabled="{{paying || verificationPending}}">立即微信支付 ¥{{priceCny}}</button>
      <text class="cp-pay-sub">支付成功自动弹出群主二维码 · 24小时内拉你进群</text>
      <view class="cp-legal-row">
        <text class="join-disclosure">点击即确认满18周岁并同意</text>
        <text class="inline-link" bindtap="openTerms" aria-role="button">《服务与退款约定》</text>
      </view>
    </block>

    <block wx:else>
      <text wx:if="{{purchaseNote}}" class="join-disclosure">{{purchaseNote}}</text>
      <view class="inline-link" bindtap="openTerms" aria-role="button">查看《服务与退款约定》 ›</view>
    </block>

    <block wx:if="{{verificationPending || (order && !order.paid)}}">
      <view class="cp-pending-bar">
        <text class="sec-muted">{{verificationPending ? '订单状态待核对，已付款请刷新：' : '订单处理中，请刷新状态避免重复付款：'}}</text>
        <view class="cp-pending-actions">
          <button class="inline-btn-link" bindtap="refreshOrder" loading="{{checking}}" disabled="{{checking}}">刷新订单状态</button>
          <button open-type="contact" class="inline-btn-link">联系客服</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 辅助咨询入口：安静放在下方，不与微信支付主按钮打架 -->
  <view wx:if="{{join}}" class="page-card community-consult-card">
    <view class="consult-row" bindtap="copyWechat" hover-class="tap-active" aria-role="button" aria-label="{{join.label}}">
      <view class="consult-left">
        <text class="consult-title">付款前想先问清楚？</text>
        <text class="join-disclosure">{{join.disclosure}}</text>
      </view>
      <text class="consult-action">{{copiedWechatSuccess ? '✓ 已复制微信号' : '复制微信咨询 ›'}}</text>
    </view>
    <view wx:if="{{copiedWechatSuccess}}" class="copy-step-box">
      <text class="copy-step-title">✓ 微信号已复制：回微信点右上角「⊕ → 添加朋友」粘贴即可</text>
    </view>
    <view wx:if="{{adminAllowed}}" class="admin-row">
      <text class="inline-link" bindtap="openAdmin" aria-role="button">群务管理 ›</text>
    </view>
  </view>

  <view class="page-footer">
    <text class="footer-note">{{footerDisclaimer}}</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>

  <view wx:if="{{showQr && order.paid && !verificationPending}}" class="qr-overlay" bindtap="closePaidQr">
    <view class="qr-dialog" catchtap="keepPaidQrOpen">
      <text class="qr-title">长按二维码 2 秒，添加群主进群</text>
      <image class="qr-image" src="{{qrImage}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <text class="qr-hint">通过后第一时间拉你进年度会员群</text>
      <view class="qr-close" bindtap="closePaidQr" aria-role="button">关闭</view>
    </view>
  </view>
</view>
