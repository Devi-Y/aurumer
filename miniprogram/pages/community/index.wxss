/* 会员群高价值收银台：原价现价鲜明对照、六大权益清晰有质感、一键直拉微信支付 */

.community-shell {
  padding-top: 22rpx;
  background: #f3f5f9;
}

.community-pay-hero {
  display: flex;
  margin: 0 24rpx 22rpx;
  padding: 32rpx 28rpx 30rpx;
  flex-direction: column;
  gap: 18rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(15, 23, 42, 0.06);
}

.cp-kicker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.cp-kicker {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #173468;
  color: #f8e7b8;
  font-size: 24rpx;
  font-weight: 760;
}

.cp-refund-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ebfaf2;
  color: #0d8a52;
  font-size: 24rpx;
  font-weight: 740;
}

.community-title {
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 840;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
}

.community-sub {
  margin-top: -6rpx;
  color: #475569;
  font-size: 27rpx;
  font-weight: 560;
  line-height: 1.48;
}

.cp-price-box {
  display: flex;
  padding: 22rpx 24rpx;
  flex-direction: column;
  gap: 12rpx;
  border: 2rpx solid #fde6c4;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #fffaf2 0%, #fff4e4 100%);
}

.cp-price-main-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.cp-now-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.cp-now-tag {
  align-self: center;
  margin-right: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #dc2626;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 760;
}

.cp-currency {
  color: #b91c1c;
  font-size: 38rpx;
  font-weight: 850;
}

.cp-price-num {
  color: #b91c1c;
  font-size: 74rpx;
  font-weight: 880;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.cp-price-term {
  color: #7c2d12;
  font-size: 30rpx;
  font-weight: 700;
}

.cp-daily-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #fed7aa;
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 760;
}

.cp-origin-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cp-origin-price {
  color: #64748b;
  font-size: 27rpx;
  font-weight: 640;
  text-decoration: line-through;
}

.cp-save-badge {
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 24rpx;
  font-weight: 740;
}

.cp-no-auto {
  margin-left: auto;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 620;
}

.cp-tags-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cp-tag {
  display: flex;
  align-items: center;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 640;
  line-height: 1.45;
}

.cp-tag::before {
  margin-right: 12rpx;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 850;
  content: "✓";
}

.wxpay-btn {
  display: flex;
  width: 100% !important;
  min-height: 110rpx;
  margin: 4rpx 0 0 !important;
  padding: 0 28rpx !important;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #09c765 0%, #06ad56 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  box-shadow: 0 10rpx 26rpx rgba(7, 193, 96, 0.28);
}

.wxpay-btn::after {
  border: none;
}

.cp-pay-sub {
  color: #334155;
  font-size: 25rpx;
  font-weight: 620;
  text-align: center;
}

.cp-legal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  text-align: center;
}

/* 六大年度核心权益卡 */
.cp-perks-card {
  display: flex;
  margin: 0 24rpx 22rpx;
  padding: 30rpx 26rpx 28rpx;
  flex-direction: column;
  gap: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.cp-perks-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.cp-perks-title {
  color: #0f172a;
  font-size: 35rpx;
  font-weight: 820;
}

.cp-perks-sub {
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 720;
}

.cp-perk-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cp-perk-item {
  display: flex;
  padding: 20rpx 20rpx;
  align-items: flex-start;
  gap: 18rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
}

.cp-perk-no {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 840;
  font-variant-numeric: tabular-nums;
}

.cp-perk-body {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.cp-perk-name {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1.35;
}

.cp-perk-desc {
  color: #475569;
  font-size: 25rpx;
  line-height: 1.5;
}

.cp-guarantee-strip {
  display: flex;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: #f1f6ff;
}

.cp-guarantee-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border-right: 1rpx solid #dbe6f7;
  text-align: center;
}

.cp-guarantee-cell:last-child {
  border-right: none;
}

.cp-guarantee-v {
  color: #173468;
  font-size: 28rpx;
  font-weight: 800;
}

.cp-guarantee-k {
  color: #475569;
  font-size: 24rpx;
  font-weight: 580;
}

.cp-compliance-strip {
  display: flex;
  padding: 14rpx 18rpx;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
  background: #fffbeb;
}

.cp-compliance-pill {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #fef3c7;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 780;
}

.cp-compliance-copy {
  flex: 1;
  min-width: 0;
  color: #78350f;
  font-size: 24rpx;
  font-weight: 620;
  line-height: 1.4;
}

.cp-paid-box {
  display: flex;
  padding: 22rpx;
  flex-direction: column;
  gap: 14rpx;
  border-radius: 22rpx;
  background: #effaf4;
}

.cp-paid-badge {
  color: #0d8a52;
  font-size: 32rpx;
  font-weight: 780;
}

.cp-paid-meta {
  color: #1e3a2f;
  font-size: 28rpx;
  line-height: 1.55;
}

.cp-order-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-pending-bar {
  display: flex;
  padding: 18rpx 20rpx;
  flex-direction: column;
  gap: 10rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.cp-pending-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.inline-link {
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 700;
}

.inline-btn-link {
  margin: 0 !important;
  padding: 6rpx 0 !important;
  background: transparent !important;
  color: #1d5fd1 !important;
  font-size: 27rpx !important;
  font-weight: 700 !important;
  line-height: 1.4 !important;
}

.inline-btn-link::after {
  border: none;
}

.community-consult-card {
  display: flex;
  margin: 0 24rpx 22rpx;
  padding: 24rpx 26rpx;
  flex-direction: column;
  gap: 14rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.consult-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.consult-left {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.consult-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 720;
}

.consult-action {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 720;
}

.copy-step-box {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #effaf4;
}

.copy-step-title {
  color: #0f6e43;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.admin-row {
  padding-top: 8rpx;
  border-top: 1rpx solid #edf1f7;
}

.sec-muted,
.join-disclosure {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.tap-active {
  background: #edf2fb;
}

.qr-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.qr-dialog {
  display: flex;
  width: 600rpx;
  max-width: 90vw;
  padding: 36rpx 32rpx;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.qr-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 760;
  text-align: center;
}

.qr-image {
  width: 100%;
  border-radius: 16rpx;
}

.qr-hint {
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.qr-close {
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 30rpx;
  font-weight: 700;
}

.page-footer {
  display: flex;
  padding: 8rpx 28rpx 0;
  justify-content: center;
  text-align: center;
}

.footer-note {
  max-width: 600rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .community-pay-hero, .cp-perks-card, .community-consult-card { margin-left: 14rpx; margin-right: 14rpx; }
  .community-title { font-size: 34rpx; }
  .cp-price-num { font-size: 58rpx; }
}

@media (min-width: 700px) {
  .community-pay-hero, .cp-perks-card, .community-consult-card {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .community-title { font-size: 24px; }
  .cp-price-num { font-size: 36px; }
}
