/* 付费会员群页：适老化大字号、主次分明的微信直付 + 复制微信号双通道 */

.community-shell {
  background: #f6f7fa;
}

.community-head {
  display: flex;
  margin-bottom: 10rpx;
  padding: 24rpx 28rpx 16rpx;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
}

.community-title {
  color: #0f172a;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.28;
}

.community-sub {
  color: #334155;
  font-size: 29rpx;
  line-height: 1.58;
}

.community-card {
  margin: 0 24rpx 24rpx;
  border-radius: 28rpx;
}

.community-pay-card {
  border: 2rpx solid rgba(29, 95, 209, 0.16);
  background: linear-gradient(180deg, #f7faff 0%, #ffffff 45%);
}

.sec {
  display: flex;
  padding: 28rpx 26rpx 30rpx;
  flex-direction: column;
  gap: 16rpx;
}

.sec + .sec {
  border-top: 1rpx solid #edf0f4;
}

.sec-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 740;
}

.sec-rows {
  overflow: hidden;
  border-radius: 18rpx;
  background: #f5f8fc;
}

.sec-row {
  display: flex;
  padding: 20rpx 22rpx;
  gap: 20rpx;
}

.sec-row + .sec-row {
  border-top: 1rpx solid #e6ebf2;
}

.row-label {
  width: 170rpx;
  flex: none;
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.55;
}

.row-value {
  min-width: 0;
  flex: 1;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.55;
}

.sec-point {
  position: relative;
  padding-left: 28rpx;
  color: #1e293b;
  font-size: 30rpx;
  line-height: 1.62;
}

.sec-point::before {
  position: absolute;
  top: 20rpx;
  left: 4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1d5fd1;
  content: "";
}

.sec-text {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.62;
}

.sec-muted {
  color: #64748b;
  font-size: 27rpx;
  line-height: 1.6;
}

.wechat-alt-divider {
  height: 2rpx;
  margin: 12rpx 0 4rpx;
  background: #e8edf5;
}

.join-action {
  display: flex;
  width: 100%;
  min-height: 106rpx;
  margin: 6rpx 0 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2568dc 0%, #1d5fd1 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 720;
  line-height: 1.35;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(29, 95, 209, 0.24);
  transition: transform 0.12s ease;
}

.join-action.is-secondary {
  border: 2rpx solid #1d5fd1;
  background: #eef4ff;
  color: #1d5fd1;
  box-shadow: none;
}

.join-action-active {
  transform: scale(0.985);
  opacity: 0.9;
}

.copy-step-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(21, 153, 96, 0.28);
  border-radius: 20rpx;
  background: #effaf4;
}

.copy-step-title {
  color: #0f6e43;
  font-size: 30rpx;
  font-weight: 760;
}

.copy-step-body {
  color: #1e3a2f;
  font-size: 28rpx;
  line-height: 1.6;
}

.join-disclosure {
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

.community-price {
  color: #1d5fd1;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.3;
}

.terms-link {
  padding: 12rpx 0;
  color: #1d5fd1;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.6;
  background: transparent;
  text-align: left;
}

.tap-active {
  background: #edf2fb;
}

.qr-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.qr-dialog {
  display: flex;
  width: 600rpx;
  max-width: 90vw;
  padding: 36rpx 32rpx;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.qr-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 760;
  text-align: center;
}

.qr-image {
  width: 100%;
  border-radius: 16rpx;
}

.qr-hint {
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.qr-close {
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 30rpx;
  font-weight: 700;
}

.page-footer {
  display: flex;
  padding: 12rpx 28rpx 0;
  justify-content: center;
  text-align: center;
}

.footer-note {
  max-width: 600rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

@media (max-width: 340px) {
  .community-card { margin-left: 14rpx; margin-right: 14rpx; }
  .community-title { font-size: 40rpx; }
  .row-label { width: 148rpx; font-size: 26rpx; }
  .row-value, .sec-point { font-size: 27rpx; }
}

@media (min-width: 700px) {
  .community-head { padding-left: 32px; padding-right: 32px; }
  .community-card { margin-left: 32px; margin-right: 32px; }
  .row-label { width: 130px; }
}
