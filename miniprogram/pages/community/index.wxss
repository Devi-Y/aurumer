/* 对标问岳收银台：价格清晰、标签利落、一键直拉微信支付 */

.community-shell {
  padding-top: 24rpx;
  background: #f3f5f9;
}

.community-pay-hero {
  display: flex;
  margin: 0 24rpx 22rpx;
  padding: 32rpx 28rpx 30rpx;
  flex-direction: column;
  gap: 20rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.05);
}

.cp-kicker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.cp-kicker {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 740;
}

.cp-refund-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #ebfaf2;
  color: #0d8a52;
  font-size: 24rpx;
  font-weight: 720;
}

.community-title {
  color: #0f172a;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  line-height: 1.3;
}

.cp-price-row {
  display: flex;
  padding: 16rpx 22rpx;
  align-items: baseline;
  gap: 8rpx;
  border-radius: 22rpx;
  background: #f6f9fe;
}

.cp-currency {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 800;
}

.cp-price-num {
  color: #0f172a;
  font-size: 68rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.cp-price-term {
  color: #475569;
  font-size: 30rpx;
  font-weight: 660;
}

.cp-no-auto {
  margin-left: auto;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 600;
}

.cp-tags-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cp-tag {
  display: flex;
  align-items: center;
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.45;
}

.cp-tag::before {
  margin-right: 14rpx;
  color: #07c160;
  font-size: 30rpx;
  font-weight: 800;
  content: "✓";
}

.wxpay-btn {
  display: flex;
  width: 100% !important;
  min-height: 108rpx;
  margin: 6rpx 0 0 !important;
  padding: 0 28rpx !important;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #09c765 0%, #06ad56 100%);
  color: #ffffff;
  font-size: 35rpx;
  font-weight: 780;
  line-height: 1.3;
  box-shadow: 0 10rpx 26rpx rgba(7, 193, 96, 0.28);
}

.wxpay-btn::after {
  border: none;
}

.cp-pay-sub {
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.cp-legal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 4rpx;
  text-align: center;
}

.cp-paid-box {
  display: flex;
  padding: 22rpx;
  flex-direction: column;
  gap: 14rpx;
  border-radius: 22rpx;
  background: #effaf4;
}

.cp-paid-badge {
  color: #0d8a52;
  font-size: 32rpx;
  font-weight: 780;
}

.cp-paid-meta {
  color: #1e3a2f;
  font-size: 28rpx;
  line-height: 1.55;
}

.cp-order-foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-pending-bar {
  display: flex;
  padding: 18rpx 20rpx;
  flex-direction: column;
  gap: 10rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.cp-pending-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.inline-link {
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 700;
}

.inline-btn-link {
  margin: 0 !important;
  padding: 6rpx 0 !important;
  background: transparent !important;
  color: #1d5fd1 !important;
  font-size: 27rpx !important;
  font-weight: 700 !important;
  line-height: 1.4 !important;
}

.inline-btn-link::after {
  border: none;
}

.community-consult-card {
  display: flex;
  margin: 0 24rpx 22rpx;
  padding: 24rpx 26rpx;
  flex-direction: column;
  gap: 14rpx;
  border-radius: 26rpx;
  background: #ffffff;
}

.consult-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.consult-left {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
}

.consult-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 720;
}

.consult-action {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 720;
}

.copy-step-box {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #effaf4;
}

.copy-step-title {
  color: #0f6e43;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.admin-row {
  padding-top: 8rpx;
  border-top: 1rpx solid #edf1f7;
}

.sec-muted,
.join-disclosure {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.tap-active {
  background: #edf2fb;
}

.qr-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
}

.qr-dialog {
  display: flex;
  width: 600rpx;
  max-width: 90vw;
  padding: 36rpx 32rpx;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.qr-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 760;
  text-align: center;
}

.qr-image {
  width: 100%;
  border-radius: 16rpx;
}

.qr-hint {
  color: #334155;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.qr-close {
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 30rpx;
  font-weight: 700;
}

.page-footer {
  display: flex;
  padding: 8rpx 28rpx 0;
  justify-content: center;
  text-align: center;
}

.footer-note {
  max-width: 600rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .community-pay-hero, .community-consult-card { margin-left: 14rpx; margin-right: 14rpx; }
  .community-title { font-size: 34rpx; }
  .cp-price-num { font-size: 56rpx; }
}

@media (min-width: 700px) {
  .community-pay-hero, .community-consult-card { margin-left: 32px; margin-right: 32px; }
}
