<template name="chart-visual">
  <view class="visual-card">
    <text class="visual-title">{{item.title}}</text>
    <text wx:if="{{item.hint}}" class="visual-hint">{{item.hint}}</text>

    <view wx:if="{{item.stats && item.stats.length}}" class="chart-stats">
      <view wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label" class="chart-stat">
        <text>{{stat.label}}</text>
        <text>{{stat.value}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'columns'}}" class="column-chart">
      <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="column-slot">
        <view class="column-bar {{col.tone}}" style="height: {{col.height}}%;"></view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'solid'}}" class="solid-chart">
      <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="solid-slot">
        <text class="solid-value">{{col.valueText}}</text>
        <view class="solid-pillar-wrap">
          <view class="solid-bar {{col.tone}} tone-{{col.colorIndex}}" style="height: {{col.height}}%;"></view>
        </view>
        <text class="solid-label">{{col.label}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'bars'}}" class="bar-chart">
      <view wx:for="{{item.items}}" wx:for-item="bar" wx:key="id" class="bar-row">
        <view class="bar-copy"><text>{{bar.label}}</text><text>{{bar.valueText}}</text></view>
        <view class="bar-track">
          <view class="bar-value {{bar.tone}} tone-{{bar.colorIndex}}" style="width: {{bar.width}}%;"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'line'}}" class="line-chart-wrap">
      <canvas type="2d" id="{{item.canvasId}}" class="line-chart-canvas"></canvas>
      <view class="column-labels">
        <text>{{item.lowLabel}}</text>
        <text>{{item.latestLabel}}</text>
        <text>{{item.highLabel}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'meter'}}" class="meter-chart">
      <view class="meter-track">
        <view class="meter-fill" style="width: {{item.percent}}%;"></view>
        <view class="meter-dot" style="left: {{item.percent}}%;"></view>
      </view>
      <view class="meter-labels">
        <text>{{item.lowLabel}}</text>
        <text>{{item.midLabel}}</text>
        <text>{{item.highLabel}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'tiles'}}" class="tile-chart">
      <view wx:for="{{item.items}}" wx:for-item="tile" wx:key="id" class="tile-cell">
        <text>{{tile.label}}</text>
        <text>{{tile.valueText}}</text>
      </view>
    </view>
  </view>
</template>

<view class="page-shell detail-shell">
  <view wx:if="{{ready}}" class="detail-content">
    <view class="detail-hero">
      <view class="hero-top">
        <text class="hero-label">{{view.marketLabel}}</text>
        <text class="hero-meta">{{dataAsOf || '同步中'}}</text>
      </view>
      <view class="hero-name-row">
        <text class="hero-title">{{view.title}}</text>
        <text wx:if="{{view.code}}" class="hero-code">{{view.code}}</text>
      </view>
      <view wx:if="{{(view.market == 'gold' || view.market == 'guru') && view.researchScore != null}}" class="hero-stats">
        <text class="hero-stat">{{view.researchScoreLabel || '评分'}} {{view.researchScore}}</text>
      </view>
      <view wx:elif="{{view.overview && view.overview.categoryTag}}" class="hero-stats">
        <text class="hero-stat hero-category-tag">{{view.overview.categoryTag}}</text>
      </view>
    </view>

    <view class="page-card detail-hero-body">
      <view class="conclusion-card">
        <text class="conclusion-label">结论</text>
        <text class="conclusion-grade">{{view.primaryJudgment}}</text>
      </view>

      <view wx:if="{{view.highlights.length}}" class="highlight-panel">
        <view wx:for="{{view.highlights}}" wx:key="label" class="highlight-cell">
          <text class="highlight-label">{{item.label}}</text>
          <text class="highlight-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="detail-tabs" scroll-x="true" enable-flex="true" show-scrollbar="false" enhanced="true">
      <view class="detail-tabs-inner">
        <view
          wx:for="{{view.modules}}"
          wx:key="id"
          class="detail-tab {{activeModule == item.id ? 'on' : ''}}"
          data-module="{{item.id}}"
          bindtap="switchModule"
          hover-class="detail-tab-tap"
          aria-role="tab"
          aria-selected="{{activeModule == item.id}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="module-panel">
      <view wx:if="{{activeModule == 'summary' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">先看答案</text>
        <text class="module-answer">{{view.answer || '结论待核验'}}</text>
        <view wx:if="{{view.strategy}}" class="strategy-card tone-{{view.strategy.tone}}">
          <view class="strategy-card-head">
            <text class="strategy-card-title">策略信号</text>
            <view class="strategy-card-head-right">
              <text class="strategy-card-label">{{view.strategy.label}}</text>
              <view class="details-toggle-inline" bindtap="toggleStrategy" hover-class="tap-active">
                <text>{{strategyExpanded ? '收起' : '展开'}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{strategyExpanded}}">
            <text class="strategy-card-action">{{view.strategy.action}}</text>
            <text class="strategy-card-trigger">触发：{{view.strategy.trigger}}</text>
            <text class="strategy-card-basis">口径：{{view.strategy.basis}}</text>
          </view>
          <text wx:else class="collapsed-hint">点击"展开"查看触发条件与口径。</text>
        </view>
        <template wx:if="{{view.visual}}" is="chart-visual" data="{{item: view.visual}}" />
        <view wx:if="{{!view.answer}}" class="module-empty">当前没有可展示的结论。</view>
      </view>

      <view wx:if="{{(activeModule == 'price' || activeModule == 'finance' || activeModule == 'research') && view.market == 'gold'}}" class="module-content">
        <text class="module-title">{{activeModule == 'price' ? '价格与位置' : (activeModule == 'finance' ? '数据与质量' : '研究图表')}}</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前模块暂无足够数据。</view>

        <view wx:if="{{activeModule == 'finance' && view.metrics.length}}" class="metric-panel">
          <text class="block-title">{{view.metricsTitle || '关键数据'}}</text>
          <view class="metric-grid">
            <view wx:for="{{view.metrics}}" wx:key="*this" class="metric">
              <text>{{item[0]}}</text>
              <text>{{item[1]}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{activeModule == 'research' && view.analysis.length}}" class="section-card analysis-card">
          <view class="analysis-head">
            <text class="block-title">{{view.analysisTitle || '研究要点'}}</text>
            <view class="details-toggle-inline" bindtap="toggleDetails" hover-class="tap-active">
              <text>{{detailsExpanded ? '收起分析' : '完整分析'}}</text>
            </view>
          </view>
          <view wx:if="{{detailsExpanded}}">
            <view wx:for="{{view.analysis}}" wx:key="title" class="analysis-block">
              <text class="analysis-index">{{item.indexLabel}}</text>
              <view class="analysis-copy">
                <text class="analysis-title">{{item.title}}</text>
                <text class="analysis-body">{{item.body}}</text>
              </view>
            </view>
          </view>
          <text wx:else class="collapsed-hint">点击“完整分析”查看研究依据与使用方法。</text>
        </view>
      </view>

      <view wx:if="{{activeModule == 'source' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">已披露资料</text>
        <view wx:if="{{view.facts.length}}" class="section-card">
          <view wx:for="{{view.facts}}" wx:key="*this" class="fact-row">
            <text>{{item[0]}}</text>
            <text>{{item[1]}}</text>
          </view>
        </view>
        <view wx:if="{{view.holdings.length}}" class="section-card">
          <text class="block-title">机构持仓对照</text>
          <view wx:for="{{view.holdings}}" wx:key="name" class="fact-row">
            <text>{{item.name}}</text>
            <text>{{item.value}}</text>
          </view>
        </view>
        <view wx:if="{{view.sourceLinks.length}}" class="section-card source-card">
          <text class="block-title">官方出处</text>
          <text class="source-help">以下地址均为公开可访问的官方页面或原始文件，点一条复制走自行核对。</text>
          <view
            wx:for="{{view.sourceLinks}}"
            wx:key="url"
            class="source-link-row"
            data-url="{{item.url}}"
            bindtap="copySourceLink"
            hover-class="tap-active"
            aria-role="button"
            aria-label="复制 {{item.name}} 的链接"
          >
            <text class="source-link-name">{{item.name}}</text>
            <text class="source-link-action">复制链接</text>
          </view>
        </view>
        <view wx:if="{{!view.facts.length && !view.holdings.length && !view.sourceLinks.length}}" class="module-empty">当前没有可公开展示的资料。</view>
      </view>

      <view wx:if="{{activeModule == 'risk' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">风险提醒</text>
        <view wx:if="{{view.riskItems && view.riskItems.length}}" class="risk-stack">
          <view wx:for="{{view.riskItems}}" wx:key="title" class="risk-card">
            <text class="risk-label">{{item.title}}</text>
            <text class="risk-body">{{item.body}}</text>
          </view>
        </view>
        <view wx:elif="{{view.risk}}" class="risk-card">
          <text class="risk-label">{{view.riskLabel}}</text>
          <text class="risk-body">{{view.risk}}</text>
        </view>
        <view wx:if="{{view.sourceNote}}" class="source-note">
          <text>来源 {{view.sourceNote}}</text>
        </view>
        <view wx:if="{{freshness.show}}" class="freshness-banner tone-{{freshness.tone}}">
          <view class="freshness-head">
            <text class="freshness-label">{{freshness.label}}</text>
            <view wx:if="{{freshness.showRetry}}" class="freshness-action" bindtap="retryFreshness" aria-role="button">重试</view>
          </view>
          <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
        </view>
        <view class="action-stack">
          <button class="member-cta" data-addon="snapshot" bindtap="openWorkspaceAction" aria-label="{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}">
            <view class="cta-copy">
              <text>{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}</text>
              <text class="cta-sub">{{snapshotSaved ? '对比当时与现在的变化' : '记录当前结论、数据与风险，之后看相对上次哪里变了'}}</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
          <button class="member-cta secondary-cta" data-addon="remind" bindtap="openWorkspaceAction" aria-label="提醒我相关事件">
            <view class="cta-copy">
              <text>提醒我相关事件</text>
              <text class="cta-sub">进入工作台设置复核节点</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
        </view>
      </view>

      <!-- 美股/A股/港股新股/机构持仓：决策概览＋标签，见说明四/五。黄金走
           上面未改动的六标签，不会命中这里任何一个 activeModule 取值。 -->
      <view wx:if="{{activeModule == 'overview' && (view.market == 'us' || view.market == 'a' || view.market == 'hk' || view.market == 'guru')}}" class="module-content">
        <text class="module-title">概览</text>
        <text class="module-answer">{{view.overview.reason || view.primaryJudgment || '结论待核验'}}</text>
        <text wx:if="{{view.strategy && view.strategy.basis}}" class="collapsed-hint">口径：{{view.strategy.basis}}</text>

        <template wx:if="{{view.overview.priceCard}}" is="chart-visual" data="{{item: view.overview.priceCard}}" />
        <view wx:elif="{{view.overview.priceNote}}" class="module-empty">{{view.overview.priceNote}}</view>

        <view class="section-card" wx:if="{{view.overview.evidenceBullets.length}}">
          <text class="block-title">关键依据</text>
          <view class="evidence-list">
            <view wx:for="{{view.overview.evidenceBullets}}" wx:key="*this" class="evidence-item">
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{view.overview.keyRisk}}" class="risk-card">
          <text class="risk-label">关键风险</text>
          <text class="risk-body">{{view.overview.keyRisk}}</text>
        </view>

        <view wx:if="{{view.overview.nextWatch}}" class="exit-plan">
          <view class="exit-plan-head">
            <text class="exit-plan-title">下一步关注</text>
          </view>
          <text class="exit-plan-basis">{{view.overview.nextWatch}}</text>
        </view>
      </view>

      <view wx:if="{{activeModule == 'trend' && (view.market == 'us' || view.market == 'a')}}" class="module-content">
        <text class="module-title">价格与位置</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够数据形成价格图表。</view>
      </view>

      <view wx:if="{{activeModule == 'dynamics' && view.market == 'us'}}" class="module-content">
        <text class="module-title">近期动态</text>
        <text class="module-answer">{{view.dynamics.heat}}</text>
        <view class="section-card" wx:if="{{view.dynamics.filings}}">
          <text class="block-title">同期公开备案</text>
          <text class="analysis-body">{{view.dynamics.filings}}</text>
        </view>
        <text wx:if="{{view.dynamics.mag7Label}}" class="collapsed-hint">{{view.dynamics.mag7Label}}</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:elif="{{!view.dynamics.filings}}" class="module-empty">近期没有足够的动态数据。</view>
      </view>

      <view wx:if="{{activeModule == 'dividend' && view.market == 'a'}}" class="module-content">
        <text class="module-title">分红与现金质量</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够的分红数据。</view>
      </view>

      <view wx:if="{{activeModule == 'subscribe' && view.market == 'hk'}}" class="module-content">
        <text class="module-title">申购参考</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够的申购数据。</view>
      </view>

      <view wx:if="{{activeModule == 'sell' && view.market == 'hk'}}" class="module-content">
        <text class="module-title">卖出观察</text>
        <view wx:if="{{view.exitPlan && view.exitPlan.show}}" class="exit-plan">
          <view class="exit-plan-head">
            <text class="exit-plan-title">{{view.exitPlan.title}}</text>
          </view>
          <view class="exit-plan-rows">
            <view wx:for="{{view.exitPlan.rows}}" wx:key="label" class="exit-plan-row">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
          </view>
          <text class="exit-plan-basis">{{view.exitPlan.basis}}</text>
        </view>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:if="{{!(view.exitPlan && view.exitPlan.show) && !activeCharts.length}}" class="module-empty">当前没有可展示的卖出参考。</view>
      </view>

      <view wx:if="{{activeModule == 'holdings' && view.market == 'guru'}}" class="module-content">
        <text class="module-title">持仓构成</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:if="{{view.holdings.length}}" class="section-card">
          <text class="block-title">机构持仓对照</text>
          <view wx:for="{{view.holdings}}" wx:key="name" class="fact-row">
            <text>{{item.name}}</text>
            <text>{{item.value}}</text>
          </view>
        </view>
        <view wx:if="{{!activeCharts.length && !view.holdings.length}}" class="module-empty">当前没有可展示的持仓明细。</view>
      </view>

      <!-- 依据：合并原「数据与质量」「研究图表」「已披露资料」「风险提醒」四个
           旧标签的内容，美股/A股/港股新股/机构持仓共用同一个 tab，不再分多页翻。 -->
      <view wx:if="{{activeModule == 'evidence' && (view.market == 'us' || view.market == 'a' || view.market == 'hk' || view.market == 'guru')}}" class="module-content">
        <text class="module-title">依据</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>

        <view wx:if="{{view.metrics.length}}" class="metric-panel">
          <text class="block-title">{{view.metricsTitle || '关键数据'}}</text>
          <view class="metric-grid">
            <view wx:for="{{view.metrics}}" wx:key="*this" class="metric">
              <text>{{item[0]}}</text>
              <text>{{item[1]}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{view.analysis.length}}" class="section-card analysis-card">
          <view class="analysis-head">
            <text class="block-title">{{view.analysisTitle || '研究要点'}}</text>
            <view class="details-toggle-inline" bindtap="toggleDetails" hover-class="tap-active">
              <text>{{detailsExpanded ? '收起分析' : '完整分析'}}</text>
            </view>
          </view>
          <view wx:if="{{detailsExpanded}}">
            <view wx:for="{{view.analysis}}" wx:key="title" class="analysis-block">
              <text class="analysis-index">{{item.indexLabel}}</text>
              <view class="analysis-copy">
                <text class="analysis-title">{{item.title}}</text>
                <text class="analysis-body">{{item.body}}</text>
              </view>
            </view>
          </view>
          <text wx:else class="collapsed-hint">点击“完整分析”查看研究依据与使用方法。</text>
        </view>

        <view wx:if="{{view.facts.length}}" class="section-card">
          <view wx:for="{{view.facts}}" wx:key="*this" class="fact-row">
            <text>{{item[0]}}</text>
            <text>{{item[1]}}</text>
          </view>
        </view>
        <view wx:if="{{view.holdings.length && view.market != 'guru'}}" class="section-card">
          <text class="block-title">机构持仓对照</text>
          <view wx:for="{{view.holdings}}" wx:key="name" class="fact-row">
            <text>{{item.name}}</text>
            <text>{{item.value}}</text>
          </view>
        </view>
        <view wx:if="{{view.sourceLinks.length}}" class="section-card source-card">
          <text class="block-title">官方出处</text>
          <text class="source-help">以下地址均为公开可访问的官方页面或原始文件，点一条复制走自行核对。</text>
          <view
            wx:for="{{view.sourceLinks}}"
            wx:key="url"
            class="source-link-row"
            data-url="{{item.url}}"
            bindtap="copySourceLink"
            hover-class="tap-active"
            aria-role="button"
            aria-label="复制 {{item.name}} 的链接"
          >
            <text class="source-link-name">{{item.name}}</text>
            <text class="source-link-action">复制链接</text>
          </view>
        </view>

        <view wx:if="{{view.riskItems && view.riskItems.length}}" class="risk-stack">
          <view wx:for="{{view.riskItems}}" wx:key="title" class="risk-card">
            <text class="risk-label">{{item.title}}</text>
            <text class="risk-body">{{item.body}}</text>
          </view>
        </view>
        <view wx:elif="{{view.risk}}" class="risk-card">
          <text class="risk-label">{{view.riskLabel}}</text>
          <text class="risk-body">{{view.risk}}</text>
        </view>
        <view wx:if="{{view.sourceNote}}" class="source-note">
          <text>来源 {{view.sourceNote}}</text>
        </view>

        <view wx:if="{{freshness.show}}" class="freshness-banner tone-{{freshness.tone}}">
          <view class="freshness-head">
            <text class="freshness-label">{{freshness.label}}</text>
            <view wx:if="{{freshness.showRetry}}" class="freshness-action" bindtap="retryFreshness" aria-role="button">重试</view>
          </view>
          <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
        </view>

        <view wx:if="{{!view.metrics.length && !view.analysis.length && !view.facts.length && !view.holdings.length && !view.sourceLinks.length && !activeCharts.length}}" class="module-empty">当前没有可展示的依据资料。</view>

        <view class="action-stack">
          <button class="member-cta" data-addon="snapshot" bindtap="openWorkspaceAction" aria-label="{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}">
            <view class="cta-copy">
              <text>{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}</text>
              <text class="cta-sub">{{snapshotSaved ? '对比当时与现在的变化' : '记录当前结论、数据与风险，之后看相对上次哪里变了'}}</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
          <button class="member-cta secondary-cta" data-addon="remind" bindtap="openWorkspaceAction" aria-label="提醒我相关事件">
            <view class="cta-copy">
              <text>提醒我相关事件</text>
              <text class="cta-sub">进入工作台设置复核节点</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
        </view>
      </view>
    </view>

    <text class="disclaimer">{{view.disclaimer}}</text>
  </view>

  <view wx:if="{{snapshotSheetOpen}}" class="snapshot-mask" catchtouchmove="true">
    <view class="snapshot-sheet">
      <view class="snapshot-head">
        <text class="snapshot-title">决策快照预览</text>
        <button class="snapshot-close" bindtap="closeSnapshotSheet">关闭</button>
      </view>
      <text class="snapshot-sub">系统将自动保存当时价格、结论、风险与数据截止时间。公开答案仍免费；正式保存用于个人跟踪与复盘。</text>
      <view class="snapshot-preview" wx:if="{{snapshotPreview}}">
        <text>{{snapshotPreview.priceLabel || '价格待核'}} · {{snapshotPreview.oneLiner || '结论待核'}}</text>
        <text wx:if="{{snapshotPreview.researchScore != null}}">{{snapshotPreview.researchScoreLabel}} {{snapshotPreview.researchScore}}</text>
        <text wx:if="{{snapshotPreview.metricLabel}}">{{snapshotPreview.metricLabel}}</text>
        <text wx:if="{{snapshotPreview.risk}}">风险：{{snapshotPreview.risk}}</text>
        <text>数据截止：{{snapshotPreview.asOf || snapshotPreview.snapshotUpdatedAt || '待核'}}</text>
      </view>
      <text class="snapshot-field-label">为什么关注</text>
      <view class="chip-row">
        <button wx:for="{{reasonOptions}}" wx:key="id" class="chip {{reasonIndex === index ? 'chip-active' : ''}}" data-index="{{index}}" bindtap="selectReasonChip">{{item.label}}</button>
      </view>
      <text class="snapshot-field-label">何时重新评估</text>
      <view class="chip-row">
        <button wx:for="{{reviewConditionOptions}}" wx:key="id" class="chip {{reviewConditionIndex === index ? 'chip-active' : ''}}" data-index="{{index}}" bindtap="selectReviewChip">{{item.label}}</button>
      </view>
      <text class="snapshot-field-label">下次查看</text>
      <view class="chip-row">
        <button class="chip {{reviewAtPreset === 7 ? 'chip-active' : ''}}" data-days="7" bindtap="selectReviewAtPreset">7天后</button>
        <button class="chip {{reviewAtPreset === 14 ? 'chip-active' : ''}}" data-days="14" bindtap="selectReviewAtPreset">14天后</button>
        <button class="chip {{reviewAtPreset === 30 ? 'chip-active' : ''}}" data-days="30" bindtap="selectReviewAtPreset">30天后</button>
      </view>
      <view class="snapshot-input"><text>日期</text><input value="{{snapshotReviewAt}}" maxlength="20" placeholder="YYYY-MM-DD" bindinput="inputSnapshotReviewAt" /></view>
      <view class="snapshot-note">
        <text>个人备注（选填）</text>
        <textarea maxlength="300" auto-height placeholder="可不填；系统快照仍会保存" value="{{snapshotNote}}" bindinput="inputSnapshotNote"></textarea>
      </view>
      <button class="primary-button snapshot-save" bindtap="confirmSnapshotSave" loading="{{snapshotSaving}}" disabled="{{snapshotSaving}}">确认保存决策快照</button>
      <text class="snapshot-legal">不构成荐股或收益承诺。未成功保存前不会写入你的记录。</text>
    </view>
  </view>

  <view wx:if="{{!ready && loading}}" class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">正在加载资料</text>
    <text class="empty-sub">请稍候</text>
  </view>

  <view wx:elif="{{!ready}}" class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">{{loadError || '资料暂不可用'}}</text>
    <text class="empty-sub">可下拉刷新，或返回列表重试</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
