<template name="chart-visual">
  <view class="visual-card">
    <view class="visual-head">
      <text class="visual-title">{{item.title}}</text>
      <view wx:if="{{item.isDividendHistory && item.ranges && item.ranges.length}}" class="visual-ranges">
        <text
          wx:for="{{item.ranges}}"
          wx:for-item="rg"
          wx:key="id"
          class="visual-range-pill {{item.activeRange === rg.id ? 'is-active' : ''}}"
          data-range="{{rg.id}}"
          bindtap="switchDividendRange"
          hover-class="tap-active"
          aria-role="button"
          aria-selected="{{item.activeRange === rg.id}}"
        >{{rg.label}}</text>
      </view>
    </view>
    <text wx:if="{{item.hint}}" class="visual-hint">{{item.hint}}</text>

    <view wx:if="{{item.stats && item.stats.length}}" class="chart-stats">
      <view wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label" class="chart-stat">
        <text>{{stat.label}}</text>
        <text>{{stat.value}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'columns'}}" class="column-chart">
      <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="column-slot">
        <view class="column-bar {{col.tone}}" style="height: {{col.height}}%;"></view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'solid'}}" class="solid-chart">
      <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="solid-slot">
        <text class="solid-value">{{col.valueText}}</text>
        <view class="solid-pillar-wrap">
          <view class="solid-bar {{col.tone}}" style="height: {{col.height}}%;"></view>
        </view>
        <text class="solid-label">{{col.label}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'bars'}}" class="bar-chart">
      <view wx:for="{{item.items}}" wx:for-item="bar" wx:key="id" class="bar-row">
        <view class="bar-copy"><text>{{bar.label}}</text><text>{{bar.valueText}}</text></view>
        <view class="bar-track">
          <view class="bar-value {{bar.tone}}" style="width: {{bar.width}}%;"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'line'}}" class="line-chart-wrap">
      <image wx:if="{{item.src}}" class="line-chart-img" src="{{item.src}}" mode="scaleToFill"></image>
      <view class="column-labels">
        <text>{{item.lowLabel}}</text>
        <text>{{item.latestLabel}}</text>
        <text>{{item.highLabel}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'meter'}}" class="meter-chart">
      <view class="meter-track">
        <view class="meter-fill" style="width: {{item.percent}}%;"></view>
        <view class="meter-dot" style="left: {{item.percent}}%;"></view>
      </view>
      <view class="meter-labels">
        <text>{{item.lowLabel}}</text>
        <text>{{item.midLabel}}</text>
        <text>{{item.highLabel}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'scatter'}}" class="scatter-chart-wrap">
      <canvas type="2d" id="{{item.canvasId}}" class="scatter-chart-canvas"></canvas>
    </view>

    <view wx:if="{{item.kind == 'tiles'}}" class="tile-chart">
      <view wx:for="{{item.items}}" wx:for-item="tile" wx:key="id" class="tile-cell">
        <text>{{tile.label}}</text>
        <text>{{tile.valueText}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'donut'}}" class="donut-chart-box">
      <view class="donut-ring-wrap">
        <image wx:if="{{item.src}}" class="donut-ring-img" src="{{item.src}}" mode="aspectFit" aria-hidden="true"></image>
        <view class="donut-ring-center">
          <text class="donut-center-v">{{item.centerMain}}</text>
          <text wx:if="{{item.centerSub}}" class="donut-center-k">{{item.centerSub}}</text>
        </view>
      </view>
      <view class="donut-legend-list">
        <view wx:for="{{item.legend}}" wx:for-item="seg" wx:key="label" class="donut-legend-row">
          <view class="donut-legend-dot" style="background: {{seg.color}};"></view>
          <text class="donut-legend-name">{{seg.label}}</text>
          <text class="donut-legend-pct">{{seg.pctText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'gauge'}}" class="gauge-chart-box">
      <image wx:if="{{item.src}}" class="gauge-img" src="{{item.src}}" mode="aspectFit" aria-hidden="true"></image>
      <text wx:if="{{item.badgeMain}}" class="gauge-main-pill">{{item.badgeMain}}</text>
      <view class="meter-labels gauge-labels">
        <text>{{item.lowLabel}}</text>
        <text>{{item.midLabel}}</text>
        <text>{{item.highLabel}}</text>
      </view>
    </view>

    <view wx:if="{{item.kind == 'dualbars'}}" class="dual-chart-box">
      <view class="dual-legend-row">
        <view class="dual-legend-item"><view class="dual-dot is-a"></view><text>{{item.legendA}}</text></view>
        <view class="dual-legend-item"><view class="dual-dot is-b"></view><text>{{item.legendB}}</text></view>
      </view>
      <image wx:if="{{item.src}}" class="dual-bars-img" src="{{item.src}}" mode="scaleToFill" aria-hidden="true"></image>
      <view class="dual-x-grid">
        <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="dual-x-col">
          <text class="dual-x-lbl">{{col.label}}</text>
          <text class="dual-x-a">{{col.aText}}</text>
          <text class="dual-x-b is-{{col.bTone}}">{{col.bText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.kind == 'compare'}}" class="cmp-chart-box">
      <view class="dual-legend-row">
        <view class="dual-legend-item"><view class="dual-dot is-a"></view><text>{{item.selfLegend}}</text></view>
        <view class="dual-legend-item"><view class="dual-dot is-peer"></view><text>{{item.peerLegend}}</text></view>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="row" wx:key="id" class="cmp-row">
        <view class="cmp-row-head">
          <text class="cmp-row-label">{{row.label}}</text>
          <text class="cmp-row-vals"><text class="cmp-self-v tone-{{row.tone}}">{{row.selfText}}</text> · {{row.peerText}}</text>
        </view>
        <view class="cmp-dual-tracks">
          <view class="cmp-track"><view class="cmp-fill is-self tone-{{row.tone}}" style="width: {{row.selfWidth}}%;"></view></view>
          <view class="cmp-track"><view class="cmp-fill is-peer" style="width: {{row.peerWidth}}%;"></view></view>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="page-shell detail-shell">
  <view wx:if="{{ready}}" class="detail-content">
    <!-- 对标 Robinhood × 富途 × 息记：大字名称代码 + 短标签胶囊 + 大号价格 + 可视化高低区间条 -->
    <view class="detail-hero-card page-card">
      <view class="hero-top">
        <view class="hero-tag-row">
          <text class="hero-label">{{view.marketLabel}}</text>
          <text wx:if="{{view.primaryJudgment}}" class="hero-judgment">结论 · {{view.heroVerdict || view.primaryJudgment}}</text>
        </view>
        <text class="hero-star-btn {{starred ? 'is-starred' : ''}}" bindtap="toggleStar" aria-role="button" aria-label="{{starred ? '取消收藏' : '加入收藏'}}">{{starred ? '★ 已收藏' : '☆ 收藏'}}</text>
      </view>
      <view class="hero-name-row">
        <text class="hero-title">{{view.title}}</text>
        <text wx:if="{{view.displayCode || (view.code && !view.hideCode)}}" class="hero-code-pill">{{view.displayCode || view.code}}</text>
      </view>
      <view wx:if="{{view.heroTags && view.heroTags.length}}" class="hero-pills-row">
        <text wx:for="{{view.heroTags}}" wx:key="*this" class="hero-meta-pill">{{item}}</text>
      </view>
      <view wx:if="{{view.heroFigure}}" class="hero-price-row">
        <text class="hero-big-figure">{{view.heroFigure}}</text>
        <text wx:if="{{view.heroDelta}}" class="hero-delta-pill tone-{{view.heroTone}}">{{view.heroDelta}}</text>
      </view>
      <text class="hero-asof">{{dataAsOf || '读取历史资料'}}</text>

      <!-- Robinhood 同款首屏价格走势曲线（叠加高低参考虚线） -->
      <image wx:if="{{view.heroSpark}}" class="hero-spark-img" src="{{view.heroSpark}}" mode="scaleToFill" aria-hidden="true"></image>
      <view wx:if="{{view.heroSparkLegend && view.heroSparkLegend.length}}" class="hero-spark-legend" aria-hidden="true">
        <view wx:for="{{view.heroSparkLegend}}" wx:key="text" class="hero-spark-key">
          <view class="hero-spark-dash is-{{item.tone}}"></view>
          <text>{{item.text}}</text>
        </view>
      </view>

      <!-- 可视化高低区间尺（美股/A股/黄金）或 4 步进度条（港股新股） -->
      <view wx:if="{{view.heroRange}}" class="hero-range-box" aria-hidden="true">
        <view class="meter-track">
          <view class="meter-fill" style="width: {{view.heroRange.percent}}%;"></view>
          <view class="meter-dot" style="left: {{view.heroRange.percent}}%;"></view>
        </view>
        <view class="meter-labels">
          <text>{{view.heroRange.lowLabel}}</text>
          <text>{{view.heroRange.midLabel}}</text>
          <text>{{view.heroRange.highLabel}}</text>
        </view>
      </view>

      <view wx:if="{{view.heroStages && view.heroStages.length}}" class="hero-stage-track" aria-hidden="true">
        <view wx:for="{{view.heroStages}}" wx:key="label" class="hero-stage-step is-{{item.state}}">
          <view class="hero-stage-dot"></view>
          <text class="hero-stage-label">{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{!view.heroFigure && view.highlights.length}}" class="highlight-panel">
        <view wx:for="{{view.highlights}}" wx:key="label" class="highlight-cell">
          <text class="highlight-label">{{item.label}}</text>
          <text class="highlight-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{freshness.show}}" class="freshness-banner tone-{{freshness.tone}}">
      <view class="freshness-head">
        <text class="freshness-label">{{freshness.label}}</text>
        <view wx:if="{{freshness.showRetry}}" class="freshness-action" bindtap="retryFreshness" aria-role="button" aria-label="重新读取历史资料">重试</view>
      </view>
      <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
    </view>

    <scroll-view class="detail-tabs" scroll-x="true" enable-flex="true" show-scrollbar="false" enhanced="true">
      <view class="detail-tabs-inner">
        <view
          wx:for="{{view.modules}}"
          wx:key="id"
          class="detail-tab {{activeModule == item.id ? 'on' : ''}}"
          data-module="{{item.id}}"
          bindtap="switchModule"
          hover-class="detail-tab-tap"
          aria-role="tab"
          aria-selected="{{activeModule == item.id}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="module-panel">
      <view wx:if="{{activeModule == 'summary' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">先看答案</text>
        <text class="module-answer">{{view.answer || '结论待核验'}}</text>
        <view wx:if="{{view.strategy}}" class="strategy-card tone-{{view.strategy.tone}}">
          <view class="strategy-card-head">
            <text class="strategy-card-title">样本判断</text>
            <view class="strategy-card-head-right">
              <text class="strategy-card-label">{{view.strategy.label}}</text>
              <view class="details-toggle-inline" bindtap="toggleStrategy" hover-class="tap-active">
                <text>{{strategyExpanded ? '收起' : '展开'}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{strategyExpanded}}">
            <text class="strategy-card-action">{{view.strategy.action}}</text>
            <text class="strategy-card-trigger">触发：{{view.strategy.trigger}}</text>
            <text class="strategy-card-basis">口径：{{view.strategy.basis}}</text>
          </view>
        </view>
        <template wx:if="{{view.visual}}" is="chart-visual" data="{{item: view.visual}}" />
        <view wx:if="{{!view.answer}}" class="module-empty">当前没有可展示的结论。</view>
      </view>

      <view wx:if="{{(activeModule == 'price' || activeModule == 'finance' || activeModule == 'research') && view.market == 'gold'}}" class="module-content">
        <text class="module-title">{{activeModule == 'price' ? '价格与位置' : (activeModule == 'finance' ? '数据与质量' : '研究图表')}}</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前模块暂无足够数据。</view>

        <view wx:if="{{activeModule == 'finance' && view.metrics.length}}" class="metric-panel">
          <text class="block-title">{{view.metricsTitle || '关键数据'}}</text>
          <view class="metric-grid">
            <view wx:for="{{view.metrics}}" wx:key="*this" class="metric">
              <text>{{item[0]}}</text>
              <text>{{item[1]}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{activeModule == 'research' && view.analysis.length}}" class="section-card analysis-card">
          <view class="analysis-head">
            <text class="block-title">{{view.analysisTitle || '研究要点'}}</text>
            <view class="details-toggle-inline" bindtap="toggleDetails" hover-class="tap-active">
              <text>{{detailsExpanded ? '收起分析' : '完整分析'}}</text>
            </view>
          </view>
          <view wx:if="{{detailsExpanded}}">
            <view wx:for="{{view.analysis}}" wx:key="title" class="analysis-block">
              <text class="analysis-index">{{item.indexLabel}}</text>
              <view class="analysis-copy">
                <text class="analysis-title">{{item.title}}</text>
                <text class="analysis-body">{{item.body}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{activeModule == 'source' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">已披露资料</text>
        <view wx:if="{{view.facts.length}}" class="section-card">
          <view wx:for="{{view.facts}}" wx:key="*this" class="fact-row">
            <text>{{item[0]}}</text>
            <text>{{item[1]}}</text>
          </view>
        </view>
        <view wx:if="{{view.holdings.length}}" class="section-card">
          <text class="block-title">机构持仓对照</text>
          <view
            wx:for="{{view.holdings}}"
            wx:key="name"
            class="fact-row"
            data-market="{{item.linkMarket}}"
            data-id="{{item.linkId}}"
            bindtap="openHoldingStock"
            hover-class="{{item.linkId ? 'tap-active' : ''}}"
            aria-role="{{item.linkId ? 'button' : ''}}"
          >
            <text>{{item.name}}</text>
            <text>{{item.value}}{{item.linkId ? ' ›' : ''}}</text>
          </view>
        </view>
        <view wx:if="{{view.sourceLinks.length}}" class="section-card source-card">
          <text class="block-title">官方出处</text>
          <view
            wx:for="{{view.sourceLinks}}"
            wx:key="url"
            class="source-link-row"
            data-url="{{item.url}}"
            bindtap="copySourceLink"
            hover-class="tap-active"
            aria-role="button"
            aria-label="复制 {{item.name}} 的链接"
          >
            <text class="source-link-name">{{item.name}}</text>
            <text class="source-link-action">复制链接</text>
          </view>
        </view>
        <view wx:if="{{!view.facts.length && !view.holdings.length && !view.sourceLinks.length}}" class="module-empty">当前没有可公开展示的资料。</view>
      </view>

      <view wx:if="{{activeModule == 'risk' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">风险提醒</text>
        <view wx:if="{{view.riskItems && view.riskItems.length}}" class="risk-stack">
          <view wx:for="{{view.riskItems}}" wx:key="title" class="risk-card">
            <text class="risk-label">{{item.title}}</text>
            <text class="risk-body">{{item.body}}</text>
          </view>
        </view>
        <view wx:elif="{{view.risk}}" class="risk-card">
          <text class="risk-label">{{view.riskLabel}}</text>
          <text class="risk-body">{{view.risk}}</text>
        </view>
        <view wx:if="{{view.sourceNote}}" class="source-note">
          <text>来源 {{view.sourceNote}}</text>
        </view>
        <view wx:if="{{memberToolsEnabled}}" class="action-stack">
          <button class="member-cta" data-addon="snapshot" bindtap="openWorkspaceAction" aria-label="{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}">
            <view class="cta-copy">
              <text>{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}</text>
              <text class="cta-sub">{{snapshotSaved ? '对比当时与现在' : '留存结论，之后对比变化'}}</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
          <button class="member-cta secondary-cta" data-addon="remind" bindtap="openWorkspaceAction" aria-label="提醒我相关事件">
            <view class="cta-copy">
              <text>提醒我相关事件</text>
              <text class="cta-sub">关键日期到期提醒</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
        </view>
      </view>

      <!-- 对标 Robinhood × 富途 × 息记：参考区间明白卡 + 多周期涨跌色块 + 强弱进度条 + 双列核心数据 -->
      <view wx:if="{{activeModule == 'overview' && (view.market == 'us' || view.market == 'a' || view.market == 'hk' || view.market == 'guru' || view.market == 'gold')}}" class="module-content">
        <view wx:if="{{view.overview.orderPlan}}" class="section-card ref-plan-card">
          <view class="ref-plan-head">
            <text class="block-title">{{view.overview.orderPlan.title}}</text>
            <text class="verdict-stamp tone-{{view.overview.orderPlan.verdictTone}}">{{view.overview.orderPlan.verdictBadge}}</text>
          </view>
          <view wx:if="{{view.overview.orderPlan.rows && view.overview.orderPlan.rows.length}}" class="ref-plan-rows">
            <view wx:for="{{view.overview.orderPlan.rows}}" wx:key="key" class="ref-plan-row">
              <text class="ref-plan-k">{{item.label}}</text>
              <view class="ref-plan-right">
                <text class="ref-plan-v">{{item.value}}</text>
                <text wx:if="{{item.note}}" class="ref-plan-note">{{item.note}}</text>
              </view>
            </view>
          </view>
        </view>

        <template wx:if="{{!view.heroSpark && view.overview.priceCard}}" is="chart-visual" data="{{item: view.overview.priceCard}}" />

        <view wx:if="{{view.overview.periodReturns && view.overview.periodReturns.length}}" class="period-strip">
          <view wx:for="{{view.overview.periodReturns}}" wx:key="label" class="period-cell tone-{{item.tone}}">
            <text class="period-label">{{item.label}}</text>
            <text class="period-val">{{item.valueText}}</text>
          </view>
        </view>

        <!-- A股收息首屏分红与复投试算器：点股数+年限看年度分红、生活映射与成本摊薄（对标息记） -->
        <view wx:if="{{view.market == 'a' && dividendCalcView}}" class="section-card div-calc-card">
          <view class="div-calc-head">
            <text class="block-title">持股分红与复投试算</text>
            <text class="div-calc-year">{{dividendCalcView.year}}年度已实施</text>
          </view>
          <view class="div-calc-pills">
            <text class="div-calc-pill {{dividendShares === 100 ? 'is-active' : ''}}" data-shares="100" bindtap="selectDividendShares" aria-role="button">100股</text>
            <text class="div-calc-pill {{dividendShares === 1000 ? 'is-active' : ''}}" data-shares="1000" bindtap="selectDividendShares" aria-role="button">1000股</text>
            <text class="div-calc-pill {{dividendShares === 5000 ? 'is-active' : ''}}" data-shares="5000" bindtap="selectDividendShares" aria-role="button">5000股</text>
            <text class="div-calc-pill {{dividendShares === 10000 ? 'is-active' : ''}}" data-shares="10000" bindtap="selectDividendShares" aria-role="button">1万股</text>
          </view>
          <view wx:if="{{dividendCalcView.costModes && dividendCalcView.costModes.length}}" class="cost-mode-strip">
            <view class="cost-mode-pills">
              <text
                wx:for="{{dividendCalcView.costModes}}"
                wx:key="id"
                class="cost-mode-pill {{dividendCalcView.costMode === item.id ? 'is-active' : ''}}"
                data-mode="{{item.id}}"
                bindtap="selectDividendCostMode"
                aria-role="button"
              >{{item.label}}</text>
            </view>
            <text class="div-yield-badge">成本息率 {{dividendCalcView.entryYieldText}}</text>
          </view>
          <view class="div-calc-result">
            <view class="div-calc-metric">
              <text class="div-calc-k">年度税前分红</text>
              <text class="div-calc-v">{{dividendCalcView.cashText}}</text>
              <text class="div-life-tag">息覆生活 · {{dividendCalcView.lifeTag}}</text>
            </view>
            <view class="div-calc-metric">
              <text class="div-calc-k">{{dividendCalcView.costLabel}}</text>
              <text class="div-calc-v is-sub">{{dividendCalcView.costText}}</text>
              <text class="div-sub-tag">{{dividendCalcView.costDiffText}} · {{dividendYears || 1}}年摊薄至 {{dividendCalcView.dilutedCostText}}/股</text>
            </view>
          </view>
          <view class="drip-box">
            <view class="drip-head">
              <text class="drip-title">分红再买股（复利推演）</text>
              <view class="drip-pills">
                <text class="drip-pill {{dividendYears === 3 ? 'is-active' : ''}}" data-years="3" bindtap="selectDividendYears" aria-role="button">3年</text>
                <text class="drip-pill {{dividendYears === 5 ? 'is-active' : ''}}" data-years="5" bindtap="selectDividendYears" aria-role="button">5年</text>
                <text class="drip-pill {{dividendYears === 10 ? 'is-active' : ''}}" data-years="10" bindtap="selectDividendYears" aria-role="button">10年</text>
              </view>
            </view>
            <view class="drip-visual-row">
              <image wx:if="{{dividendCalcView.dripDonutSrc}}" class="drip-donut-img" src="{{dividendCalcView.dripDonutSrc}}" mode="aspectFit" aria-hidden="true"></image>
              <view class="drip-stats">
                <view class="drip-stat">
                  <text class="drip-k">{{dividendYears}}年后攒股</text>
                  <text class="drip-v">{{dividendCalcView.dripSharesText}}</text>
                </view>
                <view class="drip-stat">
                  <text class="drip-k">届时年领</text>
                  <text class="drip-v is-green">{{dividendCalcView.dripCashText}}</text>
                </view>
                <view class="drip-stat">
                  <text class="drip-k">相对本金息率</text>
                  <text class="drip-v is-blue">{{dividendCalcView.yocText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 港股打新首屏本金与回本试算器（对标富途牛牛打新计算器） -->
        <view wx:if="{{view.market == 'hk' && hkIpoCalcView}}" class="section-card div-calc-card hk-calc-card">
          <view class="div-calc-head">
            <text class="block-title">打新本金与回本算账</text>
            <text class="div-calc-year">{{hkIpoCalcView.lotsText}}</text>
          </view>
          <view class="div-calc-pills hk-calc-pills">
            <text class="div-calc-pill {{hkCalcMode === 'cash1' ? 'is-active' : ''}}" data-mode="cash1" bindtap="selectHkCalcMode" aria-role="button">现金1手(0息)</text>
            <text class="div-calc-pill {{hkCalcMode === 'cash5' ? 'is-active' : ''}}" data-mode="cash5" bindtap="selectHkCalcMode" aria-role="button">现金5手</text>
            <text class="div-calc-pill {{hkCalcMode === 'margin10' ? 'is-active' : ''}}" data-mode="margin10" bindtap="selectHkCalcMode" aria-role="button">10倍融资10手</text>
          </view>
          <view class="div-calc-result">
            <view class="div-calc-metric">
              <text class="div-calc-k">需准备本金</text>
              <text class="div-calc-v is-sub">{{hkIpoCalcView.principalText}}</text>
              <text class="div-sub-tag">{{hkIpoCalcView.costNote}}</text>
            </view>
            <view class="div-calc-metric">
              <text class="div-calc-k">中1手回本涨幅</text>
              <text class="div-calc-v is-blue">{{hkIpoCalcView.breakevenText}}</text>
              <text class="div-sub-tag">涨10% {{hkIpoCalcView.up10Text}} · 跌10% {{hkIpoCalcView.down10Text}}</text>
            </view>
          </view>
        </view>

        <!-- 首屏核心图表直出（A股股息表盘与历年分红图 / 美股双柱财报与同业对比图 / 港股首日扇形图 / 大佬重仓环形饼图） -->
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>

        <view wx:if="{{view.keyStats && view.keyStats.length}}" class="apple-stats-grid">
          <view wx:for="{{view.keyStats}}" wx:key="*this" class="apple-stat-cell">
            <text class="apple-stat-k">{{item[0]}}</text>
            <text class="apple-stat-v">{{item[1]}}</text>
          </view>
        </view>

        <view wx:if="{{view.overview.healthChecks && view.overview.healthChecks.length}}" class="health-bars-box">
          <view wx:for="{{view.overview.healthChecks}}" wx:key="label" class="health-bar-row">
            <view class="health-bar-head">
              <text class="health-bar-k">{{item.label}}</text>
              <text class="health-bar-v tone-{{item.tone}}">{{item.valueText}}</text>
            </view>
            <view class="health-bar-track">
              <view class="health-bar-fill tone-{{item.tone}}" style="width: {{item.percent}}%;"></view>
            </view>
          </view>
        </view>

        <!-- 对标富途牛牛：明星大师持仓联动背书卡（美股七姐妹等机构重仓股首屏直出） -->
        <view wx:if="{{view.market == 'us' && view.holdings && view.holdings.length}}" class="section-card guru-endorse-card">
          <view class="div-calc-head">
            <text class="block-title">聪明钱大师持仓追踪</text>
            <text class="div-calc-year">{{view.holdings.length}}家机构披露持有</text>
          </view>
          <view
            wx:for="{{view.holdings}}"
            wx:key="name"
            class="guru-endorse-row"
            data-id="{{item.investorId}}"
            bindtap="openGuruInvestor"
            hover-class="{{item.investorId ? 'tap-active' : ''}}"
            aria-role="{{item.investorId ? 'button' : ''}}"
          >
            <text class="guru-endorse-name">{{item.name}}</text>
            <text class="guru-endorse-val">{{item.value}}{{item.investorId ? ' ›' : ''}}</text>
          </view>
        </view>

        <!-- 对标 IBKR × 东方财富：同池可比龙头一键横向切换 -->
        <view wx:if="{{peerCompare && peerCompare.length}}" class="section-card peer-cmp-card">
          <view class="div-calc-head">
            <text class="block-title">{{view.market == 'us' ? '同池巨头横向对照' : '同板块收息股对照'}}</text>
            <text class="div-calc-year">点击秒切</text>
          </view>
          <view class="peer-cmp-grid">
            <view
              wx:for="{{peerCompare}}"
              wx:key="id"
              class="peer-cmp-cell"
              data-id="{{item.id}}"
              bindtap="switchPeer"
              hover-class="tap-active"
              aria-role="button"
            >
              <text class="peer-cmp-name">{{item.name}}</text>
              <text class="peer-cmp-m1">{{item.metric1}}</text>
              <text wx:if="{{item.metric2}}" class="peer-cmp-m2">{{item.metric2}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{view.overview.keyRisk}}" class="risk-card">
          <text class="risk-label">风险留意</text>
          <text class="risk-body">{{view.overview.keyRisk}}</text>
        </view>
      </view>

      <view wx:if="{{activeModule == 'trend' && (view.market == 'us' || view.market == 'a' || view.market == 'gold')}}" class="module-content">
        <text class="module-title">价格与位置</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够数据形成价格图表。</view>
      </view>

      <view wx:if="{{activeModule == 'dynamics' && view.market == 'us'}}" class="module-content">
        <text class="module-title">近期动态</text>
        <view wx:if="{{view.dynamics.eventVerified || !(view.dynamics.filingCards && view.dynamics.filingCards.length)}}" class="section-card">
          <text class="block-title">近期公司事件</text>
          <text class="analysis-body">{{view.dynamics.event}}</text>
          <text wx:if="{{view.dynamics.eventVerified}}" class="collapsed-hint">官方原文见来源；同期发生不代表涨跌原因。</text>
        </view>
        <text wx:if="{{view.dynamics.heat}}" class="module-answer">{{view.dynamics.heat}}</text>
        <view class="section-card" wx:if="{{view.dynamics.filingCards && view.dynamics.filingCards.length}}">
          <text class="block-title">同期公开公告原文</text>
          <view
            wx:for="{{view.dynamics.filingCards}}"
            wx:key="key"
            class="filing-card-row"
            data-url="{{item.sourceUrl}}"
            bindtap="copySourceLink"
            hover-class="{{item.sourceUrl ? 'tap-active' : ''}}"
            aria-role="button"
          >
            <view class="filing-card-top">
              <text class="filing-form-pill">{{item.form}}</text>
              <text class="filing-date">{{item.date}}</text>
              <text wx:if="{{item.sourceUrl}}" class="source-link-action">复制原文</text>
            </view>
            <text class="filing-summary">{{item.summary}}</text>
          </view>
          <text class="collapsed-hint">公告与股价同期发生，不代表涨跌原因。</text>
        </view>
        <view class="section-card" wx:elif="{{view.dynamics.filings}}">
          <text class="block-title">同期公开备案</text>
          <text class="analysis-body">{{view.dynamics.filings}}</text>
        </view>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:elif="{{!view.dynamics.filings}}" class="module-empty">近期没有足够的动态数据。</view>
      </view>

      <view wx:if="{{activeModule == 'dynamics' && view.market == 'gold'}}" class="module-content">
        <text class="module-title">驱动与近期变化</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够的驱动数据。</view>
      </view>

      <view wx:if="{{activeModule == 'dividend' && view.market == 'a'}}" class="module-content">
        <text class="module-title">分红与现金质量</text>
        <!-- 借鉴 Stock Events：按持股股数纯算历史已实施税前分红，不预测未来。 -->
        <view wx:if="{{dividendCalcView}}" class="section-card div-calc-card">
          <view class="div-calc-head">
            <text class="block-title">按股数历史分红对照</text>
            <text class="div-calc-year">{{dividendCalcView.year}}年度已实施</text>
          </view>
          <view class="div-calc-pills">
            <text class="div-calc-pill {{dividendShares === 100 ? 'is-active' : ''}}" data-shares="100" bindtap="selectDividendShares" aria-role="button">100股</text>
            <text class="div-calc-pill {{dividendShares === 1000 ? 'is-active' : ''}}" data-shares="1000" bindtap="selectDividendShares" aria-role="button">1000股</text>
            <text class="div-calc-pill {{dividendShares === 5000 ? 'is-active' : ''}}" data-shares="5000" bindtap="selectDividendShares" aria-role="button">5000股</text>
            <text class="div-calc-pill {{dividendShares === 10000 ? 'is-active' : ''}}" data-shares="10000" bindtap="selectDividendShares" aria-role="button">1万股</text>
          </view>
          <view class="div-calc-result">
            <view class="div-calc-metric">
              <text class="div-calc-k">历史税前分红</text>
              <text class="div-calc-v">{{dividendCalcView.cashText}}</text>
            </view>
            <view class="div-calc-metric">
              <text class="div-calc-k">{{dividendCalcView.priceAsOf}} 对应市值</text>
              <text class="div-calc-v is-sub">{{dividendCalcView.costText}}</text>
            </view>
          </view>
          <text class="div-calc-note">按每股税前分红 {{dividendCalcView.dpsText}} 算术对照，纯历史口径，不预测未来分红。</text>
        </view>
        <view wx:if="{{view.recentDistributions && view.recentDistributions.length}}" class="section-card dist-log-card">
          <view class="div-calc-head">
            <text class="block-title">近期历次除息派现记录</text>
            <text class="div-calc-year">官方分红方案</text>
          </view>
          <view wx:for="{{view.recentDistributions}}" wx:key="key" class="dist-log-row">
            <view class="dist-log-left">
              <text class="dist-log-date">{{item.exDate}} 除息</text>
              <text wx:if="{{item.basisShort}}" class="mini-tag">{{item.basisShort}}</text>
            </view>
            <text class="dist-log-plan">{{item.planText}}</text>
          </view>
        </view>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够的分红数据。</view>
      </view>

      <view wx:if="{{activeModule == 'subscribe' && view.market == 'hk'}}" class="module-content">
        <text class="module-title">申购参考</text>
        <view wx:if="{{hkIpoCalcView}}" class="section-card div-calc-card hk-calc-card">
          <view class="div-calc-head">
            <text class="block-title">打新本金与回本算账</text>
            <text class="div-calc-year">{{hkIpoCalcView.lotsText}}</text>
          </view>
          <view class="div-calc-pills hk-calc-pills">
            <text class="div-calc-pill {{hkCalcMode === 'cash1' ? 'is-active' : ''}}" data-mode="cash1" bindtap="selectHkCalcMode" aria-role="button">现金1手(0息)</text>
            <text class="div-calc-pill {{hkCalcMode === 'cash5' ? 'is-active' : ''}}" data-mode="cash5" bindtap="selectHkCalcMode" aria-role="button">现金5手</text>
            <text class="div-calc-pill {{hkCalcMode === 'margin10' ? 'is-active' : ''}}" data-mode="margin10" bindtap="selectHkCalcMode" aria-role="button">10倍融资10手</text>
          </view>
          <view class="div-calc-result">
            <view class="div-calc-metric">
              <text class="div-calc-k">需准备本金</text>
              <text class="div-calc-v is-sub">{{hkIpoCalcView.principalText}}</text>
              <text class="div-sub-tag">{{hkIpoCalcView.costNote}}</text>
            </view>
            <view class="div-calc-metric">
              <text class="div-calc-k">中1手回本涨幅</text>
              <text class="div-calc-v is-blue">{{hkIpoCalcView.breakevenText}}</text>
              <text class="div-sub-tag">涨10% {{hkIpoCalcView.up10Text}} · 跌10% {{hkIpoCalcView.down10Text}}</text>
            </view>
          </view>
          <text class="div-calc-note">按公开招股入场费与常见券商费率算术试算，不预测上市涨跌。</text>
        </view>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:else class="module-empty">当前没有足够的申购数据。</view>
      </view>

      <view wx:if="{{activeModule == 'sell' && view.market == 'hk'}}" class="module-content">
        <text class="module-title">历史结果对照</text>
        <view wx:if="{{view.exitPlan && view.exitPlan.show}}" class="exit-plan">
          <view class="exit-plan-head">
            <text class="exit-plan-title">{{view.exitPlan.title}}</text>
          </view>
          <view class="exit-plan-rows">
            <view wx:for="{{view.exitPlan.rows}}" wx:key="label" class="exit-plan-row">
              <text>{{item.label}}</text>
              <text>{{item.value}}</text>
            </view>
          </view>
          <text class="exit-plan-basis">{{view.exitPlan.basis}}</text>
        </view>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:if="{{!(view.exitPlan && view.exitPlan.show) && !activeCharts.length}}" class="module-empty">暂无足够历史结果可作对照。</view>
      </view>

      <view wx:if="{{activeModule == 'holdings' && view.market == 'guru'}}" class="module-content">
        <text class="module-title">持仓构成</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>
        <view wx:if="{{view.holdings.length}}" class="section-card">
          <text class="block-title">机构持仓对照</text>
          <view
            wx:for="{{view.holdings}}"
            wx:key="name"
            class="fact-row"
            data-market="{{item.linkMarket}}"
            data-id="{{item.linkId}}"
            bindtap="openHoldingStock"
            hover-class="{{item.linkId ? 'tap-active' : ''}}"
            aria-role="{{item.linkId ? 'button' : ''}}"
          >
            <text>{{item.name}}</text>
            <text>{{item.value}}{{item.linkId ? ' ›' : ''}}</text>
          </view>
        </view>
        <view wx:if="{{!activeCharts.length && !view.holdings.length}}" class="module-empty">当前没有可展示的持仓明细。</view>
      </view>

      <!-- 依据：合并原「数据与质量」「研究图表」「已披露资料」「风险提醒」四个
           旧标签的内容，美股/A股/港股新股/机构持仓/黄金共用同一个 tab，不再分多页翻。 -->
      <view wx:if="{{activeModule == 'evidence' && (view.market == 'us' || view.market == 'a' || view.market == 'hk' || view.market == 'guru' || view.market == 'gold')}}" class="module-content">
        <text class="module-title">依据</text>
        <block wx:if="{{activeCharts.length}}">
          <template wx:for="{{activeCharts}}" wx:key="title" is="chart-visual" data="{{item: item}}" />
        </block>

        <view wx:if="{{view.metrics.length}}" class="metric-panel">
          <text class="block-title">{{view.metricsTitle || '关键数据'}}</text>
          <view class="metric-grid">
            <view wx:for="{{view.metrics}}" wx:key="*this" class="metric">
              <text>{{item[0]}}</text>
              <text>{{item[1]}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{view.analysis.length}}" class="section-card analysis-card">
          <view class="analysis-head">
            <text class="block-title">{{view.analysisTitle || '研究要点'}}</text>
            <view class="details-toggle-inline" bindtap="toggleDetails" hover-class="tap-active">
              <text>{{detailsExpanded ? '收起分析' : '完整分析'}}</text>
            </view>
          </view>
          <view wx:if="{{detailsExpanded}}">
            <view wx:for="{{view.analysis}}" wx:key="title" class="analysis-block">
              <text class="analysis-index">{{item.indexLabel}}</text>
              <view class="analysis-copy">
                <text class="analysis-title">{{item.title}}</text>
                <text class="analysis-body">{{item.body}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{view.facts.length || (view.holdings.length && view.market != 'guru') || view.sourceLinks.length}}" class="section-card">
          <view class="analysis-head">
            <text class="block-title">更多依据资料</text>
            <view class="details-toggle-inline" bindtap="toggleMoreEvidence" hover-class="tap-active">
              <text>{{moreEvidenceExpanded ? '收起' : '展开'}}</text>
            </view>
          </view>
          <block wx:if="{{moreEvidenceExpanded}}">
            <view wx:if="{{view.facts.length}}" class="fact-block">
              <view wx:for="{{view.facts}}" wx:key="*this" class="fact-row">
                <text>{{item[0]}}</text>
                <text>{{item[1]}}</text>
              </view>
            </view>
            <view wx:if="{{view.holdings.length && view.market != 'guru'}}" class="fact-block">
              <text class="block-title">机构持仓对照</text>
              <view wx:for="{{view.holdings}}" wx:key="name" class="fact-row">
                <text>{{item.name}}</text>
                <text>{{item.value}}</text>
              </view>
            </view>
            <view wx:if="{{view.sourceLinks.length}}" class="fact-block source-card">
              <text class="block-title">官方出处</text>
              <view
                wx:for="{{view.sourceLinks}}"
                wx:key="url"
                class="source-link-row"
                data-url="{{item.url}}"
                bindtap="copySourceLink"
                hover-class="tap-active"
                aria-role="button"
                aria-label="复制 {{item.name}} 的链接"
              >
                <text class="source-link-name">{{item.name}}</text>
                <text class="source-link-action">复制链接</text>
              </view>
            </view>
          </block>
        </view>

        <view wx:if="{{view.riskItems && view.riskItems.length}}" class="risk-stack">
          <view wx:for="{{view.riskItems}}" wx:key="title" class="risk-card">
            <text class="risk-label">{{item.title}}</text>
            <text class="risk-body">{{item.body}}</text>
          </view>
        </view>
        <view wx:elif="{{view.risk}}" class="risk-card">
          <text class="risk-label">{{view.riskLabel}}</text>
          <text class="risk-body">{{view.risk}}</text>
        </view>
        <view wx:if="{{view.sourceNote}}" class="source-note">
          <text>来源 {{view.sourceNote}}</text>
        </view>


        <view wx:if="{{!view.metrics.length && !view.analysis.length && !view.facts.length && !view.holdings.length && !view.sourceLinks.length && !activeCharts.length}}" class="module-empty">当前没有可展示的依据资料。</view>

        <view wx:if="{{memberToolsEnabled}}" class="action-stack">
          <button class="member-cta" data-addon="snapshot" bindtap="openWorkspaceAction" aria-label="{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}">
            <view class="cta-copy">
              <text>{{snapshotSaved ? '查看我的决策记录' : '保存决策快照'}}</text>
              <text class="cta-sub">{{snapshotSaved ? '对比当时与现在' : '留存结论，之后对比变化'}}</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
          <button class="member-cta secondary-cta" data-addon="remind" bindtap="openWorkspaceAction" aria-label="提醒我相关事件">
            <view class="cta-copy">
              <text>提醒我相关事件</text>
              <text class="cta-sub">关键日期到期提醒</text>
            </view>
            <text class="cta-arrow">›</text>
          </button>
        </view>
      </view>
    </view>

    <!-- 借鉴抖音连刷：在当前标的队列中一键切上一只/下一只，零跳转成本。 -->
    <view wx:if="{{peerNav}}" class="page-card peer-nav-bar">
      <view
        class="peer-nav-btn"
        data-id="{{peerNav.prev.id}}"
        bindtap="switchPeer"
        hover-class="tap-active"
        aria-role="button"
        aria-label="切换上一只：{{peerNav.prev.name}}"
      >
        <text class="peer-nav-dir">‹ 上一只</text>
        <text class="peer-nav-name">{{peerNav.prev.name}}</text>
      </view>
      <text class="peer-nav-index">{{peerNav.indexText}}</text>
      <view
        class="peer-nav-btn is-next"
        data-id="{{peerNav.next.id}}"
        bindtap="switchPeer"
        hover-class="tap-active"
        aria-role="button"
        aria-label="切换下一只：{{peerNav.next.name}}"
      >
        <text class="peer-nav-dir">下一只 ›</text>
        <text class="peer-nav-name">{{peerNav.next.name}}</text>
      </view>
    </view>

    <!-- 轻量低调工具行：需要转发时一点生成长图或复制摘要，平时不抢正文视线。 -->
    <view class="share-lite-bar">
      <text class="share-lite-link" bindtap="generateSharePoster" aria-role="button">{{posterBusy ? '正在生成长图...' : '生成图片卡片'}}</text>
      <text class="share-lite-sep">·</text>
      <text class="share-lite-link" bindtap="copyShareCard" aria-role="button">复制文字摘要</text>
    </view>

    <!-- 离屏高清研报海报画布（375×540 逻辑像素 × 设备 DPR）。 -->
    <canvas type="2d" id="share-poster-canvas" class="share-poster-canvas"></canvas>

    <!-- 看完详情还没有对应市场账户：一键进入开户引导闭环 -->
    <view
      wx:if="{{market === 'us'}}"
      class="us-start-link"
      bindtap="openUsStart"
      hover-class="tap-active"
      aria-role="link"
      aria-label="第一次买美股？查看开户教程"
    >
      <text class="us-start-ask">第一次买美股？</text>
      <text class="us-start-go">查看美股开户 ›</text>
    </view>
    <view
      wx:elif="{{market === 'hk'}}"
      class="us-start-link"
      bindtap="openHkOpen"
      hover-class="tap-active"
      aria-role="link"
      aria-label="还没有港股账户？查看港股开户"
    >
      <text class="us-start-ask">还没有港股账户？</text>
      <text class="us-start-go">查看港股开户 ›</text>
    </view>
    <view
      wx:elif="{{market === 'a'}}"
      class="us-start-link"
      bindtap="openAOpen"
      hover-class="tap-active"
      aria-role="link"
      aria-label="还没有A股账户？查看A股开户"
    >
      <text class="us-start-ask">还没有A股账户？</text>
      <text class="us-start-go">查看A股开户 ›</text>
    </view>

    <partner-strip market="{{market}}" />

    <text class="disclaimer">{{view.disclaimer}}</text>
  </view>

  <view wx:if="{{snapshotSheetOpen}}" class="snapshot-mask" catchtouchmove="true">
    <view class="snapshot-sheet">
      <view class="snapshot-head">
        <text class="snapshot-title">决策快照预览</text>
        <button class="snapshot-close" bindtap="closeSnapshotSheet">关闭</button>
      </view>
      <text class="snapshot-sub">系统将自动保存当时价格、结论、风险与数据截止时间。公开答案仍免费；正式保存用于个人跟踪与复盘。</text>
      <view class="snapshot-preview" wx:if="{{snapshotPreview}}">
        <text>{{snapshotPreview.priceLabel || '价格待核'}} · {{snapshotPreview.oneLiner || '结论待核'}}</text>
        <text wx:if="{{snapshotPreview.researchScore != null}}">{{snapshotPreview.researchScoreLabel}} {{snapshotPreview.researchScore}}</text>
        <text wx:if="{{snapshotPreview.metricLabel}}">{{snapshotPreview.metricLabel}}</text>
        <text wx:if="{{snapshotPreview.risk}}">风险：{{snapshotPreview.risk}}</text>
        <text>数据截止：{{snapshotPreview.asOf || snapshotPreview.snapshotUpdatedAt || '待核'}}</text>
      </view>
      <text class="snapshot-field-label">为什么关注</text>
      <view class="chip-row">
        <button wx:for="{{reasonOptions}}" wx:key="id" class="chip {{reasonIndex === index ? 'chip-active' : ''}}" data-index="{{index}}" bindtap="selectReasonChip">{{item.label}}</button>
      </view>
      <text class="snapshot-field-label">何时重新评估</text>
      <view class="chip-row">
        <button wx:for="{{reviewConditionOptions}}" wx:key="id" class="chip {{reviewConditionIndex === index ? 'chip-active' : ''}}" data-index="{{index}}" bindtap="selectReviewChip">{{item.label}}</button>
      </view>
      <text class="snapshot-field-label">下次查看</text>
      <view class="chip-row">
        <button class="chip {{reviewAtPreset === 7 ? 'chip-active' : ''}}" data-days="7" bindtap="selectReviewAtPreset">7天后</button>
        <button class="chip {{reviewAtPreset === 14 ? 'chip-active' : ''}}" data-days="14" bindtap="selectReviewAtPreset">14天后</button>
        <button class="chip {{reviewAtPreset === 30 ? 'chip-active' : ''}}" data-days="30" bindtap="selectReviewAtPreset">30天后</button>
      </view>
      <view class="snapshot-input"><text>日期</text><input value="{{snapshotReviewAt}}" maxlength="20" placeholder="YYYY-MM-DD" bindinput="inputSnapshotReviewAt" /></view>
      <view class="snapshot-note">
        <text>个人备注（选填）</text>
        <textarea maxlength="300" auto-height placeholder="可不填；系统快照仍会保存" value="{{snapshotNote}}" bindinput="inputSnapshotNote"></textarea>
      </view>
      <button class="primary-button snapshot-save" bindtap="confirmSnapshotSave" loading="{{snapshotSaving}}" disabled="{{snapshotSaving}}">确认保存决策快照</button>
      <text class="snapshot-legal">不构成荐股或收益承诺。未成功保存前不会写入你的记录。</text>
    </view>
  </view>

  <view wx:if="{{!ready && loading}}" class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">正在加载资料</text>
    <text class="empty-sub">请稍候</text>
  </view>

  <view wx:elif="{{!ready}}" class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">{{loadError || '资料暂不可用'}}</text>
    <text class="empty-sub">可下拉刷新，或返回列表重试</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
