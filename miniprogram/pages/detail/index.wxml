<view class="page-shell detail-shell">
  <view wx:if="{{ready}}" class="detail-content">
    <view class="detail-summary {{view.tone}}">
      <view class="summary-top">
        <view class="summary-identity">
          <text class="summary-label">{{view.marketLabel}}</text>
          <text class="title">{{view.title}}</text>
          <text class="code">{{view.code}}</text>
        </view>
        <view class="summary-score" wx:if="{{view.researchScore != null}}">
          <text class="summary-score-value">{{view.researchScore}}</text>
          <text class="summary-score-label">{{view.researchScoreLabel || '评分'}}</text>
        </view>
        <view wx:else class="detail-image-wrap">
          <image class="detail-image" src="{{view.icon}}" mode="aspectFit" aria-hidden="true"></image>
        </view>
      </view>

      <view class="conclusion-card">
        <text class="conclusion-label">结论</text>
        <text class="conclusion-grade">{{view.badge || view.quickAnswer}}</text>
      </view>
      <text wx:if="{{view.pageHelp}}" class="page-help">{{view.pageHelp}}</text>
      <text wx:if="{{view.researchScoreBasis}}" class="score-basis">{{view.researchScoreBasis}}</text>
    </view>

    <view wx:if="{{view.highlights.length}}" class="highlight-panel">
      <view wx:for="{{view.highlights}}" wx:key="label" class="highlight-cell">
        <text class="highlight-label">{{item.label}}</text>
        <text class="highlight-value">{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{view.exitPlan && view.exitPlan.show}}" class="exit-plan {{view.exitPlan.locked ? 'is-locked' : ''}}">
      <view class="exit-plan-head">
        <text class="exit-plan-title">{{view.exitPlan.title}}</text>
        <text wx:if="{{view.exitPlan.locked}}" class="exit-plan-tag">会员</text>
      </view>
      <view class="exit-plan-rows">
        <view wx:for="{{view.exitPlan.rows}}" wx:key="label" class="exit-plan-row">
          <text>{{item.label}}</text>
          <text class="{{item.locked ? 'is-blur' : ''}}">{{item.value}}</text>
        </view>
      </view>
      <text class="exit-plan-basis">{{view.exitPlan.basis}}</text>
      <text class="exit-plan-disclaimer">{{view.exitPlan.disclaimer}}</text>
      <view
        wx:if="{{view.exitPlan.locked}}"
        class="exit-plan-cta"
        bindtap="openMember"
        hover-class="tap-active"
        aria-role="button"
        aria-label="开通会员查看出价观察"
      >开通查看暗盘/首周出价观察 ›</view>
    </view>

    <block wx:if="{{view.charts.length}}">
      <view wx:for="{{view.charts}}" wx:key="title" class="visual-card">
        <text class="visual-title">{{item.title}}</text>
        <text wx:if="{{item.hint}}" class="visual-hint">{{item.hint}}</text>

        <view wx:if="{{item.stats && item.stats.length}}" class="chart-stats">
          <view wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label" class="chart-stat">
            <text>{{stat.label}}</text>
            <text>{{stat.value}}</text>
          </view>
        </view>

        <view wx:if="{{item.kind == 'columns'}}" class="column-chart">
          <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="column-slot">
            <view class="column-bar {{col.tone}}" style="height: {{col.height}}%;"></view>
          </view>
        </view>
        <view wx:if="{{item.kind == 'columns'}}" class="column-labels">
          <text>{{item.lowLabel}}</text>
          <text>{{item.latestLabel}}</text>
          <text>{{item.highLabel}}</text>
        </view>

        <view wx:if="{{item.kind == 'solid'}}" class="solid-chart">
          <view wx:for="{{item.items}}" wx:for-item="col" wx:key="id" class="solid-slot">
            <text class="solid-value">{{col.valueText}}</text>
            <view class="solid-pillar-wrap">
              <view class="solid-bar {{col.tone}} tone-{{col.colorIndex}}" style="height: {{col.height}}%;"></view>
            </view>
            <text class="solid-label">{{col.label}}</text>
          </view>
        </view>

        <view wx:if="{{item.kind == 'bars'}}" class="bar-chart">
          <view wx:for="{{item.items}}" wx:for-item="bar" wx:key="id" class="bar-row">
            <view class="bar-copy"><text>{{bar.label}}</text><text>{{bar.valueText}}</text></view>
            <view class="bar-track">
              <view class="bar-value {{bar.tone}} tone-{{bar.colorIndex}}" style="width: {{bar.width}}%;"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{item.kind == 'meter'}}" class="meter-chart">
          <view class="meter-track">
            <view class="meter-fill" style="width: {{item.percent}}%;"></view>
            <view class="meter-dot" style="left: {{item.percent}}%;"></view>
          </view>
          <view class="meter-labels">
            <text>{{item.lowLabel}}</text>
            <text>{{item.midLabel}}</text>
            <text>{{item.highLabel}}</text>
          </view>
        </view>

        <view wx:if="{{item.kind == 'tiles'}}" class="tile-chart">
          <view wx:for="{{item.items}}" wx:for-item="tile" wx:key="id" class="tile-cell">
            <text>{{tile.label}}</text>
            <text>{{tile.valueText}}</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{view.metrics.length}}" class="metric-panel">
      <text class="block-title">{{view.metricsTitle || '关键数据'}}</text>
      <view class="metric-grid">
        <view wx:for="{{view.metrics}}" wx:key="*this" class="metric">
          <text>{{item[0]}}</text>
          <text>{{item[1]}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{view.facts.length}}" class="section-card">
      <text class="block-title">{{view.factsTitle || '详细资料'}}</text>
      <view wx:for="{{view.facts}}" wx:key="*this" class="fact-row">
        <text>{{item[0]}}</text>
        <text>{{item[1]}}</text>
      </view>
    </view>

    <view wx:if="{{view.holdings.length}}" class="section-card">
      <text class="block-title">机构持仓对照</text>
      <view wx:for="{{view.holdings}}" wx:key="name" class="fact-row">
        <text>{{item.name}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>

    <view wx:if="{{view.analysis.length}}" class="section-card analysis-card">
      <view class="analysis-head">
        <text class="block-title">{{view.analysisTitle || '研究要点'}}</text>
        <view class="details-toggle-inline" bindtap="toggleDetails" hover-class="tap-active">
          <text>{{detailsExpanded ? '收起分析' : '完整分析'}}</text>
        </view>
      </view>
      <view wx:if="{{detailsExpanded}}">
        <view wx:for="{{view.analysis}}" wx:key="title" class="analysis-block">
          <text class="analysis-index">{{item.indexLabel}}</text>
          <view class="analysis-copy">
            <text class="analysis-title">{{item.title}}</text>
            <text class="analysis-body">{{item.body}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{view.risk}}" class="risk-card">
      <text class="risk-label">{{view.riskLabel}}</text>
      <text class="risk-body">{{view.risk}}</text>
    </view>

    <view wx:if="{{view.sourceNote}}" class="source-note">
      <text>来源 {{view.sourceNote}}</text>
    </view>

    <button class="member-cta" bindtap="openWorkspace" aria-label="保存到我的记录">
      <view class="cta-copy">
        <text>保存到我的记录</text>
        <text class="cta-sub">方便以后对照复盘</text>
      </view>
      <text class="cta-arrow">›</text>
    </button>

    <text class="disclaimer">{{view.disclaimer}}</text>
  </view>

  <view wx:elif="{{loading}}" class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">正在加载资料</text>
    <text class="empty-sub">请稍候</text>
  </view>

  <view wx:else class="empty">
    <image src="/assets/home/today.svg" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">{{loadError || '资料暂不可用'}}</text>
    <text class="empty-sub">可下拉刷新，或返回列表重试</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
