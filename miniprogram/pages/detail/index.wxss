  .dual-bars-img { height: 156px; }
  .dual-legend-item, .dual-x-lbl, .dual-x-a, .dual-x-b { font-size: 13px; }
  .cmp-row-label { font-size: 14px; }
  .cmp-row-vals { font-size: 13px; }
  .ref-plan-row { padding: 10px 14px; border-radius: 12px; }
  .ref-plan-k { font-size: 15px; }
  .ref-plan-v { font-size: 17px; }
  .ref-plan-note { font-size: 13px; }
  .period-cell { padding: 10px 8px; border-radius: 12px; }
  .period-label { font-size: 13px; }
  .period-val { font-size: 16px; }
  .div-calc-pill { padding: 9px 0; font-size: 14px; border-radius: 10px; }
  .div-calc-k, .drip-k, .div-life-tag, .div-sub-tag { font-size: 13px; }
  .div-calc-v { font-size: 21px; }
  .drip-donut-img { width: 68px; height: 68px; }
  .drip-v { font-size: 16px; }
  .fact-row, .action-row, .source-link-row { min-height: 48px; padding: 10px 16px; font-size: 15px; }
  .evidence-item text, .risk-body, .analysis-body, .fact-row text { font-size: 15px; }
  .analysis-title { font-size: 16px; }
  .snapshot-mask { justify-content: center; }
  .snapshot-sheet { max-width: 640px; padding: 20px 24px calc(20px + env(safe-area-inset-bottom)); border-radius: 20px 20px 0 0; }
