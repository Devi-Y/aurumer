.detail-shell {
  padding: 20rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f6f7fa;
}

.detail-content {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: stretch;
}

.detail-hero-body,
.metric-panel,
.visual-card,
.section-card,
.exit-plan,
.details-toggle,
.member-cta,
.risk-card,
.empty {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
}

/* 对标 Robinhood × Apple 股市：通透纯白大字头部卡片，告别沉闷深黑横幅 */
.detail-hero-card {
  padding: 26rpx 26rpx 24rpx;
  background: #ffffff;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.hero-tag-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.hero-label {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #f1f4f9;
  color: #475569;
  font-size: 21rpx;
  font-weight: 660;
}

.hero-judgment {
  overflow: hidden;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #edf3ff;
  color: #1d5fd1;
  font-size: 21rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-star-btn {
  flex: none;
  padding: 6rpx 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  font-weight: 640;
}

.hero-star-btn.is-starred {
  border-color: #fcd34d;
  background: #fffbeb;
  color: #b45309;
}

.hero-name-row {
  display: flex;
  margin-top: 16rpx;
  align-items: baseline;
  gap: 12rpx;
}

.hero-title {
  min-width: 0;
  color: #0f172a;
  font-size: 42rpx;
  font-weight: 780;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
  overflow-wrap: anywhere;
}

.hero-code {
  flex: none;
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 560;
  font-variant-numeric: tabular-nums;
}

.hero-price-row {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.hero-big-figure {
  color: #0f172a;
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: -1.6rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.08;
}

.hero-delta-pill {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #94a3b8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.hero-delta-pill.tone-up { background: #dc4c3e; color: #ffffff; }
.hero-delta-pill.tone-down { background: #159960; color: #ffffff; }
.hero-delta-pill.tone-brand { background: #eaf2ff; color: #1d5fd1; }
.hero-delta-pill.tone-flat { background: #f1f4f9; color: #475569; }

.hero-asof {
  display: block;
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

/* Apple 股市风格双列整洁关键指标格：无外框嵌套，细线分隔，一眼扫完全部硬数字 */
.apple-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 28rpx;
  margin-top: 18rpx;
  padding: 6rpx 4rpx;
  border-top: 1rpx solid #edf0f5;
  border-bottom: 1rpx solid #edf0f5;
}

.apple-stat-cell {
  display: flex;
  padding: 16rpx 0;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  border-bottom: 1rpx solid #f3f5f9;
}

.apple-stat-cell:nth-last-child(-n + 2) {
  border-bottom: 0;
}

.apple-stat-k {
  flex: none;
  color: #64748b;
  font-size: 23rpx;
}

.apple-stat-v {
  min-width: 0;
  overflow: hidden;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fey-takeaways {
  margin-top: 14rpx;
  padding: 0 4rpx;
}

.score-basis {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #797d85;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 结论条下面紧跟核心数据，中间用一条分隔线，而不是再起一张卡。 */
.conclusion-card + .highlight-panel {
  border-top: 1rpx solid #edeef0;
}

.highlight-panel {
  display: flex;
  padding: 8rpx 4rpx;
  background: #ffffff;
}

.highlight-cell {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 18rpx 12rpx;
  text-align: center;
}

.highlight-cell + .highlight-cell {
  border-left: 1rpx solid #edeef0;
}

.highlight-label {
  display: block;
  color: #797d85;
  font-size: 20rpx;
  font-weight: 560;
}

.highlight-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #16181b;
  font-size: 26rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 详情页先给出一排清晰模块；每次只渲染一个模块，避免把整份研究报告堆成长页。 */
.detail-tabs {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  white-space: nowrap;
  border-radius: 999rpx;
  background: #eaeef5;
}

.detail-tabs-inner {
  display: inline-flex;
  min-width: 100%;
  height: 84rpx;
  padding: 8rpx;
  align-items: center;
  gap: 8rpx;
}

.detail-tab {
  display: inline-flex;
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #5b6472;
  font-size: 27rpx;
  font-weight: 620;
  white-space: nowrap;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.detail-tab.on {
  background: #1d5fd1;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(29, 95, 209, 0.24);
}

.detail-tab-tap { opacity: .72; }

.module-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 22rpx 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.035);
}

.module-content { min-width: 0; }

.module-title {
  display: block;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 760;
  letter-spacing: -0.3rpx;
}

/* Claude Callout 风格的核心研报结论卡：左侧品牌强调竖线 + 极淡蓝底 + 舒适行高。 */
.module-answer {
  display: block;
  margin-top: 14rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #1d5fd1;
  border-radius: 6rpx 18rpx 18rpx 6rpx;
  background: #f4f7fd;
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.68;
}

.module-empty {
  margin-top: 16rpx;
  padding: 24rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f7f8;
  color: #898c92;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.module-content > .visual-card:first-of-type,
.module-content > .section-card:first-of-type,
.module-content > .metric-panel:first-of-type {
  margin-top: 16rpx;
}

.module-content .exit-plan { margin-top: 16rpx; }
.module-content .section-card { margin-top: 16rpx; }
.module-content .metric-panel { margin-top: 16rpx; }
.module-content .analysis-card { padding-bottom: 18rpx; }

.collapsed-hint {
  display: block;
  margin: 18rpx 22rpx 2rpx;
  color: #898c92;
  font-size: 24rpx;
  line-height: 1.5;
}

.block-title {
  display: block;
  padding: 18rpx 22rpx 0;
  color: #161a21;
  font-size: 28rpx;
  font-weight: 720;
}

.metric-panel {
  margin-top: 16rpx;
  padding-bottom: 8rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 10rpx 14rpx;
}

.conclusion-card {
  display: flex;
  padding: 20rpx 22rpx;
  align-items: center;
  gap: 14rpx;
  border-left: 8rpx solid #1d5fd1;
  border-radius: 0 18rpx 18rpx 0;
  background: #ffffff;
}

.conclusion-label {
  flex: none;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 740;
}

.conclusion-target {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1f2226;
  font-size: 28rpx;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conclusion-grade {
  flex: 1;
  min-width: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e9f0fc;
  color: #1d5fd1;
  font-size: 32rpx;
  font-weight: 760;
  text-align: center;
}

.page-help {
  display: block;
  margin-top: 16rpx;
  overflow: hidden;
  color: #4c5057;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exit-plan {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 20rpx;
  background: #f7f9fb;
}

.strategy-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f2f4f7;
}

.strategy-card.tone-good { background: #edf1f8; }
.strategy-card.tone-warn { background: #fff7ec; }
.strategy-card.tone-bad { background: #fdf0ee; }
.strategy-card.tone-muted { background: #f1f2f3; }

.strategy-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.strategy-card-title {
  color: #242933;
  font-size: 28rpx;
  font-weight: 760;
}

.strategy-card-head-right {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
}

.strategy-card-label {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #1d5fd1;
  font-size: 22rpx;
  font-weight: 720;
}

.tone-warn .strategy-card-label { color: #93621d; }
.tone-bad .strategy-card-label { color: #a34b3e; }
.tone-muted .strategy-card-label { color: #767a81; }

.strategy-card-action,
.strategy-card-trigger,
.strategy-card-basis {
  display: block;
  margin-top: 10rpx;
  color: #444b57;
  font-size: 25rpx;
  line-height: 1.55;
}

.strategy-card-trigger { color: #646b76; }
.strategy-card-basis { color: #898d95; font-size: 21rpx; }

.strategy-card .collapsed-hint {
  margin: 10rpx 0 0;
  padding: 0;
  font-size: 23rpx;
}

.exit-plan.is-locked {
  background: #f4f5f6;
  border-color: #e6e9ed;
}

.exit-plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.exit-plan-title {
  color: #161a21;
  font-size: 28rpx;
  font-weight: 700;
}

.exit-plan-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e9f0fc;
  color: #1d5fd1;
  font-size: 20rpx;
  font-weight: 700;
}

.exit-plan-rows {
  margin-top: 12rpx;
}

.exit-plan-row {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.exit-plan-row + .exit-plan-row {
  border-top: 1rpx solid #e6e9ed;
}

.exit-plan-row text:first-child {
  color: #696d75;
  font-size: 24rpx;
}

.exit-plan-row text:last-child {
  color: #16181b;
  font-size: 30rpx;
  font-weight: 740;
}

.exit-plan-row text.is-blur {
  color: #999da4;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.exit-plan-basis,
.exit-plan-disclaimer {
  display: block;
  margin-top: 10rpx;
  color: #797d85;
  font-size: 20rpx;
  line-height: 1.4;
}

.order-plan { padding-bottom: 8rpx; }

.order-row {
  display: flex;
  min-height: 76rpx;
  padding: 10rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.exit-plan-title + .order-row { margin-top: 8rpx; }
.order-row + .order-row { border-top: 1rpx solid #e6e9ed; }
/* 三档价和两个判断用的数之间隔开一点，读成两组。 */
.order-row.is-high { border-top-width: 6rpx; border-top-color: #eef1f5; }

.order-label {
  flex: none;
  color: #696d75;
  font-size: 24rpx;
}

.order-value {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-end;
}

.order-price {
  color: #16181b;
  font-size: 30rpx;
  font-weight: 740;
  font-variant-numeric: tabular-nums;
}

.order-row.is-buy .order-price { color: #1d5fd1; }
.order-row.is-stop .order-price { color: #a34b3e; }

.order-note {
  margin-top: 2rpx;
  color: #898d95;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.exit-plan-cta {
  margin-top: 14rpx;
  padding: 16rpx 0 2rpx;
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 700;
}

.tap-active {
  opacity: 0.72;
}

.score-row {
  display: flex;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.score-row text {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .9);
  color: #5f6268;
  font-size: 24rpx;
  font-weight: 650;
}

.score-row .grade-pill {
  background: #eff1f4;
  color: #1d5fd1;
}

.metric-panel {
  margin-top: 16rpx;
  padding-bottom: 4rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
}

.metric {
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #edeef0;
  background: linear-gradient(180deg, #ffffff 0%, #fbfbfc 100%);
}

.metric:nth-child(odd) { border-right: 1rpx solid #edeef0; }
.metric:nth-last-child(-n + 2) { border-bottom: 0; }
.metric text { display: block; }
.metric text:first-child { color: #797d85; font-size: 22rpx; font-weight: 560; }
.metric text:last-child {
  margin-top: 8rpx;
  overflow: hidden;
  color: #16181b;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-right: 18rpx;
}

.analysis-head .block-title {
  padding-bottom: 0;
}

.details-toggle-inline {
  flex: none;
  padding: 8rpx 12rpx;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 680;
}

.source-note {
  margin-top: 12rpx;
  padding: 0 8rpx;
  color: #898c92;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f3f4f7;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1a1d22;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #696d75;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #edf2fb; }
.freshness-banner.tone-warn { background: #fff7ec; }
.freshness-banner.tone-bad { background: #fdf0ee; }

.action-stack {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.secondary-cta {
  background: #f3f4f7 !important;
}
.secondary-cta .cta-copy text:first-child { color: #1a1d22; }
.secondary-cta .cta-sub { color: #58606f; }
.secondary-cta .cta-arrow { color: #797d85; }

.empty {
  display: flex;
  min-height: 380rpx;
  margin-top: 16rpx;
  padding: 36rpx 30rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #76797e;
  font-size: 28rpx;
  text-align: center;
}
.empty image { width: 74rpx; height: 74rpx; margin-bottom: 7rpx; }
.empty-title { color: #1f2226; font-size: 31rpx; font-weight: 760; }
.empty-sub { color: #898c92; font-size: 24rpx; }

.visual-card {
  margin-top: 16rpx;
  padding: 22rpx 20rpx 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.025);
}
.visual-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}
.visual-title {
  display: block;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 740;
}
.visual-ranges {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.visual-range-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #5b6472;
  font-size: 21rpx;
  font-weight: 620;
  line-height: 1.35;
}
.visual-range-pill.is-active {
  background: #edf3ff;
  color: #1d5fd1;
  font-weight: 700;
}
.visual-hint {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.55;
}
.chart-stat text:first-child { color: #797d85; font-size: 20rpx; }
.chart-stat text:last-child {
  margin-top: 4rpx;
  overflow: hidden;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 720;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-stats {
  display: flex;
  flex-wrap: nowrap;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f4f5f8;
}
.chart-stat {
  box-sizing: border-box;
  min-width: 0;
  flex: 1 1 0;
  padding: 12rpx 4rpx;
  text-align: center;
}
.chart-stat + .chart-stat { border-left: 1rpx solid #e3e6ec; }
.chart-stat text { display: block; }

.column-chart {
  display: flex;
  height: 200rpx;
  margin-top: 16rpx;
  padding: 12rpx 8rpx 0;
  align-items: flex-end;
  gap: 3rpx;
  border-bottom: 1rpx solid #d6dbe4;
  background: #f7f8fa;
}
.column-slot {
  display: flex;
  height: 100%;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
  justify-content: center;
}
.column-bar {
  width: 86%;
  min-height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #3168c0;
}
.column-bar.latest { background: #1d5fd1; }
.column-bar.peak { background: #d99a12; }
.column-bar.floor { background: #8fb2ee; }
.column-labels {
  display: flex;
  margin-top: 8rpx;
  justify-content: space-between;
  gap: 8rpx;
  color: #797d85;
  font-size: 22rpx;
}
.column-labels text:nth-child(2) { color: #1d5fd1; font-weight: 700; text-align: center; }
.column-labels text:last-child { text-align: right; }

.line-chart-wrap { margin-top: 16rpx; }
.line-chart-img {
  display: block;
  width: 100%;
  height: 204rpx;
  border: 1rpx solid #eef2f7;
  border-radius: 14rpx;
  background: #f8fafd;
}

.radar-chart-wrap { margin-top: 16rpx; }
.radar-chart-canvas {
  display: block;
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.scatter-chart-wrap { margin-top: 16rpx; }
.scatter-chart-canvas {
  display: block;
  width: 100%;
  height: 240rpx;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.solid-chart {
  display: flex;
  height: 260rpx;
  margin-top: 16rpx;
  align-items: flex-end;
  gap: 4rpx;
}
.solid-slot {
  display: flex;
  min-width: 0;
  height: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.solid-value {
  margin-bottom: 6rpx;
  overflow: hidden;
  max-width: 100%;
  color: #1d5fd1;
  font-size: 21rpx;
  font-weight: 740;
  letter-spacing: -0.5rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.solid-pillar-wrap {
  display: flex;
  width: 100%;
  height: 180rpx;
  align-items: flex-end;
  justify-content: center;
}
.solid-bar {
  width: 58%;
  min-height: 16rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: linear-gradient(180deg, #7fa8ee 0%, #3168c0 55%, #1d5fd1 100%);
  box-shadow: 0 2rpx 5rpx rgba(29, 95, 209, 0.18);
  transform-origin: center bottom;
  animation: solidBarGrow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
/* 负值柱子用暖色，和同组的蓝柱分开。 */
.solid-bar.down { background: linear-gradient(180deg, #ef9a78 0%, #d97757 55%, #b25a3f 100%); box-shadow: 0 2rpx 5rpx rgba(217, 119, 87, 0.2); }
@keyframes solidBarGrow {
  from { transform: scaleY(0); }
  to { transform: scaleY(1); }
}
/* 13F 里没映射到代码的持仓只有发行人全名，窄柱下会和邻柱叠在一起，按列宽截断。 */
.solid-label {
  margin-top: 8rpx;
  overflow: hidden;
  max-width: 100%;
  color: #4c5057;
  font-size: 21rpx;
  font-weight: 620;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-chart { margin-top: 16rpx; }
.bar-row + .bar-row { margin-top: 14rpx; }
.bar-copy {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #4c5057;
  font-size: 26rpx;
  font-weight: 600;
}
.bar-copy text:last-child { color: #1d5fd1; font-weight: 740; }
.bar-track {
  overflow: hidden;
  height: 18rpx;
  margin-top: 6rpx;
  border-radius: 4rpx;
  background: #e7eaef;
}
.bar-value {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #7fa8ee 0%, #3168c0 100%);
  transform-origin: left center;
  animation: barValueGrow 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
/* 负值横条同 .solid-bar.down */
.bar-value.down { background: linear-gradient(90deg, #ef9a78 0%, #d97757 100%); }
@keyframes barValueGrow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

.meter-chart { margin-top: 18rpx; }
.meter-track {
  position: relative;
  height: 18rpx;
  overflow: hidden;
  border-radius: 9rpx;
  background: #e7eaef;
}
.meter-fill {
  height: 100%;
  border-radius: 9rpx;
  background: linear-gradient(90deg, #8fb2ee 0%, #1d5fd1 100%);
  transition: width 0.3s ease;
}
.meter-dot {
  position: absolute;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  margin-left: -11rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #1d5fd1;
  box-shadow: 0 2rpx 6rpx rgba(29, 95, 209, 0.4);
  transition: left 0.3s ease;
}
.meter-labels {
  display: flex;
  margin-top: 12rpx;
  justify-content: space-between;
  gap: 8rpx;
  color: #797d85;
  font-size: 22rpx;
}
.meter-labels text:nth-child(2) {
  color: #1d5fd1;
  font-weight: 720;
  text-align: center;
}
.meter-labels text:last-child { text-align: right; }

.tile-chart {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  border: 1rpx solid #e6e9ed;
  border-radius: 12rpx;
  overflow: hidden;
}
.tile-cell {
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 18rpx 14rpx;
  border-right: 1rpx solid #edeef0;
  border-bottom: 1rpx solid #edeef0;
  background: #fafbfc;
}
.tile-cell:nth-child(2n) { border-right: 0; }
.tile-cell:nth-last-child(-n + 2) { border-bottom: 0; }
.tile-cell text { display: block; }
.tile-cell text:first-child { color: #797d85; font-size: 24rpx; }
.tile-cell text:last-child {
  margin-top: 6rpx;
  overflow: hidden;
  color: #16181b;
  font-size: 28rpx;
  font-weight: 740;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-card { margin-top: 16rpx; }

.fact-block + .fact-block { margin-top: 14rpx; border-top: 1rpx solid #edeef0; }

.details-toggle {
  display: flex;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 16rpx 23rpx;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  color: #1d5fd1;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.45;
  text-align: left;
}
.details-toggle,
.member-cta {
  width: calc(100vw - 40rpx) !important;
  margin-right: 0;
  margin-left: 0;
  align-self: auto;
}
.details-toggle text:last-child { color: #8a8e95; font-size: 26rpx; }

.fact-row,
.action-row {
  display: flex;
  min-height: 78rpx;
  padding: 16rpx 22rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
}
.fact-row + .fact-row,
.action-row + .action-row,
.analysis-block + .analysis-block { border-top: 1rpx solid #edeef0; }
.fact-row text:first-child,
.action-row text:first-child { width: 170rpx; flex: none; color: #73767c; }
.fact-row text:last-child,
.action-row text:last-child {
  min-width: 0;
  flex: 1;
  color: #24272b;
  font-weight: 620;
  text-align: right;
  overflow-wrap: anywhere;
}
.action-row text:first-child { color: #1d5fd1; font-weight: 730; }

.analysis-block { display: flex; padding: 21rpx 22rpx; align-items: flex-start; gap: 15rpx; }
.analysis-index {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf1fc;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 850;
}
.analysis-copy { min-width: 0; flex: 1; }
.analysis-title,
.analysis-body { display: block; }
.analysis-title { color: #1b1e22; font-size: 30rpx; font-weight: 760; }
.analysis-body { margin-top: 6rpx; color: #4e5157; font-size: 28rpx; line-height: 1.7; }
/* 「动态」tab 的同期备案是一段独立说明，不挂在 analysis-block 的编号项下面，
   补一圈内距，不影响它在 .analysis-copy 里的原有用法。 */
.section-card > .analysis-body { padding: 8rpx 22rpx 18rpx; }

/* 概览 tab 的关键依据：最多三条，圆点起头，比 fact-row 的两栏布局更适合
   单句要点。 */
.evidence-list { padding: 4rpx 22rpx 18rpx; }
.evidence-item {
  display: flex;
  padding: 14rpx 0;
  gap: 10rpx;
  color: #292d33;
  font-size: 26rpx;
  line-height: 1.6;
}
.evidence-item + .evidence-item { border-top: 1rpx solid #edeef0; }
.evidence-item::before {
  content: "";
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #1d5fd1;
}

.risk-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #dd7755;
  border-radius: 0 16rpx 16rpx 0;
  background: #fff8f3;
  color: #66483d;
  font-size: 26rpx;
  line-height: 1.65;
}
.risk-label {
  display: block;
  margin-bottom: 6rpx;
  color: #b85a3a;
  font-size: 24rpx;
  font-weight: 740;
}
.risk-body { display: block; }

.member-cta {
  display: flex;
  min-height: 94rpx;
  margin-top: 22rpx;
  padding: 17rpx 22rpx 17rpx 25rpx;
  align-items: center;
  justify-content: space-between;
  background: #1d5fd1;
  color: #ffffff;
  text-align: left;
}
.cta-copy { min-width: 0; flex: 1; }
.cta-copy text { display: block; }
.cta-copy text:first-child { font-size: 30rpx; font-weight: 650; }
.cta-sub { margin-top: 4rpx; color: rgba(255, 255, 255, .78); font-size: 24rpx; font-weight: 400; }
.cta-arrow { flex: none; font-size: 38rpx; font-weight: 300; line-height: 1; }

.link-rail {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}

.link-chip {
  display: flex;
  min-height: 72rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbdfe5;
  border-radius: 14rpx;
  background: #ffffff;
  color: #2d3646;
  font-size: 28rpx;
  font-weight: 600;
}

.data-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  gap: 3rpx;
  color: #84878c;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
.disclaimer { display: block; margin: 9rpx auto 0; color: #73767c; font-size: 26rpx; line-height: 1.55; text-align: center; }

.us-start-link {
  display: flex;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #e6e9ef;
  border-radius: 16rpx;
  background: #ffffff;
}

.us-start-ask { color: #5c6470; font-size: 26rpx; }
.us-start-go { flex: none; color: #1d5fd1; font-size: 27rpx; font-weight: 650; }

@media (max-width: 340px) {
  .detail-shell { padding-right: 15rpx; padding-left: 15rpx; }
  .detail-hero { margin-right: -15rpx; margin-left: -15rpx; padding: 16rpx 18rpx 38rpx; }
  .hero-title { font-size: 36rpx; }
  .conclusion-grade { font-size: 26rpx; }
  .conclusion-target { font-size: 26rpx; }
  .details-toggle,
  .member-cta { width: calc(100vw - 30rpx) !important; }
  .fact-row,
  .action-row { flex-direction: column; gap: 5rpx; }
  .fact-row text:first-child,
  .action-row text:first-child { width: auto; }
  .fact-row text:last-child,
  .action-row text:last-child { text-align: left; }
}

@media (min-width: 700px) {
  .detail-shell { padding: 24px 32px calc(42px + env(safe-area-inset-bottom)); }
  .detail-hero { margin-right: -32px; margin-left: -32px; padding: 24px 32px 46px; }
  .metric { width: 25%; border-right: 1rpx solid #edeef0; border-bottom: 0; }
  .metric:last-child { border-right: 0; }
  .column-chart { height: 220px; }
  .details-toggle,
  .member-cta { width: calc(100vw - 64px) !important; }
}

.snapshot-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(19, 23, 29, 0.42);
}

.snapshot-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.snapshot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.snapshot-title {
  color: #1a1d22;
  font-size: 32rpx;
  font-weight: 720;
}

.snapshot-close {
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #5e636b;
  font-size: 26rpx;
}

.snapshot-close::after { border: 0; }

.snapshot-sub {
  display: block;
  margin-top: 12rpx;
  color: #5e636b;
  font-size: 24rpx;
  line-height: 1.5;
}

.snapshot-preview {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #edf2fb;
}

.snapshot-preview text {
  display: block;
  margin-top: 6rpx;
  color: #1a1d22;
  font-size: 25rpx;
  line-height: 1.45;
}

.snapshot-picker,
.snapshot-field-label {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  color: #5e636b;
  font-size: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f4f5f6;
  color: #2f3642;
  font-size: 22rpx;
}

.chip::after { border: 0; }

.chip-active {
  background: #1d5fd1;
  color: #fff;
}

.snapshot-input {
  display: flex;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 8rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edeef0;
  color: #1a1d22;
  font-size: 27rpx;
}

.snapshot-input input {
  flex: 1;
  text-align: right;
}

.snapshot-note {
  margin-top: 16rpx;
}

.snapshot-note text {
  display: block;
  margin-bottom: 8rpx;
  color: #5e636b;
  font-size: 24rpx;
}

.snapshot-note textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f4f5f6;
  font-size: 26rpx;
}

.snapshot-save {
  margin-top: 22rpx;
}

.snapshot-legal {
  display: block;
  margin-top: 14rpx;
  color: #797e86;
  font-size: 22rpx;
  line-height: 1.45;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #1d5fd1;
  color: #fff;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 88rpx;
}

.primary-button::after { border: 0; }

/* 官方出处区块。沿用新闻资讯页的行式样：名字在左、"复制链接"在右，
   点整行复制。和 .fact-row 用同一套内距和分隔线，混在资料 tab 里不违和。 */
.source-link-row {
  display: flex;
  min-height: 78rpx;
  padding: 16rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid #edeef0;
  font-size: 28rpx;
  line-height: 1.55;
}

.source-link-name {
  min-width: 0;
  flex: 1;
  color: #1a1d22;
}

.source-link-action {
  flex: none;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 620;
}

.reading-more { margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 18rpx; background: #f2f5fa; color: #1d5fd1; font-size: 27rpx; font-weight: 600; }

/* Stock Events / Simply Wall St 体检微勋章 */
.overview-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.overview-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f4f9;
  color: #475569;
  font-size: 22rpx;
  font-weight: 640;
  font-variant-numeric: tabular-nums;
  line-height: 1.4;
}

.overview-badge.tone-good {
  background: #eaf2ff;
  color: #1d5fd1;
}

.overview-badge.tone-warn {
  background: #fef6e7;
  color: #9a5b13;
}

.overview-facts-card {
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: #fafbfd;
}

/* Quartr 风格 SEC 公告时间轴 */
.filing-card-row {
  padding: 16rpx 22rpx;
  border-top: 1rpx solid #edf0f5;
}

.filing-card-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filing-form-pill {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 20rpx;
  font-weight: 700;
}

.filing-date {
  flex: 1;
  color: #64748b;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.filing-summary {
  display: block;
  margin-top: 8rpx;
  color: #1e293b;
  font-size: 25rpx;
  line-height: 1.55;
}

/* 抖音式左右连刷导航栏 */
.peer-nav-bar {
  display: flex;
  margin-top: 18rpx;
  padding: 12rpx;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.peer-nav-btn {
  display: flex;
  flex: 1;
  min-width: 0;
  padding: 14rpx 16rpx;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  border-radius: 16rpx;
  background: #f5f7fb;
}

.peer-nav-btn.is-next {
  align-items: flex-end;
}

.peer-nav-dir {
  color: #1d5fd1;
  font-size: 21rpx;
  font-weight: 660;
}

.peer-nav-name {
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.peer-nav-index {
  flex: none;
  padding: 4rpx 10rpx;
  color: #94a3b8;
  font-size: 21rpx;
  font-weight: 620;
  font-variant-numeric: tabular-nums;
}

/* 韭圈儿式一键研报分享条 */
.share-card-bar {
  display: flex;
  min-height: 84rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid rgba(29, 95, 209, 0.14);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f4f8ff 0%, #edf3ff 100%);
}

.share-card-label {
  color: #1e293b;
  font-size: 26rpx;
  font-weight: 620;
}

.share-card-go {
  flex: none;
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 700;
}

/* Simply Wall St 风格客观体检进度条卡片 */
.health-check-card {
  padding-bottom: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: #fafbfd;
}

.health-check-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 6rpx 22rpx 6rpx;
}

.health-check-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.health-check-label {
  color: #475569;
  font-size: 24rpx;
  font-weight: 560;
}

.health-check-val {
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.health-check-val.tone-good { color: #166534; }
.health-check-val.tone-warn { color: #b45309; }

.health-check-track {
  height: 12rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e6ebf2;
}

.health-check-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6fa0f2 0%, #1d5fd1 100%);
}

.health-check-fill.tone-good {
  background: linear-gradient(90deg, #4ade80 0%, #15803d 100%);
}

.health-check-fill.tone-warn {
  background: linear-gradient(90deg, #fbbf24 0%, #d97706 100%);
}

.filing-jump-row {
  margin-top: 14rpx;
  border: 1rpx solid rgba(29, 95, 209, 0.14);
  border-radius: 16rpx;
  background: #f4f8ff;
}

/* Simply Wall St 雪花雷达图容器 */
.overview-radar-wrap {
  display: flex;
  justify-content: center;
  padding: 4rpx 16rpx 8rpx;
}

.overview-radar-canvas {
  width: 500rpx;
  height: 360rpx;
}

/* Stock Events 5 年分红点阵 */
.detail-dots-row {
  display: flex;
  margin-top: 12rpx;
  align-items: center;
  gap: 12rpx;
}

.detail-dots-label {
  color: #64748b;
  font-size: 21rpx;
  font-weight: 600;
}

.detail-dot-item {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
}

.detail-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #cbd5e1;
}

.detail-dot.is-ok { background: #16a34a; }
.detail-dot.is-cut { background: #f59e0b; }
.detail-dot.is-miss { background: #d5dce6; }

.detail-dot-yr {
  color: #64748b;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

/* Stock Events 按股数历史分红对照卡 */
.div-calc-card {
  padding-bottom: 18rpx;
  border: 1rpx solid rgba(29, 95, 209, 0.12);
  background: linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
}

.div-calc-head {
  display: flex;
  padding-right: 22rpx;
  align-items: center;
  justify-content: space-between;
}

.div-calc-year {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 20rpx;
  font-weight: 640;
}

.div-calc-pills {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 4rpx 22rpx 14rpx;
}

.div-calc-pill {
  padding: 10rpx 0;
  border: 1rpx solid #dfe6f0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #475569;
  font-size: 23rpx;
  font-weight: 620;
  text-align: center;
}

.div-calc-pill.is-active {
  border-color: #1d5fd1;
  background: #1d5fd1;
  color: #ffffff;
  font-weight: 700;
}

.div-calc-result {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 0 22rpx;
}

.div-calc-metric {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f4f7fc;
}

.div-calc-k {
  color: #64748b;
  font-size: 21rpx;
}

.div-calc-v {
  color: #15803d;
  font-size: 32rpx;
  font-weight: 740;
  font-variant-numeric: tabular-nums;
}

.div-calc-v.is-sub {
  color: #0f172a;
}

.div-calc-note {
  display: block;
  margin-top: 12rpx;
  padding: 0 22rpx;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.45;
}

/* 轻量文字分享条：不造重色块按钮，避免抢夺正文重心 */
.share-lite-bar {
  display: flex;
  margin-top: 18rpx;
  padding: 10rpx 0 4rpx;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.share-lite-link {
  padding: 8rpx 12rpx;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 620;
}

.share-lite-sep {
  color: #cbd5e1;
  font-size: 24rpx;
}

.share-poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 375px;
  height: 540px;
}

/* TradingView 风格多周期历史涨跌条 */
.period-strip {
  display: flex;
  margin-top: 14rpx;
  gap: 8rpx;
}

.period-cell {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 6rpx;
  border-radius: 14rpx;
  background: #f5f7fb;
}

.period-label {
  color: #64748b;
  font-size: 19rpx;
}

.period-val {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.period-val.is-up { color: #c2412d; }
.period-val.is-down { color: #0b7a53; }

/* Perplexity Finance 风格三秒快问快答 */
.qa-card-list {
  padding-bottom: 10rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.qa-row {
  padding: 14rpx 22rpx;
  border-top: 1rpx solid #edf0f5;
}

.qa-q {
  display: block;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 700;
}

.qa-a {
  display: block;
  margin-top: 6rpx;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.55;
}

/* Perplexity Finance 同池可比公司三宫格 */
.peer-cmp-card {
  padding-bottom: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.peer-cmp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 4rpx 22rpx 0;
}

.peer-cmp-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid #e6ebf2;
  border-radius: 14rpx;
  background: #f8fafd;
}

.peer-cmp-name {
  overflow: hidden;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.peer-cmp-m1 {
  color: #1d5fd1;
  font-size: 22rpx;
  font-weight: 660;
  font-variant-numeric: tabular-nums;
}

.peer-cmp-m2 {
  overflow: hidden;
  color: #64748b;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}


