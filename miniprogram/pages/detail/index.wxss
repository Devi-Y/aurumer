  .chart-stat text:last-child { font-size: 16px; }
  .donut-chart-box { padding: 14px 18px; gap: 20px; border-radius: 14px; }
  .donut-ring-wrap, .donut-ring-img { width: 132px; height: 132px; }
  .donut-center-v { font-size: 20px; }
  .donut-center-k, .donut-legend-name, .donut-legend-pct { font-size: 14px; }
  .gauge-img { width: 236px; height: 132px; }
