.detail-shell {
  padding: 20rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f4f6f5;
}

.detail-content {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: stretch;
}

.detail-hero-body,
.metric-panel,
.visual-card,
.section-card,
.exit-plan,
.details-toggle,
.member-cta,
.risk-card,
.empty {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
}

/* 页头通栏。和新闻资讯页、栏目页、明细页是同一条绿带：同一份快照在四个页面
   上的第一眼必须长得一样，读的人才不会以为自己换了个产品。
   负边距是因为 .detail-shell 自己留了 20rpx 的左右内边距，通栏要压过它铺满。
   底部留 40rpx，给下面那张白卡压上来的位置。 */
.detail-hero {
  margin: -20rpx -20rpx 0;
  padding: 18rpx 24rpx 40rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-label {
  flex: none;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  font-weight: 650;
}

.hero-meta {
  flex: none;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-name-row {
  display: flex;
  margin-top: 6rpx;
  align-items: baseline;
  gap: 12rpx;
}

.hero-title {
  min-width: 0;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
  line-height: 1.28;
  overflow-wrap: anywhere;
}

.hero-code {
  flex: none;
  color: rgba(255, 255, 255, 0.66);
  font-size: 24rpx;
}

.hero-stats {
  display: flex;
  margin-top: 12rpx;
  flex-wrap: wrap;
  gap: 10rpx;
}

.hero-stat {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.94);
  font-size: 21rpx;
  font-weight: 600;
}

/* 结论条和核心数据合成一张白卡，压在通栏下沿上——和栏目页的指标卡同一个做法。 */
.detail-hero-body {
  position: relative;
  z-index: 1;
  margin-top: -22rpx;
  padding-bottom: 4rpx;
}

.score-basis {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a847e;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 结论条下面紧跟核心数据，中间用一条分隔线，而不是再起一张卡。 */
.conclusion-card + .highlight-panel {
  border-top: 1rpx solid #edf0ee;
}

.highlight-panel {
  display: flex;
  padding: 8rpx 4rpx;
  background: #ffffff;
}

.highlight-cell {
  box-sizing: border-box;
  width: 25%;
  padding: 16rpx 8rpx;
  text-align: center;
}

.highlight-cell + .highlight-cell {
  border-left: 1rpx solid #edf0ee;
}

.highlight-label {
  display: block;
  color: #7a847e;
  font-size: 20rpx;
  font-weight: 560;
}

.highlight-value {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #171b18;
  font-size: 26rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 详情页先给出一排两字模块；每次只渲染一个模块，避免把整份研究报告堆成长页。 */
.detail-tabs {
  width: 100%;
  height: 84rpx;
  margin-top: 16rpx;
  white-space: nowrap;
  border-radius: 999rpx;
  background: #e9eceb;
}

.detail-tabs-inner {
  display: inline-flex;
  min-width: 100%;
  height: 84rpx;
  padding: 8rpx;
  align-items: center;
  gap: 8rpx;
}

.detail-tab {
  display: inline-flex;
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #69716b;
  font-size: 28rpx;
  font-weight: 620;
  white-space: nowrap;
}

.detail-tab.on {
  background: #202322;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(32, 35, 34, .12);
}

.detail-tab-tap { opacity: .72; }

.module-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  padding: 22rpx 20rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.module-content { min-width: 0; }

.module-title {
  display: block;
  color: #1b211d;
  font-size: 32rpx;
  font-weight: 760;
}

.module-answer {
  display: block;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f2f7f4;
  color: #25312a;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.6;
}

.module-empty {
  margin-top: 16rpx;
  padding: 24rpx 18rpx;
  border-radius: 16rpx;
  background: #f6f8f7;
  color: #8a918c;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.module-content > .visual-card:first-of-type,
.module-content > .section-card:first-of-type,
.module-content > .metric-panel:first-of-type {
  margin-top: 16rpx;
}

.module-content .exit-plan { margin-top: 16rpx; }
.module-content .section-card { margin-top: 16rpx; }
.module-content .metric-panel { margin-top: 16rpx; }
.module-content .analysis-card { padding-bottom: 18rpx; }

.collapsed-hint {
  display: block;
  margin: 18rpx 22rpx 2rpx;
  color: #8a918c;
  font-size: 24rpx;
  line-height: 1.5;
}

.block-title {
  display: block;
  padding: 18rpx 22rpx 0;
  color: #172019;
  font-size: 28rpx;
  font-weight: 720;
}

.metric-panel {
  margin-top: 16rpx;
  padding-bottom: 8rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 10rpx 14rpx;
}

.conclusion-card {
  display: flex;
  padding: 20rpx 22rpx;
  align-items: center;
  gap: 14rpx;
  border-left: 8rpx solid #0b7a53;
  border-radius: 0 18rpx 18rpx 0;
  background: #ffffff;
}

.conclusion-label {
  flex: none;
  color: #0b7a53;
  font-size: 28rpx;
  font-weight: 740;
}

.conclusion-target {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #202521;
  font-size: 28rpx;
  font-weight: 560;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conclusion-grade {
  flex: 1;
  min-width: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f6ef;
  color: #0b7a53;
  font-size: 32rpx;
  font-weight: 760;
  text-align: center;
}

.page-help {
  display: block;
  margin-top: 16rpx;
  overflow: hidden;
  color: #4d5650;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exit-plan {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e3ebe6;
  border-radius: 20rpx;
  background: #f7fbf8;
}

.strategy-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f2f7f4;
}

.strategy-card.tone-good { background: #edf8f2; }
.strategy-card.tone-warn { background: #fff7ec; }
.strategy-card.tone-bad { background: #fdf0ee; }
.strategy-card.tone-muted { background: #f1f3f2; }

.strategy-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.strategy-card-title {
  color: #25312a;
  font-size: 28rpx;
  font-weight: 760;
}

.strategy-card-head-right {
  display: flex;
  flex: none;
  align-items: center;
  gap: 10rpx;
}

.strategy-card-label {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 720;
}

.tone-warn .strategy-card-label { color: #93621d; }
.tone-bad .strategy-card-label { color: #a34b3e; }
.tone-muted .strategy-card-label { color: #778079; }

.strategy-card-action,
.strategy-card-trigger,
.strategy-card-basis {
  display: block;
  margin-top: 10rpx;
  color: #46554c;
  font-size: 25rpx;
  line-height: 1.55;
}

.strategy-card-trigger { color: #66746b; }
.strategy-card-basis { color: #8a948d; font-size: 21rpx; }

.strategy-card .collapsed-hint {
  margin: 10rpx 0 0;
  padding: 0;
  font-size: 23rpx;
}

.exit-plan.is-locked {
  background: #f4f6f5;
  border-color: #e7ece9;
}

.exit-plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.exit-plan-title {
  color: #172019;
  font-size: 28rpx;
  font-weight: 700;
}

.exit-plan-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e8f6ef;
  color: #0b7a53;
  font-size: 20rpx;
  font-weight: 700;
}

.exit-plan-rows {
  margin-top: 12rpx;
}

.exit-plan-row {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.exit-plan-row + .exit-plan-row {
  border-top: 1rpx solid #e7ece9;
}

.exit-plan-row text:first-child {
  color: #6a746e;
  font-size: 24rpx;
}

.exit-plan-row text:last-child {
  color: #171b18;
  font-size: 30rpx;
  font-weight: 740;
}

.exit-plan-row text.is-blur {
  color: #9aa39d;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.exit-plan-basis,
.exit-plan-disclaimer {
  display: block;
  margin-top: 10rpx;
  color: #7a847e;
  font-size: 20rpx;
  line-height: 1.4;
}

.exit-plan-cta {
  margin-top: 14rpx;
  padding: 16rpx 0 2rpx;
  color: #0b7a53;
  font-size: 26rpx;
  font-weight: 700;
}

.tap-active {
  opacity: 0.72;
}

.score-row {
  display: flex;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.score-row text {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .9);
  color: #606762;
  font-size: 24rpx;
  font-weight: 650;
}

.score-row .grade-pill {
  background: #eef5f1;
  color: #0b7a53;
}

.metric-panel {
  margin-top: 16rpx;
  padding-bottom: 4rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
}

.metric {
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #edf0ee;
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfb 100%);
}

.metric:nth-child(odd) { border-right: 1rpx solid #edf0ee; }
.metric:nth-last-child(-n + 2) { border-bottom: 0; }
.metric text { display: block; }
.metric text:first-child { color: #7a847e; font-size: 22rpx; font-weight: 560; }
.metric text:last-child {
  margin-top: 8rpx;
  overflow: hidden;
  color: #171b18;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-right: 18rpx;
}

.analysis-head .block-title {
  padding-bottom: 0;
}

.details-toggle-inline {
  flex: none;
  padding: 8rpx 12rpx;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 680;
}

.source-note {
  margin-top: 12rpx;
  padding: 0 8rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f3f7f5;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1b211d;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #6a746e;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #eef8f2; }
.freshness-banner.tone-warn { background: #fff7ec; }
.freshness-banner.tone-bad { background: #fdf0ee; }

.action-stack {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.secondary-cta {
  background: #f3f7f5 !important;
}
.secondary-cta .cta-copy text:first-child { color: #1b211d; }
.secondary-cta .cta-sub { color: #5a6d62; }
.secondary-cta .cta-arrow { color: #7a847e; }

.empty {
  display: flex;
  min-height: 380rpx;
  margin-top: 16rpx;
  padding: 36rpx 30rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #777d78;
  font-size: 28rpx;
  text-align: center;
}
.empty image { width: 74rpx; height: 74rpx; margin-bottom: 7rpx; }
.empty-title { color: #202521; font-size: 31rpx; font-weight: 760; }
.empty-sub { color: #8a918c; font-size: 24rpx; }

.visual-card {
  margin-top: 16rpx;
  padding: 22rpx 20rpx 24rpx;
  border: 1rpx solid #e7ece9;
  background: #ffffff;
}
.visual-title {
  display: block;
  color: #1b211d;
  font-size: 34rpx;
  font-weight: 760;
}
.visual-hint {
  display: block;
  margin-top: 8rpx;
  color: #5f6963;
  font-size: 26rpx;
  line-height: 1.5;
}
.chart-stat text:first-child { color: #7a847e; font-size: 20rpx; }
.chart-stat text:last-child {
  margin-top: 4rpx;
  overflow: hidden;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 720;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-stats {
  display: flex;
  flex-wrap: nowrap;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f4f8f6;
}
.chart-stat {
  box-sizing: border-box;
  min-width: 0;
  flex: 1 1 0;
  padding: 12rpx 4rpx;
  text-align: center;
}
.chart-stat + .chart-stat { border-left: 1rpx solid #e4ebe6; }
.chart-stat text { display: block; }

.column-chart {
  display: flex;
  height: 200rpx;
  margin-top: 16rpx;
  padding: 12rpx 8rpx 0;
  align-items: flex-end;
  gap: 3rpx;
  border-bottom: 1rpx solid #d7e3db;
  background: #f7faf8;
}
.column-slot {
  display: flex;
  height: 100%;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
  justify-content: center;
}
.column-bar {
  width: 86%;
  min-height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #2fba78;
}
.column-bar.latest { background: #0b7a53; }
.column-bar.peak { background: #d99a12; }
.column-bar.floor { background: #7eb89a; }
.column-labels {
  display: flex;
  margin-top: 8rpx;
  justify-content: space-between;
  gap: 8rpx;
  color: #7a847e;
  font-size: 22rpx;
}
.column-labels text:nth-child(2) { color: #0b7a53; font-weight: 700; text-align: center; }
.column-labels text:last-child { text-align: right; }

.solid-chart {
  display: flex;
  height: 260rpx;
  margin-top: 16rpx;
  align-items: flex-end;
  gap: 8rpx;
}
.solid-slot {
  display: flex;
  min-width: 0;
  height: 100%;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.solid-value {
  margin-bottom: 6rpx;
  overflow: hidden;
  max-width: 100%;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 740;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.solid-pillar-wrap {
  display: flex;
  width: 100%;
  height: 180rpx;
  align-items: flex-end;
  justify-content: center;
}
.solid-bar {
  width: 58%;
  min-height: 16rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: #2fba78;
}
.solid-bar.down { background: #d97757; }
.solid-bar.tone-1 { background: #3b82f6; }
.solid-bar.tone-2 { background: #d99a12; }
.solid-bar.tone-3 { background: #2f9d6a; }
.solid-label {
  margin-top: 8rpx;
  color: #4d5650;
  font-size: 22rpx;
  font-weight: 620;
  text-align: center;
}

.bar-chart { margin-top: 16rpx; }
.bar-row + .bar-row { margin-top: 14rpx; }
.bar-copy {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #4d5650;
  font-size: 26rpx;
  font-weight: 600;
}
.bar-copy text:last-child { color: #0b7a53; font-weight: 740; }
.bar-track {
  overflow: hidden;
  height: 18rpx;
  margin-top: 6rpx;
  border-radius: 4rpx;
  background: #e8eeea;
}
.bar-value {
  height: 100%;
  border-radius: 4rpx;
  background: #2fba78;
}
.bar-value.down { background: #d97757; }
.bar-value.tone-1 { background: #3b82f6; }
.bar-value.tone-2 { background: #d99a12; }
.bar-value.tone-3 { background: #2f9d6a; }

.meter-chart { margin-top: 18rpx; }
.meter-track {
  position: relative;
  height: 18rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #d9efe3 0%, #2fba78 50%, #0b7a53 100%);
}
.meter-fill { height: 100%; }
.meter-dot {
  position: absolute;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin-top: -11rpx;
  margin-left: -11rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #0b7a53;
}
.meter-labels {
  display: flex;
  margin-top: 12rpx;
  justify-content: space-between;
  gap: 8rpx;
  color: #7a847e;
  font-size: 22rpx;
}
.meter-labels text:nth-child(2) {
  color: #0b7a53;
  font-weight: 720;
  text-align: center;
}
.meter-labels text:last-child { text-align: right; }

.tile-chart {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  border: 1rpx solid #e7ece9;
  border-radius: 12rpx;
  overflow: hidden;
}
.tile-cell {
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  padding: 18rpx 14rpx;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #fafcfb;
}
.tile-cell:nth-child(2n) { border-right: 0; }
.tile-cell:nth-last-child(-n + 2) { border-bottom: 0; }
.tile-cell text { display: block; }
.tile-cell text:first-child { color: #7a847e; font-size: 24rpx; }
.tile-cell text:last-child {
  margin-top: 6rpx;
  overflow: hidden;
  color: #171b18;
  font-size: 28rpx;
  font-weight: 740;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-card { margin-top: 16rpx; }

.details-toggle {
  display: flex;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 16rpx 23rpx;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  color: #078d4b;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.45;
  text-align: left;
}
.details-toggle,
.member-cta {
  width: calc(100vw - 40rpx) !important;
  margin-right: 0;
  margin-left: 0;
  align-self: auto;
}
.details-toggle text:last-child { color: #8b948f; font-size: 26rpx; }

.fact-row,
.action-row {
  display: flex;
  min-height: 78rpx;
  padding: 16rpx 22rpx;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
}
.fact-row + .fact-row,
.action-row + .action-row,
.analysis-block + .analysis-block { border-top: 1rpx solid #edf0ee; }
.fact-row text:first-child,
.action-row text:first-child { width: 170rpx; flex: none; color: #747b76; }
.fact-row text:last-child,
.action-row text:last-child {
  min-width: 0;
  flex: 1;
  color: #252a26;
  font-weight: 620;
  text-align: right;
  overflow-wrap: anywhere;
}
.action-row text:first-child { color: #078d4b; font-weight: 730; }

.analysis-block { display: flex; padding: 21rpx 22rpx; align-items: flex-start; gap: 15rpx; }
.analysis-index {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf8f0;
  color: #078d4b;
  font-size: 24rpx;
  font-weight: 850;
}
.analysis-copy { min-width: 0; flex: 1; }
.analysis-title,
.analysis-body { display: block; }
.analysis-title { color: #1c211d; font-size: 30rpx; font-weight: 760; }
.analysis-body { margin-top: 6rpx; color: #4f5651; font-size: 28rpx; line-height: 1.7; }

.risk-card {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #dd7755;
  border-radius: 0 16rpx 16rpx 0;
  background: #fff8f3;
  color: #66483d;
  font-size: 26rpx;
  line-height: 1.65;
}
.risk-label {
  display: block;
  margin-bottom: 6rpx;
  color: #b85a3a;
  font-size: 24rpx;
  font-weight: 740;
}
.risk-body { display: block; }

.member-cta {
  display: flex;
  min-height: 94rpx;
  margin-top: 22rpx;
  padding: 17rpx 22rpx 17rpx 25rpx;
  align-items: center;
  justify-content: space-between;
  background: #0b7a53;
  color: #ffffff;
  text-align: left;
}
.cta-copy { min-width: 0; flex: 1; }
.cta-copy text { display: block; }
.cta-copy text:first-child { font-size: 30rpx; font-weight: 650; }
.cta-sub { margin-top: 4rpx; color: rgba(255, 255, 255, .78); font-size: 24rpx; font-weight: 400; }
.cta-arrow { flex: none; font-size: 38rpx; font-weight: 300; line-height: 1; }

.link-rail {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}

.link-chip {
  display: flex;
  min-height: 72rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dce4df;
  border-radius: 14rpx;
  background: #ffffff;
  color: #2f4338;
  font-size: 28rpx;
  font-weight: 600;
}

.data-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  gap: 3rpx;
  color: #858b87;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}
.disclaimer { display: block; margin: 9rpx auto 0; color: #747b76; font-size: 26rpx; line-height: 1.55; text-align: center; }

@media (max-width: 340px) {
  .detail-shell { padding-right: 15rpx; padding-left: 15rpx; }
  .detail-hero { margin-right: -15rpx; margin-left: -15rpx; padding: 16rpx 18rpx 38rpx; }
  .hero-title { font-size: 36rpx; }
  .conclusion-grade { font-size: 26rpx; }
  .conclusion-target { font-size: 26rpx; }
  .details-toggle,
  .member-cta { width: calc(100vw - 30rpx) !important; }
  .fact-row,
  .action-row { flex-direction: column; gap: 5rpx; }
  .fact-row text:first-child,
  .action-row text:first-child { width: auto; }
  .fact-row text:last-child,
  .action-row text:last-child { text-align: left; }
}

@media (min-width: 700px) {
  .detail-shell { padding: 24px 32px calc(42px + env(safe-area-inset-bottom)); }
  .detail-hero { margin-right: -32px; margin-left: -32px; padding: 24px 32px 46px; }
  .metric { width: 25%; border-right: 1rpx solid #edf0ee; border-bottom: 0; }
  .metric:last-child { border-right: 0; }
  .column-chart { height: 220px; }
  .details-toggle,
  .member-cta { width: calc(100vw - 64px) !important; }
}

.snapshot-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 28, 24, 0.42);
}

.snapshot-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.snapshot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.snapshot-title {
  color: #1b211d;
  font-size: 32rpx;
  font-weight: 720;
}

.snapshot-close {
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #5f6a64;
  font-size: 26rpx;
}

.snapshot-close::after { border: 0; }

.snapshot-sub {
  display: block;
  margin-top: 12rpx;
  color: #5f6a64;
  font-size: 24rpx;
  line-height: 1.5;
}

.snapshot-preview {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #eef8f2;
}

.snapshot-preview text {
  display: block;
  margin-top: 6rpx;
  color: #1b211d;
  font-size: 25rpx;
  line-height: 1.45;
}

.snapshot-picker,
.snapshot-field-label {
  display: block;
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  color: #5f6a64;
  font-size: 24rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: #f4f6f5;
  color: #314039;
  font-size: 22rpx;
}

.chip::after { border: 0; }

.chip-active {
  background: #0b7a53;
  color: #fff;
}

.snapshot-input {
  display: flex;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 8rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0ee;
  color: #1b211d;
  font-size: 27rpx;
}

.snapshot-input input {
  flex: 1;
  text-align: right;
}

.snapshot-note {
  margin-top: 16rpx;
}

.snapshot-note text {
  display: block;
  margin-bottom: 8rpx;
  color: #5f6a64;
  font-size: 24rpx;
}

.snapshot-note textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f4f6f5;
  font-size: 26rpx;
}

.snapshot-save {
  margin-top: 22rpx;
}

.snapshot-legal {
  display: block;
  margin-top: 14rpx;
  color: #7a8580;
  font-size: 22rpx;
  line-height: 1.45;
}

.primary-button {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: #0b7a53;
  color: #fff;
  font-size: 30rpx;
  font-weight: 680;
  line-height: 88rpx;
}

.primary-button::after { border: 0; }

/* 官方出处区块。沿用新闻资讯页的行式样：名字在左、"复制链接"在右，
   点整行复制。和 .fact-row 用同一套内距和分隔线，混在资料 tab 里不违和。 */
.source-help {
  display: block;
  padding: 0 22rpx 14rpx;
  color: #858c87;
  font-size: 23rpx;
  line-height: 1.55;
}

.source-link-row {
  display: flex;
  min-height: 78rpx;
  padding: 16rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid #edf0ee;
  font-size: 28rpx;
  line-height: 1.55;
}

.source-link-name {
  min-width: 0;
  flex: 1;
  color: #1b211d;
}

.source-link-action {
  flex: none;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 620;
}
