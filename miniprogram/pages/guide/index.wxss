/* 服务引导页（港美股开户 / A股开户 / VPN开通）：适老化大字体、高对比、操作指引一目了然 */

.guide-shell {
  background: #f6f7fa;
}

.guide-head {
  display: flex;
  margin-bottom: 10rpx;
  padding: 24rpx 28rpx 16rpx;
  flex-direction: column;
  gap: 10rpx;
  background: transparent;
}

.guide-title {
  color: #0f172a;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -0.6rpx;
  line-height: 1.28;
}

.guide-lead {
  color: #334155;
  font-size: 29rpx;
  line-height: 1.62;
}

.section-list,
.offer-card {
  margin: 0 24rpx 24rpx;
  border-radius: 28rpx;
}

.sec {
  display: flex;
  padding: 28rpx 26rpx 30rpx;
  flex-direction: column;
  gap: 16rpx;
}

.sec + .sec {
  border-top: 1rpx solid #edf0f4;
}

.sec-title {
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 740;
}

.sec-rows {
  overflow: hidden;
  border-radius: 18rpx;
  background: #f5f8fc;
}

.sec-row {
  display: flex;
  padding: 20rpx 22rpx;
  gap: 20rpx;
}

.sec-row + .sec-row {
  border-top: 1rpx solid #e6ebf2;
}

.row-label {
  width: 190rpx;
  flex: none;
  color: #1e293b;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.55;
}

.row-value {
  min-width: 0;
  flex: 1;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.55;
}

.sec-point {
  position: relative;
  padding-left: 28rpx;
  color: #1e293b;
  font-size: 30rpx;
  line-height: 1.65;
}

.sec-point::before {
  position: absolute;
  top: 20rpx;
  left: 4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1d5fd1;
  content: "";
}

.sec-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.link-row {
  display: flex;
  min-height: 92rpx;
  padding: 0 22rpx;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 16rpx;
}

.link-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-action {
  flex: none;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 末尾操作行动卡：大按钮 + 复制后清晰下一步引导 ---------- */

.offer-card {
  display: flex;
  padding: 32rpx 28rpx 30rpx;
  flex-direction: column;
  gap: 18rpx;
  border: 2rpx solid rgba(29, 95, 209, 0.16);
  background: linear-gradient(180deg, #f7faff 0%, #ffffff 48%);
}

.offer-head {
  color: #0f172a;
  font-size: 36rpx;
  font-weight: 780;
}

.offer-body {
  color: #334155;
  font-size: 30rpx;
  line-height: 1.62;
}

.offer-note {
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
  text-align: center;
}

.offer-qr {
  display: block;
  width: 480rpx;
  max-width: 100%;
  margin: 8rpx auto 4rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe4f0;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.offer-action {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  margin: 6rpx 0 0;
  padding: 0 20rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #2568dc 0%, #1d5fd1 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 720;
  line-height: 1.3;
  box-shadow: 0 8rpx 22rpx rgba(29, 95, 209, 0.24);
  transition: transform 0.12s ease;
}

.offer-action-active {
  transform: scale(0.985);
  background: #174ea9;
}

.copy-step-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid rgba(21, 153, 96, 0.28);
  border-radius: 20rpx;
  background: #effaf4;
}

.copy-step-title {
  color: #0f6e43;
  font-size: 30rpx;
  font-weight: 760;
}

.copy-step-body {
  color: #1e3a2f;
  font-size: 28rpx;
  line-height: 1.6;
}

.offer-disclosure {
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

.tap-active {
  background: #edf2fb;
}

.page-footer {
  display: flex;
  padding: 12rpx 28rpx 0;
  justify-content: center;
  text-align: center;
}

.footer-note {
  max-width: 600rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.58;
}

@media (max-width: 340px) {
  .section-list, .offer-card { margin-left: 14rpx; margin-right: 14rpx; }
  .guide-title { font-size: 40rpx; }
  .row-label { width: 164rpx; font-size: 26rpx; }
  .row-value, .sec-point { font-size: 27rpx; }
}

@media (min-width: 700px) {
  .guide-head { padding-left: 32px; padding-right: 32px; }
  .section-list, .offer-card { margin-left: 32px; margin-right: 32px; }
  .row-label { width: 130px; }
}
