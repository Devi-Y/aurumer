/* 极简渠道页：只放渠道与方式，一屏直达无废话 */

.guide-shell {
  padding-top: 22rpx;
  background: #f3f5f9;
}

.guide-pill-strip {
  display: flex;
  margin: 0 24rpx 18rpx;
  padding: 16rpx 18rpx;
  justify-content: space-between;
  gap: 8rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.guide-step-pill {
  flex: 1;
  padding: 10rpx 6rpx;
  border-radius: 14rpx;
  background: #f4f8ff;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 720;
  text-align: center;
  white-space: nowrap;
}

.guide-compliance-bar {
  display: flex;
  margin: 0 24rpx 18rpx;
  padding: 14rpx 20rpx;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid #fde68a;
  border-radius: 20rpx;
  background: #fffbeb;
}

.guide-compliance-tag {
  flex: none;
  padding: 3rpx 12rpx;
  border-radius: 8rpx;
  background: #fef3c7;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 780;
}

.guide-compliance-text {
  flex: 1;
  min-width: 0;
  color: #78350f;
  font-size: 24rpx;
  line-height: 1.45;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 24rpx 22rpx;
}

.offer-card {
  margin: 0 24rpx 22rpx;
  border-radius: 30rpx;
}

.offer-card {
  display: flex;
  padding: 34rpx 28rpx 30rpx;
  flex-direction: column;
  gap: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.05);
}

.channel-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.channel-badge {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 760;
}

.offer-head {
  color: #0f172a;
  font-size: 38rpx;
  font-weight: 820;
  line-height: 1.3;
}

.offer-way {
  color: #334155;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.5;
}

.offer-note {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 720;
  line-height: 1.5;
  text-align: center;
}

.offer-qr {
  display: block;
  width: 480rpx;
  max-width: 100%;
  margin: 4rpx auto;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #dbe4f0;
  border-radius: 26rpx;
  background: #ffffff;
}

.offer-action {
  display: flex;
  width: 100%;
  min-height: 108rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2568dc 0%, #1d5fd1 100%);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1.3;
  box-shadow: 0 8rpx 22rpx rgba(29, 95, 209, 0.24);
  transition: transform 0.12s ease;
}

.offer-action.is-done {
  background: linear-gradient(135deg, #09c765 0%, #06ad56 100%);
  box-shadow: 0 8rpx 22rpx rgba(7, 193, 96, 0.24);
}

.offer-action-active {
  transform: scale(0.985);
}

.offer-disclosure {
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.sec {
  display: flex;
  padding: 26rpx 26rpx 24rpx;
  flex-direction: column;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.04);
}

.sec-title {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 800;
}

.sec-matrix {
  display: flex;
  flex-direction: column;
  border: 1rpx solid #e5ecf6;
  border-radius: 18rpx;
  overflow: hidden;
}

.sec-matrix-row {
  display: flex;
  padding: 16rpx 18rpx;
  align-items: flex-start;
  gap: 16rpx;
  border-bottom: 1rpx solid #eef2f8;
  background: #ffffff;
}

.sec-matrix-row:nth-child(even) {
  background: #f8fafd;
}

.sec-matrix-row:last-child {
  border-bottom: none;
}

.sec-matrix-k {
  width: 128rpx;
  flex: none;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.45;
}

.sec-matrix-v {
  flex: 1;
  min-width: 0;
  color: #1e293b;
  font-size: 25rpx;
  font-weight: 580;
  line-height: 1.45;
}

.sec-points {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sec-point {
  color: #475569;
  font-size: 25rpx;
  line-height: 1.5;
}

.sec-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.link-row {
  display: flex;
  min-height: 86rpx;
  padding: 0 22rpx;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 16rpx;
}

.link-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-action {
  flex: none;
  color: #1d5fd1;
  font-size: 27rpx;
  font-weight: 700;
}

.tap-active {
  background: #edf2fb;
}

.page-footer {
  display: flex;
  padding: 8rpx 28rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-align: center;
}

.footer-note {
  max-width: 600rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.5;
}

.footer-legal-link {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 660;
}

@media (max-width: 340px) {
  .section-list, .offer-card, .guide-compliance-bar { margin-left: 14rpx; margin-right: 14rpx; }
  .offer-head { font-size: 33rpx; }
  .sec-matrix-k { width: 112rpx; }
}

@media (min-width: 700px) {
  .section-list, .offer-card, .guide-compliance-bar {
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .offer-head { font-size: 22px; }
}
