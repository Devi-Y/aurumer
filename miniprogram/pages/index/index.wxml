<view class="page-shell home-shell">
  <!-- 第一块：今日重点。只放当天的结论矩阵和群卡片，不再挂轮播条。 -->
  <view class="home-hero">
    <view class="hero-top">
      <text class="hero-title">今日重点</text>
      <text class="hero-help">{{todayHelp}}</text>
    </view>
    <view class="hero-matrix">
      <view
        wx:for="{{today.points}}"
        wx:key="id"
        class="hero-cell"
      >
        <text
          class="hero-label"
          data-market="{{item.id}}"
          bindtap="openTodayCategory"
          hover-class="hero-tap"
          aria-role="button"
          aria-label="{{item.ariaCategory}}"
        >{{item.label}}</text>
        <text
          class="hero-value"
          data-market="{{item.id}}"
          data-target="{{item.targetId}}"
          bindtap="openTodayTarget"
          hover-class="hero-tap"
          aria-role="button"
          aria-label="{{item.ariaTarget}}"
        >{{item.value}}</text>
      </view>
    </view>
    <view
      class="daily-card-row"
      bindtap="copyDailyCard"
      hover-class="hero-tap"
      aria-role="button"
      aria-label="复制今日微信群卡片文案"
    >
      <text class="daily-card-title">复制群卡片</text>
      <text class="daily-card-help">今日结论 · 不含买卖建议</text>
      <text class="daily-card-arrow">复制</text>
    </view>
  </view>

  <!-- 第二块：六宫格入口。 -->
  <view class="page-card home-panel">
    <view class="panel-head">
      <text class="panel-title">核心研究</text>
      <text class="panel-meta">{{dataAsOf || '同步中'}}</text>
    </view>
    <view class="entry-grid">
      <view
        wx:for="{{entries}}"
        wx:key="id"
        class="grid-card {{item.tone}}"
        data-id="{{item.id}}"
        bindtap="openGridEntry"
        hover-class="tap-active"
        hover-stay-time="80"
        aria-role="button"
        aria-label="{{item.title}}，{{item.help}}"
      >
        <text wx:if="{{item.badge}}" class="entry-badge">{{item.badge}}</text>
        <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true"></image>
        <text class="card-title">{{item.title}}</text>
        <text class="card-help">{{item.help}}</text>
        <text class="entry-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 第三块：我的持仓分析 + 年费会员。 -->
  <view class="page-card home-panel">
    <view class="panel-head">
      <text class="panel-title">我的持仓</text>
      <text
        class="panel-action"
        bindtap="toggleHoldingForm"
        hover-class="tap-active"
        aria-role="button"
        aria-label="{{showHoldingForm ? '收起添加持仓' : '添加持仓'}}"
      >{{showHoldingForm ? '收起' : '＋ 添加'}}</text>
    </view>
    <view class="holding-reminder {{holdingsReminder.tone}}">{{holdingsReminder.text}}</view>
    <view wx:if="{{holdings.length}}" class="holding-list">
      <view
        wx:for="{{holdings}}"
        wx:key="id"
        class="holding-row"
      >
        <view
          class="holding-main"
          data-id="{{item.id}}"
          bindtap="openHoldingDetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="打开 {{item.name}} 详情"
        >
          <view class="holding-title-row">
            <text class="holding-name">{{item.name}}</text>
            <text class="holding-market">{{item.marketLabel}}</text>
          </view>
          <text class="holding-meta">{{item.displayMeta}}</text>
          <text class="holding-action {{item.actionTone}}">{{item.actionText}}</text>
          <text wx:if="{{item.performanceText}}" class="holding-performance {{item.performanceTone}}">{{item.performanceText}}</text>
        </view>
        <text wx:if="{{item.hasDetail}}" class="arrow">›</text>
        <text
          class="holding-delete"
          data-id="{{item.id}}"
          catchtap="deleteHolding"
          aria-role="button"
          aria-label="删除 {{item.name}}"
        >删除</text>
      </view>
    </view>
    <view wx:else class="holding-empty">
      <text>先添加一只你真正持有的股票。</text>
      <text>持仓只保存在本机，不上传服务器；匹配到公开样本后可点进详情。</text>
    </view>
    <view wx:if="{{showHoldingForm}}" class="holding-form">
      <picker mode="selector" range="{{marketOptions}}" range-key="label" value="{{marketIndex}}" bindchange="changeHoldingMarket">
        <view class="holding-picker" aria-role="button">
          <text>市场</text>
          <text>{{marketOptions[marketIndex].label}} ›</text>
        </view>
      </picker>
      <input class="holding-input" placeholder="名称，如 英伟达 / 黄金" value="{{holdingForm.name}}" bindinput="inputHoldingName" />
      <input class="holding-input" placeholder="代码（黄金可留空）" value="{{holdingForm.code}}" bindinput="inputHoldingCode" />
      <input class="holding-input" type="digit" placeholder="成本（选填）" value="{{holdingForm.cost}}" bindinput="inputHoldingCost" />
      <input class="holding-input" type="digit" placeholder="数量股/克（选填）" value="{{holdingForm.quantity}}" bindinput="inputHoldingQuantity" />
      <view class="holding-form-actions">
        <view class="holding-cancel" bindtap="toggleHoldingForm" hover-class="tap-active" aria-role="button">取消</view>
        <view class="holding-save" bindtap="saveHolding" hover-class="tap-active" aria-role="button">保存到本机</view>
      </view>
    </view>
  </view>

  <view class="page-card home-panel member-panel">
    <view
      class="member-banner"
      bindtap="openMemberBanner"
      hover-class="tap-active"
      aria-role="button"
      aria-label="{{member.title}}，{{member.help}}"
    >
      <image class="member-banner-icon" src="{{member.icon}}" mode="aspectFit" aria-hidden="true"></image>
      <view class="member-banner-copy">
        <text class="member-banner-title">{{member.title}}</text>
        <text class="member-banner-help">{{member.help}}</text>
      </view>
      <text wx:if="{{member.badge}}" class="member-banner-badge">{{member.badge}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="page-footer">
    <text class="footer-note">{{footerDisclaimer}}</text>
  </view>
</view>
