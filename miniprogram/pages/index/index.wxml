<view class="page-shell home-shell">
  <view class="home-main">
    <!-- 顶部一体化搜索与港美A热度代表股（带股票代码，左右边缘与九宫格严丝合缝） -->
    <view class="page-card home-search-wrap">
      <view class="home-search-box {{searchFocused ? 'is-focused' : ''}}">
        <image class="home-search-svg" src="{{searchIconSrc}}" mode="aspectFit" aria-hidden="true"></image>
        <input
          class="home-search-input"
          type="text"
          confirm-type="search"
          value="{{searchQuery}}"
          placeholder="搜索股票名称或代码"
          placeholder-class="home-search-placeholder"
          bindfocus="onSearchFocus"
          bindinput="onSearchInput"
        />
        <text wx:if="{{searchQuery || searchFocused}}" class="home-search-clear" bindtap="clearSearch" aria-role="button" aria-label="清空搜索">清空</text>
      </view>

      <view wx:if="{{searchQuery && searchResults.length}}" class="search-dropdown">
        <view
          wx:for="{{searchResults}}"
          wx:key="key"
          class="search-result-row"
          data-market="{{item.market}}"
          data-id="{{item.id}}"
          bindtap="openSearchResult"
          hover-class="tap-active"
          aria-role="button"
        >
          <text class="search-tag tag-{{item.market}}">{{item.marketTag}}</text>
          <view class="search-result-main">
            <text class="search-result-name">{{item.name}}</text>
            <text wx:if="{{item.code}}" class="search-result-code">{{item.code}}</text>
          </view>
          <text wx:if="{{item.figure}}" class="search-result-fig">{{item.figure}}</text>
          <text class="search-result-go" aria-hidden="true">›</text>
        </view>
      </view>
      <view wx:elif="{{searchQuery && !searchResults.length}}" class="search-dropdown search-empty">
        <text>未找到“{{searchQuery}}”，可换简称或代码试试</text>
      </view>

      <view wx:if="{{hotPicks.length}}" class="search-picks-section">
        <view class="search-picks-grid">
          <view
            wx:for="{{hotPicks}}"
            wx:key="key"
            class="search-pick-card"
            data-market="{{item.market}}"
            data-id="{{item.id}}"
            bindtap="openSearchResult"
            hover-class="tap-active"
            aria-role="button"
            aria-label="热门股票 {{item.label}} {{item.code}} {{item.figure}}"
          >
            <text class="search-pick-name">{{item.label}}</text>
            <view class="pick-code-row">
              <text class="pick-mkt-dot">{{item.marketTag}}</text>
              <text class="search-pick-code">{{item.code}}</text>
            </view>
            <image wx:if="{{item.sparkSrc}}" class="pick-spark" src="{{item.sparkSrc}}" mode="scaleToFill" aria-hidden="true"></image>
            <text wx:if="{{item.figure}}" class="pick-figure">{{item.figure}}</text>
            <view wx:if="{{item.deltaText}}" class="pick-pill-row">
              <text class="pick-delta tone-{{item.deltaTone}}">{{item.deltaText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{starPicks.length}}" class="star-picks-bar">
        <text class="star-picks-label">★ 收藏</text>
        <scroll-view class="star-picks-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false" enhanced="true">
          <view class="star-picks-inner">
            <text
              wx:for="{{starPicks}}"
              wx:key="key"
              class="star-pick-pill"
              data-market="{{item.market}}"
              data-id="{{item.id}}"
              bindtap="openSearchResult"
              aria-role="button"
            >{{item.label}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 方正协调的 3×3 九宫格：统一色系大图标 + 适老化大标题 -->
    <view class="page-card home-panel">
      <view class="entry-grid">
        <block wx:for="{{entries}}" wx:key="id">
        <view
          class="grid-card"
          data-id="{{item.id}}"
          bindtap="openGridEntry"
          hover-class="tap-active"
          hover-stay-time="80"
          aria-role="button"
          aria-label="{{item.help ? item.title + '，' + item.help : item.title}}"
        >
          <view class="entry-icon-chip">
            <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true"></image>
          </view>
          <text class="card-title">{{item.title}}</text>
        </view>
        </block>
      </view>
    </view>
  </view>

  <view class="page-footer" aria-label="{{footerDisclaimer}}{{dataAsOf ? '，' + dataAsOf : ''}}">
    <text class="footer-note">{{footerDisclaimer}}</text>
  </view>
</view>
