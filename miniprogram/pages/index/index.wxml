<view class="page-shell home-shell">
  <!-- 顶部 DeepSeek 极简极速秒搜：零网络等待，直达全市场任意标的详情。 -->
  <view class="home-search-wrap">
    <view class="home-search-box {{searchFocused ? 'is-focused' : ''}}">
      <text class="home-search-icon" aria-hidden="true">⌕</text>
      <input
        class="home-search-input"
        type="text"
        confirm-type="search"
        value="{{searchQuery}}"
        placeholder="搜股票、代码、新股或机构（如 英伟达、长江电力）"
        placeholder-class="home-search-placeholder"
        bindfocus="onSearchFocus"
        bindinput="onSearchInput"
      />
      <text wx:if="{{searchQuery || searchFocused}}" class="home-search-clear" bindtap="clearSearch" aria-role="button" aria-label="清除搜索">取消</text>
    </view>

    <view wx:if="{{searchQuery && searchResults.length}}" class="search-dropdown">
      <view
        wx:for="{{searchResults}}"
        wx:key="key"
        class="search-result-row"
        data-market="{{item.market}}"
        data-id="{{item.id}}"
        bindtap="openSearchResult"
        hover-class="tap-active"
        aria-role="button"
      >
        <text class="search-tag tag-{{item.market}}">{{item.marketTag}}</text>
        <view class="search-result-main">
          <text class="search-result-name">{{item.name}}</text>
          <text wx:if="{{item.code}}" class="search-result-code">{{item.code}}</text>
        </view>
        <text wx:if="{{item.figure}}" class="search-result-fig">{{item.figure}}</text>
        <text class="search-result-go" aria-hidden="true">›</text>
      </view>
    </view>
    <view wx:elif="{{searchQuery && !searchResults.length}}" class="search-dropdown search-empty">
      <text>当前样本库未匹配到“{{searchQuery}}”，可试试代码或中文简称</text>
    </view>
    <view wx:elif="{{searchFocused && (starPicks.length || quickPicks.length)}}" class="search-picks-panel">
      <view wx:if="{{starPicks.length}}" class="search-picks">
        <text class="search-picks-label">★ 星标直达</text>
        <view
          wx:for="{{starPicks}}"
          wx:key="key"
          class="search-pick-chip is-star"
          data-market="{{item.market}}"
          data-id="{{item.id}}"
          bindtap="openSearchResult"
          hover-class="tap-active"
          aria-role="button"
        >{{item.label}}</view>
      </view>
      <view wx:if="{{quickPicks.length}}" class="search-picks">
        <text class="search-picks-label">热门直达</text>
        <view
          wx:for="{{quickPicks}}"
          wx:key="key"
          class="search-pick-chip"
          data-market="{{item.market}}"
          data-id="{{item.id}}"
          bindtap="openSearchResult"
          hover-class="tap-active"
          aria-role="button"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 四大市场走势卡：一卡只说一件事（板块 + 大号核心结果 + 走势图），零多余标签。 -->
  <view class="group-head home-head">
    <text class="group-label">历史走势参考</text>
    <text class="group-meta">{{dataAsOf || '读取历史资料'}}</text>
  </view>
  <view wx:if="{{trends.length}}" class="trend-grid">
    <view
      wx:for="{{trends}}"
      wx:key="id"
      class="trend-card"
      data-market="{{item.market}}"
      data-detail-id="{{item.detailId}}"
      bindtap="openTrend"
      hover-class="tap-active"
      hover-stay-time="80"
      aria-role="button"
      aria-label="打开{{item.title}}，{{item.asOf}}，{{item.value}} {{item.sub}}"
    >
      <view class="trend-heading">
        <text class="trend-title">{{item.title}}</text>
        <text class="trend-arrow" aria-hidden="true">›</text>
      </view>
      <view class="trend-figure">
        <text class="trend-value">{{item.value}}</text>
        <text class="trend-sub {{item.tone}}">{{item.sub}}</text>
      </view>
      <view wx:if="{{item.kind === 'bars'}}" class="trend-bars" aria-hidden="true">
        <view class="trend-zero" style="{{item.zeroStyle}}"></view>
        <view wx:for="{{item.bars}}" wx:for-item="bar" wx:key="key" class="trend-slot">
          <view class="trend-bar {{bar.tone}}" style="{{bar.style}}"></view>
        </view>
      </view>
      <image wx:else class="trend-line" src="{{item.src}}" mode="scaleToFill" aria-hidden="true"></image>
    </view>
  </view>

  <!-- 九格：五个免费研究栏目 + 会员群、港美股开户、A股开户、VPN开通。 -->
  <view class="page-card home-panel">
    <view class="panel-head">
      <text class="group-label">免费决策参考</text>
    </view>
    <view class="entry-grid">
      <block wx:for="{{entries}}" wx:key="id">
      <view
        class="grid-card"
        data-id="{{item.id}}"
        bindtap="openGridEntry"
        hover-class="tap-active"
        hover-stay-time="80"
        aria-role="button"
        aria-label="{{item.help ? item.title + '，' + item.help : item.title}}"
      >
        <view class="entry-icon-chip {{item.id === 'gold' ? 'gold' : ''}} {{item.action === 'page' ? 'svc' : ''}}">
          <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true"></image>
        </view>
        <text class="card-title">{{item.title}}</text>
      </view>
      </block>
    </view>
  </view>

  <view class="page-footer">
    <text class="footer-note">{{footerDisclaimer}}</text>
  </view>
</view>
