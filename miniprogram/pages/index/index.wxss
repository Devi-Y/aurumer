/* 适老化对称协调首页：一体化搜索热度卡 × 方正等比 3×3 九宫格 × 底部免责声明 */

.home-shell {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  justify-content: space-between;
  overflow-x: hidden;
  background: #f3f5f9;
}

.home-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
}

/* ---------- 顶部一体化搜索卡 + 港美A热度代表（含代码，左右严格对齐） ---------- */

.home-search-wrap {
  position: relative;
  z-index: 20;
  flex: none;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.045);
}

.home-search-box {
  display: flex;
  height: 100rpx;
  padding: 0 22rpx 0 26rpx;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #f3f6fb;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.home-search-box.is-focused {
  border-color: #1d5fd1;
  background: #ffffff;
}

.home-search-icon {
  flex: none;
  color: #1d5fd1;
  font-size: 42rpx;
  line-height: 1;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #0f172a;
  font-size: 33rpx;
  font-weight: 600;
}

.home-search-placeholder {
  color: #64748b;
  font-size: 31rpx;
  font-weight: 500;
}

.home-search-clear {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #e8f0fe;
  color: #1d5fd1;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}

.search-dropdown {
  position: absolute;
  top: 132rpx;
  right: 0;
  left: 0;
  z-index: 30;
  overflow: hidden;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.14);
}

.search-result-row {
  display: flex;
  min-height: 100rpx;
  padding: 18rpx 26rpx;
  align-items: center;
  gap: 16rpx;
}

.search-result-row + .search-result-row {
  border-top: 1rpx solid #edf1f7;
}

.search-tag {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #eef3fb;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 720;
}

.search-tag.tag-a { background: #fdf1ef; color: #c2412d; }
.search-tag.tag-gold { background: #fef6e7; color: #9a5b13; }
.search-tag.tag-guru { background: #f3effe; color: #6d28d9; }

.search-result-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.search-result-name {
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-code {
  color: #64748b;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.search-result-fig {
  flex: none;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.search-result-go {
  flex: none;
  color: #94a3b8;
  font-size: 36rpx;
}

.search-empty {
  padding: 34rpx 28rpx;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.55;
  text-align: center;
}

.search-picks-row {
  display: flex;
  margin-top: 16rpx;
  align-items: stretch;
  gap: 12rpx;
}

.search-picks-label {
  display: flex;
  width: 56rpx;
  flex: none;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.25;
  text-align: center;
}

.search-picks-grid {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 12rpx;
}

.search-pick-card {
  display: flex;
  flex: 1;
  min-width: 0;
  padding: 12rpx 10rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 1rpx solid #ebeef5;
  border-radius: 18rpx;
  background: #f7f9fc;
}

.search-pick-name {
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 740;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-pick-code {
  max-width: 100%;
  overflow: hidden;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 620;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 比例方正协调的 3×3 适老化九宫格 ---------- */

.home-panel {
  flex: none;
  padding: 22rpx 12rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.045);
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.grid-card {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-height: 210rpx;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.entry-icon-chip {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(29, 95, 209, 0.10);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #f5f9ff 0%, #eaf2ff 100%);
  box-shadow: 0 6rpx 18rpx rgba(29, 95, 209, 0.07);
  transition: transform 0.12s ease;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 740;
  letter-spacing: 0.2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active {
  background: #eaf1fc;
  transform: scale(0.985);
}

/* ---------- 底部一句话免责声明：沉稳居中 ---------- */

.page-footer {
  display: flex;
  flex: none;
  padding: 20rpx 16rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 640rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .home-shell {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }
  .home-search-box {
    height: 92rpx;
    padding: 0 16rpx 0 20rpx;
  }
  .grid-card {
    min-height: 188rpx;
    padding: 14rpx 6rpx;
    gap: 12rpx;
  }
  .entry-icon-chip {
    width: 98rpx;
    height: 98rpx;
  }
  .entry-icon {
    width: 48rpx;
    height: 48rpx;
  }
  .card-title {
    font-size: 27rpx;
  }
}

@media (min-width: 700px) {
  .home-shell {
    padding-right: 32px;
    padding-left: 32px;
  }
  .entry-icon-chip {
    width: 56px;
    height: 56px;
  }
  .entry-icon {
    width: 28px;
    height: 28px;
  }
}
