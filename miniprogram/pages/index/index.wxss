/* 适老化对称协调首页：一体化搜索热度卡 × 方正等比 3×3 九宫格 × 底部免责声明 */

.home-shell {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  justify-content: space-between;
  overflow-x: hidden;
  background: #f2f5fa;
}

.home-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  gap: 22rpx;
}

/* ---------- 顶部一体化搜索 + 港美A带走势图的热度卡片 ---------- */

.home-search-wrap {
  position: relative;
  z-index: 20;
  flex: none;
  padding: 22rpx 22rpx 22rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.045);
}

.home-search-box {
  display: flex;
  height: 112rpx;
  padding: 0 22rpx 0 26rpx;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #f3f6fb;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}

.home-search-box.is-focused {
  border-color: #1d5fd1;
  background: #ffffff;
}

.home-search-svg {
  flex: none;
  width: 38rpx;
  height: 38rpx;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 600;
}

.home-search-placeholder {
  color: #64748b;
  font-size: 32rpx;
  font-weight: 500;
}

.home-search-clear {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #e8f0fe;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.search-dropdown {
  position: absolute;
  top: 144rpx;
  right: 0;
  left: 0;
  z-index: 30;
  overflow: hidden;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.14);
}

.search-result-row {
  display: flex;
  min-height: 100rpx;
  padding: 18rpx 26rpx;
  align-items: center;
  gap: 16rpx;
}

.search-result-row + .search-result-row {
  border-top: 1rpx solid #edf1f7;
}

.search-tag {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #eef3fb;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 720;
}

.search-tag.tag-a { background: #fdf1ef; color: #c2412d; }
.search-tag.tag-gold { background: #fef6e7; color: #9a5b13; }
.search-tag.tag-guru { background: #f3effe; color: #6d28d9; }

.search-result-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.search-result-name {
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-code {
  color: #64748b;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.search-result-fig {
  flex: none;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.search-result-go {
  flex: none;
  color: #94a3b8;
  font-size: 36rpx;
}

.search-empty {
  padding: 34rpx 28rpx;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.55;
  text-align: center;
}

.search-picks-section {
  display: flex;
  margin-top: 18rpx;
  flex-direction: column;
  gap: 12rpx;
}

.search-picks-head {
  display: flex;
  padding: 0 2rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.search-picks-badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 780;
}

.search-picks-sub {
  color: #94a3b8;
  font-size: 24rpx;
  font-weight: 560;
  font-variant-numeric: tabular-nums;
}

.search-picks-grid {
  display: flex;
  width: 100%;
  gap: 14rpx;
}

.search-pick-card {
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex: 1;
  min-width: 0;
  padding: 16rpx 14rpx 14rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  border: 1rpx solid #e5ecf6;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fafcff 0%, #f4f8fd 100%);
}

.search-pick-name {
  display: block;
  overflow: hidden;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-code-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.pick-mkt-dot {
  flex: none;
  padding: 1rpx 8rpx;
  border-radius: 6rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 740;
  line-height: 1.25;
}

.search-pick-code {
  overflow: hidden;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 660;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-spark {
  display: block;
  width: 100%;
  height: 56rpx;
  margin: 4rpx 0;
}

.pick-figure {
  overflow: hidden;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 820;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.4rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-pill-row {
  display: flex;
  align-items: center;
  margin-top: 2rpx;
}

.pick-delta {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 740;
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-delta.tone-up { background: #fdf1ef; color: #c2412d; }
.pick-delta.tone-down { background: #ebfaf2; color: #0d8a52; }
.pick-delta.tone-info { background: #eaf2ff; color: #1d5fd1; }

.star-picks-bar {
  display: flex;
  margin-top: 14rpx;
  padding-top: 12rpx;
  align-items: center;
  gap: 12rpx;
  border-top: 1rpx solid #eef2f8;
}

.star-picks-label {
  flex: none;
  color: #b45309;
  font-size: 25rpx;
  font-weight: 760;
}

.star-picks-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.star-picks-inner {
  display: inline-flex;
  gap: 10rpx;
}

.star-pick-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fef7ea;
  color: #92400e;
  font-size: 25rpx;
  font-weight: 680;
}

/* ---------- 撑满主屏黄金比例的 3×3 适老化九宫格 ---------- */

.home-panel {
  display: flex;
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.045);
}

.entry-grid {
  display: flex;
  width: 100%;
  flex: 1;
  flex-wrap: wrap;
  align-content: space-evenly;
}

.grid-card {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-height: 210rpx;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 14rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.entry-icon-chip {
  display: flex;
  width: 120rpx;
  height: 120rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(29, 95, 209, 0.10);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #f5f9ff 0%, #eaf2ff 100%);
  box-shadow: 0 6rpx 18rpx rgba(29, 95, 209, 0.07);
  transition: transform 0.12s ease;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 740;
  letter-spacing: 0.2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active {
  background: #eaf1fc;
  transform: scale(0.985);
}

/* ---------- 底部一句话免责声明：沉稳居中 ---------- */

.page-footer {
  display: flex;
  flex: none;
  padding: 20rpx 16rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 640rpx;
  color: #64748b;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.5;
}

@media (max-width: 340px) {
  .home-shell {
    padding-right: 16rpx;
    padding-left: 16rpx;
  }
  .home-search-box {
    height: 92rpx;
    padding: 0 16rpx 0 20rpx;
  }
  .grid-card {
    min-height: 188rpx;
    padding: 14rpx 6rpx;
    gap: 12rpx;
  }
  .entry-icon-chip {
    width: 98rpx;
    height: 98rpx;
  }
  .entry-icon {
    width: 48rpx;
    height: 48rpx;
  }
  .card-title {
    font-size: 27rpx;
  }
  .search-picks-grid {
    gap: 8rpx;
  }
  .search-pick-card {
    padding: 12rpx 8rpx 10rpx;
  }
  .pick-fig-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 4rpx;
  }
}

@media (min-width: 540px) {
  .home-main,
  .page-footer {
    width: 100%;
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
  }
  .home-search-box { height: 56px; padding: 0 16px 0 18px; border-radius: 14px; }
  .home-search-input { height: 52px; font-size: 17px; }
  .home-search-placeholder { font-size: 16px; }
  .pick-spark, .pick-spark-placeholder { height: 32px; }
  .grid-card { min-height: 124px; gap: 10px; padding: 12px 8px; }
  .entry-icon-chip { width: 58px; height: 58px; border-radius: 16px; }
  .entry-icon { width: 28px; height: 28px; }
  .card-title { font-size: 16px; }
}

@media (min-width: 700px) {
  .home-shell {
    padding: 20px 32px calc(24px + env(safe-area-inset-bottom));
  }
  .home-main,
  .page-footer {
    width: 100%;
    max-width: 860px;
    margin-right: auto;
    margin-left: auto;
    gap: 16px;
  }
  .home-search-wrap,
  .home-panel {
    padding: 18px 20px;
    border-radius: 22px;
  }
  .home-search-box { height: 54px; padding: 0 16px 0 18px; border-radius: 14px; }
  .home-search-svg { width: 20px; height: 20px; }
  .home-search-input { height: 50px; font-size: 17px; }
  .home-search-placeholder { font-size: 16px; }
  .home-search-clear { padding: 6px 14px; font-size: 14px; border-radius: 10px; }
  .search-dropdown { top: 82px; border-radius: 16px; }
  .search-result-row { min-height: 52px; padding: 10px 16px; }
  .search-result-name { font-size: 16px; }
  .search-result-code, .search-tag { font-size: 13px; }
  .search-result-fig { font-size: 15px; }
  .search-picks-badge, .search-picks-sub, .star-picks-label, .star-pick-pill { font-size: 13px; }
  .search-picks-grid { gap: 12px; }
  .search-pick-card { padding: 12px 14px; border-radius: 14px; }
  .search-pick-name, .pick-figure { font-size: 16px; }
  .search-pick-code, .pick-mkt-dot, .pick-delta, .pick-ipo-tag { font-size: 12px; }
  .pick-spark, .pick-spark-placeholder { height: 34px; }
  .grid-card { min-height: 128px; gap: 10px; padding: 14px 10px; border-radius: 14px; }
  .entry-icon-chip { width: 58px; height: 58px; border-radius: 16px; }
  .entry-icon { width: 28px; height: 28px; }
  .card-title { font-size: 16px; }
  .footer-note { max-width: 640px; font-size: 13px; }
}
