.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f3f6f4;
}

.home-hero {
  padding: 24rpx 24rpx 52rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.hero-title {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 740;
}

.hero-help {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 28rpx;
  font-weight: 560;
  line-height: 1.45;
}

.hero-matrix {
  display: flex;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-cell {
  box-sizing: border-box;
  display: flex;
  width: 25%;
  min-width: 0;
  min-height: 128rpx;
  flex: 0 0 25%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 6rpx;
  text-align: center;
}

.hero-cell + .hero-cell {
  border-left: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-label {
  overflow: hidden;
  max-width: 100%;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1.15;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-value {
  overflow: hidden;
  max-width: 100%;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  font-weight: 640;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-tap {
  background: rgba(255, 255, 255, 0.14);
}

.home-panel {
  position: relative;
  z-index: 1;
  margin: -36rpx 20rpx 0;
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.panel-head {
  display: flex;
  min-height: 88rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.panel-title {
  color: #1b211d;
  font-size: 32rpx;
  font-weight: 700;
}

.panel-meta {
  overflow: hidden;
  max-width: 52%;
  color: #7a847e;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.grid-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  min-height: 210rpx;
  padding: 22rpx 8rpx 18rpx;
  flex: 0 0 33.333333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #ffffff;
  text-align: center;
}

.grid-card:nth-child(3n) { border-right: 0; }
.grid-card:nth-child(n + 4) { border-bottom: 0; }

.entry-icon {
  width: 64rpx;
  height: 64rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  color: #181d1a;
  font-size: 28rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-help {
  display: block;
  max-width: 92%;
  margin-top: 8rpx;
  color: #7a847e;
  font-size: 22rpx;
  font-weight: 520;
  line-height: 1.35;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 9rpx;
  border-radius: 0 22rpx 0 13rpx;
  background: #eef5f1;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 620;
}

.tap-active {
  background: #eef8f2;
}

.page-footer {
  display: flex;
  padding: 28rpx 28rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 560rpx;
  color: #9aa19c;
  font-size: 24rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .home-hero { padding-right: 18rpx; padding-left: 18rpx; }
  .home-panel { margin-right: 14rpx; margin-left: 14rpx; }
  .hero-title { font-size: 40rpx; }
  .hero-cell { min-height: 118rpx; padding: 14rpx 4rpx; gap: 8rpx; }
  .hero-label { font-size: 30rpx; }
  .hero-value { font-size: 22rpx; }
  .grid-card { min-height: 174rpx; }
  .entry-icon { width: 58rpx; height: 58rpx; }
  .card-title { font-size: 26rpx; }
}

@media (min-width: 700px) {
  .home-hero { padding-right: 32px; padding-left: 32px; }
  .home-panel { margin-right: 32px; margin-left: 32px; }
  .grid-card { min-height: 170px; }
  .entry-icon { width: 54px; height: 54px; }
}
