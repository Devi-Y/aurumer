/* 适老化全屏协调首页：大字大搜索框 × 港美A热度推荐 × 撑满主体的大字九宫格 × 底部免责声明 */

.home-shell {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 26rpx 0 calc(26rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  justify-content: space-between;
  overflow-x: hidden;
  background: linear-gradient(180deg, #eff4fc 0%, #f5f7fb 46%, #f4f6fa 100%);
}

/* ---------- 适老化大号搜索框 + 港美A热度推荐 ---------- */

.home-search-wrap {
  position: relative;
  z-index: 20;
  flex: none;
  margin: 0 24rpx;
}

.home-search-box {
  display: flex;
  height: 118rpx;
  padding: 0 20rpx 0 32rpx;
  align-items: center;
  gap: 16rpx;
  border: 3rpx solid rgba(29, 95, 209, 0.22);
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(29, 95, 209, 0.08), 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.home-search-box.is-focused {
  border-color: #1d5fd1;
  box-shadow: 0 14rpx 38rpx rgba(29, 95, 209, 0.16);
}

.home-search-icon {
  flex: none;
  color: #1d5fd1;
  font-size: 46rpx;
  line-height: 1;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 600;
}

.home-search-placeholder {
  color: #64748b;
  font-size: 31rpx;
  font-weight: 500;
}

.home-search-hint-btn {
  flex: none;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  background: #1d5fd1;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.2;
}

.home-search-clear {
  flex: none;
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  background: #eef4ff;
  color: #1d5fd1;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.2;
}

.search-dropdown {
  position: absolute;
  top: 130rpx;
  right: 0;
  left: 0;
  z-index: 30;
  overflow: hidden;
  border: 2rpx solid rgba(15, 23, 42, 0.09);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(15, 23, 42, 0.14);
}

.search-result-row {
  display: flex;
  min-height: 102rpx;
  padding: 18rpx 26rpx;
  align-items: center;
  gap: 16rpx;
}

.search-result-row + .search-result-row {
  border-top: 1rpx solid #edf1f7;
}

.search-tag {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: #eef3fb;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 720;
}

.search-tag.tag-a { background: #fdf1ef; color: #c2412d; }
.search-tag.tag-gold { background: #fef6e7; color: #9a5b13; }
.search-tag.tag-guru { background: #f3effe; color: #6d28d9; }

.search-result-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}

.search-result-name {
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-code {
  color: #64748b;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.search-result-fig {
  flex: none;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 720;
  font-variant-numeric: tabular-nums;
}

.search-result-go {
  flex: none;
  color: #94a3b8;
  font-size: 36rpx;
}

.search-empty {
  padding: 34rpx 28rpx;
  color: #334155;
  font-size: 29rpx;
  line-height: 1.55;
  text-align: center;
}

.search-picks-inline {
  display: flex;
  margin-top: 22rpx;
  padding: 4rpx 2rpx;
  align-items: center;
  gap: 14rpx;
  overflow-x: auto;
}

.search-picks-inline::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.search-picks-label {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(220, 76, 62, 0.12);
  color: #cf3b2d;
  font-size: 26rpx;
  font-weight: 760;
}

.search-pick-chip {
  flex: none;
  padding: 14rpx 26rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 680;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

/* ---------- 铺满主体空间的适老化大字九宫格 ---------- */

.home-panel {
  display: flex;
  flex: 1;
  margin: 26rpx 24rpx 22rpx;
  padding: 20rpx 10rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(15, 23, 42, 0.055);
}

.entry-grid {
  display: flex;
  width: 100%;
  flex: 1;
  flex-wrap: wrap;
  align-content: space-around;
  padding: 6rpx 0;
}

.grid-card {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-height: 244rpx;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 24rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.entry-icon-chip {
  display: flex;
  width: 128rpx;
  height: 128rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(29, 95, 209, 0.12);
  border-radius: 36rpx;
  background: linear-gradient(145deg, #f3f8ff 0%, #e3eeff 100%);
  box-shadow: 0 10rpx 24rpx rgba(29, 95, 209, 0.09);
  transition: transform 0.12s ease;
}

.entry-icon-chip.gold {
  border-color: rgba(180, 130, 30, 0.2);
  background: linear-gradient(145deg, #fcfaf3 0%, #f5ebd2 100%);
  box-shadow: 0 10rpx 24rpx rgba(180, 130, 30, 0.1);
}

.entry-icon-chip.svc {
  border-color: rgba(15, 23, 42, 0.08);
  background: linear-gradient(145deg, #f8f9fc 0%, #edf1f7 100%);
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.04);
}

.entry-icon {
  width: 62rpx;
  height: 62rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 740;
  letter-spacing: 0.2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active {
  background: #eaf1fc;
  transform: scale(0.985);
}

/* ---------- 底部一句话免责声明：字号清晰、沉稳收尾 ---------- */

.page-footer {
  display: flex;
  flex: none;
  padding: 6rpx 32rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 640rpx;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .home-search-wrap, .home-panel {
    margin-right: 14rpx;
    margin-left: 14rpx;
  }
  .home-search-box {
    height: 104rpx;
    padding: 0 16rpx 0 24rpx;
  }
  .grid-card {
    min-height: 204rpx;
    padding: 16rpx 6rpx;
    gap: 14rpx;
  }
  .entry-icon-chip {
    width: 100rpx;
    height: 100rpx;
  }
  .entry-icon {
    width: 50rpx;
    height: 50rpx;
  }
  .card-title {
    font-size: 27rpx;
  }
}

@media (min-width: 700px) {
  .home-search-wrap, .home-panel {
    margin-right: 32px;
    margin-left: 32px;
  }
  .entry-icon-chip {
    width: 56px;
    height: 56px;
  }
  .entry-icon {
    width: 28px;
    height: 28px;
  }
}
