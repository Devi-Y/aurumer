/* 首页极简协调体系：大搜索框（含港美A热度推荐）× 无标题纯白九宫格 × 底部一句话免责声明 */

.home-shell {
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  flex-direction: column;
  overflow-x: hidden;
  background: linear-gradient(180deg, #f1f5fc 0%, #f6f8fb 44%, #f5f7fa 100%);
}

.home-top-spacer {
  flex: 0.72 0 40rpx;
  max-height: 104rpx;
}

.home-mid-spacer {
  flex: 0.42 0 34rpx;
  max-height: 64rpx;
}

/* ---------- 放大版饱满搜索框 + 港美A热度推荐 ---------- */

.home-search-wrap {
  position: relative;
  z-index: 20;
  margin: 0 28rpx;
}

.home-search-box {
  display: flex;
  height: 112rpx;
  padding: 0 34rpx;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid rgba(29, 95, 209, 0.14);
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(29, 95, 209, 0.07), 0 2rpx 8rpx rgba(15, 23, 42, 0.03);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.home-search-box.is-focused {
  border-color: #1d5fd1;
  box-shadow: 0 14rpx 38rpx rgba(29, 95, 209, 0.14);
}

.home-search-icon {
  flex: none;
  color: #1d5fd1;
  font-size: 42rpx;
  line-height: 1;
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 500;
}

.home-search-placeholder {
  color: #94a3b8;
  font-size: 28rpx;
  font-weight: 400;
}

.home-search-clear {
  flex: none;
  padding: 8rpx 12rpx;
  color: #1d5fd1;
  font-size: 26rpx;
  font-weight: 600;
}

.search-dropdown {
  position: absolute;
  top: 124rpx;
  right: 0;
  left: 0;
  z-index: 30;
  overflow: hidden;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(15, 23, 42, 0.12);
}

.search-result-row {
  display: flex;
  min-height: 88rpx;
  padding: 14rpx 24rpx;
  align-items: center;
  gap: 14rpx;
}

.search-result-row + .search-result-row {
  border-top: 1rpx solid #f1f4f8;
}

.search-tag {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #eef3fb;
  color: #1d5fd1;
  font-size: 20rpx;
  font-weight: 700;
}

.search-tag.tag-a { background: #fdf1ef; color: #c2412d; }
.search-tag.tag-gold { background: #fef6e7; color: #9a5b13; }
.search-tag.tag-guru { background: #f3effe; color: #6d28d9; }

.search-result-main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.search-result-name {
  overflow: hidden;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.search-result-code {
  color: #94a3b8;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.search-result-fig {
  flex: none;
  color: #334155;
  font-size: 25rpx;
  font-weight: 680;
  font-variant-numeric: tabular-nums;
}

.search-result-go {
  flex: none;
  color: #cbd5e1;
  font-size: 30rpx;
}

.search-empty {
  padding: 28rpx 24rpx;
  color: #64748b;
  font-size: 25rpx;
  text-align: center;
}

.search-picks-inline {
  display: flex;
  margin-top: 22rpx;
  padding: 2rpx 4rpx;
  align-items: center;
  gap: 12rpx;
  overflow-x: auto;
}

.search-picks-inline::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

.search-picks-label {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(220, 76, 62, 0.1);
  color: #d9483b;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
}

.search-pick-chip {
  flex: none;
  padding: 10rpx 22rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 999rpx;
  background: #ffffff;
  color: #1e293b;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.025);
}

/* ---------- 九宫格主面板 ---------- */

.home-panel {
  margin: 0 28rpx;
  padding: 24rpx 10rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(15, 23, 42, 0.05);
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.grid-card {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-height: 210rpx;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 24rpx 10rpx;
  border-radius: 16rpx;
  text-align: center;
}

.entry-icon-chip {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(29, 95, 209, 0.1);
  border-radius: 34rpx;
  background: linear-gradient(145deg, #f4f8ff 0%, #e6eeff 100%);
  box-shadow: 0 8rpx 20rpx rgba(29, 95, 209, 0.08);
  transition: transform 0.12s ease;
}

.entry-icon-chip.gold {
  border-color: rgba(180, 130, 30, 0.16);
  background: linear-gradient(145deg, #fcfaf3 0%, #f5ebd2 100%);
  box-shadow: 0 8rpx 20rpx rgba(180, 130, 30, 0.09);
}

.entry-icon-chip.svc {
  border-color: rgba(15, 23, 42, 0.06);
  background: linear-gradient(145deg, #f8f9fc 0%, #eff2f7 100%);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #0f172a;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active {
  background: #edf2fb;
  transform: scale(0.985);
}

/* ---------- 底部一句话免责声明：沉底协调对齐 ---------- */

.page-footer {
  display: flex;
  margin-top: auto;
  padding: 36rpx 32rpx 4rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 560rpx;
  color: #94a3b8;
  font-size: 23rpx;
  line-height: 1.55;
  letter-spacing: 0.3rpx;
}

@media (max-width: 340px) {
  .home-search-wrap, .home-panel {
    margin-right: 16rpx;
    margin-left: 16rpx;
  }
  .home-search-box {
    height: 98rpx;
    padding: 0 26rpx;
  }
  .grid-card {
    min-height: 184rpx;
    padding: 16rpx 6rpx;
    gap: 12rpx;
  }
  .entry-icon-chip {
    width: 92rpx;
    height: 92rpx;
  }
  .entry-icon {
    width: 46rpx;
    height: 46rpx;
  }
  .card-title {
    font-size: 24rpx;
  }
}

@media (min-width: 700px) {
  .home-search-wrap, .home-panel {
    margin-right: 32px;
    margin-left: 32px;
  }
  .entry-icon-chip {
    width: 52px;
    height: 52px;
  }
  .entry-icon {
    width: 26px;
    height: 26px;
  }
}
