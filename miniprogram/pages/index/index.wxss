.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f5f7f6;
}

.home-hero {
  padding: 16rpx 24rpx 28rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  flex: none;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 740;
}

.hero-help {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 520;
  line-height: 1.3;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-matrix {
  display: flex;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-cell {
  box-sizing: border-box;
  display: flex;
  width: 25%;
  min-width: 0;
  min-height: 128rpx;
  flex: 0 0 25%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 6rpx;
  text-align: center;
}

.hero-cell + .hero-cell {
  border-left: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-label,
.hero-value {
  display: block;
  overflow: hidden;
  max-width: 100%;
  padding: 4rpx 6rpx;
  border-radius: 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.2;
}

.hero-value {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.hero-tap {
  background: rgba(255, 255, 255, 0.18);
}

.daily-card-row {
  display: flex;
  margin-top: 12rpx;
  min-height: 72rpx;
  padding: 12rpx 16rpx;
  align-items: center;
  gap: 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
}

.daily-card-title {
  flex: none;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.daily-card-help {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-card-arrow {
  flex: none;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.home-panel {
  position: relative;
  z-index: 1;
  margin: -24rpx 20rpx 0;
}

.home-panel + .home-panel {
  margin-top: 16rpx;
}

.panel-head {
  display: flex;
  min-height: 88rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.panel-title {
  color: #1b211d;
  font-size: 32rpx;
  font-weight: 700;
}

.panel-meta,
.panel-action {
  overflow: hidden;
  max-width: 52%;
  color: #7a847e;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-action {
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 620;
}

.holding-reminder {
  padding: 16rpx 24rpx;
  color: #5a6d62;
  font-size: 24rpx;
  line-height: 1.45;
  background: #f7faf8;
  border-bottom: 1rpx solid #edf0ee;
}

.holding-reminder.risk {
  color: #9a4a1b;
  background: #fff7f0;
}

.holding-reminder.good {
  color: #0b7a53;
  background: #f1faf5;
}

.holding-list,
.holding-empty,
.holding-form {
  padding: 4rpx 0;
}

.holding-empty {
  padding: 22rpx 24rpx 28rpx;
}

.holding-empty text {
  display: block;
}

.holding-empty text:first-child {
  color: #1f2621;
  font-size: 28rpx;
  font-weight: 600;
}

.holding-empty text:last-child {
  margin-top: 8rpx;
  color: #858c87;
  font-size: 23rpx;
  line-height: 1.5;
}

.holding-row {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  padding: 18rpx 16rpx 18rpx 24rpx;
}

.holding-row + .holding-row {
  border-top: 1rpx solid #edf0ee;
}

.holding-main {
  min-width: 0;
  flex: 1;
  padding: 4rpx 8rpx 4rpx 0;
  border-radius: 12rpx;
}

.holding-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.holding-name {
  overflow: hidden;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.holding-market {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eef5f1;
  color: #0b7a53;
  font-size: 20rpx;
  font-weight: 600;
}

.holding-meta {
  display: block;
  margin-top: 6rpx;
  color: #858c87;
  font-size: 22rpx;
  line-height: 1.4;
}

.holding-action {
  display: block;
  margin-top: 8rpx;
  color: #5a6d62;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.4;
}

.holding-action.good { color: #0b7a53; }
.holding-action.risk { color: #b45309; }
.holding-action.wait { color: #5a6d62; }

.holding-performance {
  display: block;
  margin-top: 6rpx;
  color: #858c87;
  font-size: 21rpx;
  line-height: 1.4;
}

.holding-performance.up { color: #0b7a53; }
.holding-performance.down { color: #b45309; }

.holding-delete {
  flex: none;
  align-self: center;
  padding: 16rpx 12rpx;
  color: #9aa19c;
  font-size: 22rpx;
}

.holding-form {
  padding: 8rpx 24rpx 24rpx;
  border-top: 1rpx solid #edf0ee;
}

.holding-picker,
.holding-input {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 76rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #e7ece9;
  border-radius: 16rpx;
  background: #f8faf9;
  color: #1b211d;
  font-size: 26rpx;
}

.holding-input {
  justify-content: flex-start;
}

.holding-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.holding-cancel,
.holding-save {
  flex: 1;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 620;
}

.holding-cancel {
  background: #eef1ef;
  color: #5a6d62;
}

.holding-save {
  background: #0b7a53;
  color: #ffffff;
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.grid-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-width: 0;
  min-height: 200rpx;
  /* 底部 30rpx 是给绝对定位的 .entry-arrow 留的专用带：
     说明文字放开成两行后，若沿用 14rpx，第二行会压到箭头上。 */
  padding: 18rpx 12rpx 30rpx;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #ffffff;
  text-align: center;
}

/* 六个入口排成 3 列 × 2 行：每行最后一格不画右边线，
   第二行（第 4 格起）不画下边线，否则会在卡片底边上方多出一条横线。 */
.grid-card:nth-child(3n) { border-right: 0; }
.grid-card:nth-child(n + 4) { border-bottom: 0; }

.entry-icon {
  width: 64rpx;
  height: 64rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  color: #181d1a;
  font-size: 28rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-help {
  display: -webkit-box;
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #7a847e;
  font-size: 22rpx;
  font-weight: 520;
  line-height: 1.3;
  white-space: normal;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 9rpx;
  border-radius: 0 22rpx 0 13rpx;
  background: #eef5f1;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 620;
}

.entry-arrow {
  position: absolute;
  right: 10rpx;
  bottom: 4rpx;
  color: #c3c9c5;
  font-size: 24rpx;
  font-weight: 300;
  line-height: 1;
}

.member-banner {
  display: flex;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  align-items: center;
  gap: 14rpx;
  background: #ffffff;
}

.member-banner-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.member-banner-copy {
  min-width: 0;
  flex: 1;
}

.member-banner-title,
.member-banner-help {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-banner-title {
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 650;
}

.member-banner-help {
  margin-top: 4rpx;
  color: #7a847e;
  font-size: 22rpx;
}

.member-banner-badge {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef5f1;
  color: #0b7a53;
  font-size: 21rpx;
  font-weight: 620;
}

.tap-active {
  background: #eef8f2;
}

.page-footer {
  display: flex;
  padding: 18rpx 28rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 560rpx;
  color: #9aa19c;
  font-size: 24rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .home-hero { padding: 12rpx 16rpx 22rpx; }
  .home-panel { margin-left: 12rpx; margin-right: 12rpx; }
  .home-panel + .home-panel { margin-top: 12rpx; }
  .hero-title { font-size: 38rpx; }
  .hero-cell { min-height: 108rpx; padding: 12rpx 4rpx; gap: 6rpx; }
  .hero-label { font-size: 20rpx; }
  .hero-value { font-size: 28rpx; }
  .grid-card { min-height: 176rpx; padding: 14rpx 8rpx 26rpx; }
  .entry-icon { width: 52rpx; height: 52rpx; }
  .card-title { font-size: 24rpx; margin-top: 10rpx; }
  .card-help { font-size: 20rpx; }
  .page-footer { padding-top: 12rpx; }
}

@media (min-width: 700px) {
  .home-hero { padding-right: 32px; padding-left: 32px; }
  .home-panel { margin-right: 32px; margin-left: 32px; }
  .grid-card { min-height: 170px; }
  .entry-icon { width: 54px; height: 54px; }
}
