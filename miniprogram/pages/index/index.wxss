.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f5f7f6;
}

.today-card,
.today-detail-panel,
.entry-grid,
.workspace-strip {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.today-card {
  padding: 26rpx 24rpx 0;
  border-color: #dceee4;
  background: linear-gradient(145deg, #f3fbf7 0%, #ffffff 72%);
}

.today-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.today-title-wrap {
  min-width: 0;
  flex: 1;
}

.today-title {
  display: block;
  color: #152019;
  font-size: 32rpx;
  font-weight: 700;
}

.today-help {
  display: block;
  margin-top: 4rpx;
  color: #7a847e;
  font-size: 22rpx;
}

.today-time {
  color: #8a928d;
  font-size: 22rpx;
}

.today-headline {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 18rpx;
  color: #1d2a22;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.today-metrics {
  display: flex;
  margin: 0;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #edf0ee;
  border-radius: 0;
  background: #f7faf8;
}

.today-metric {
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  padding: 0 10rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.today-metric + .today-metric {
  border-left: 1rpx solid #e2e8e4;
}

.today-metric text:first-child {
  color: #7b867f;
  font-size: 22rpx;
}

.today-metric text:last-child {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #0b7a53;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-toggle {
  display: flex;
  min-height: 68rpx;
  margin-top: 8rpx;
  align-items: center;
  justify-content: space-between;
  color: #5a6d62;
  font-size: 24rpx;
  font-weight: 600;
}

.today-detail-panel {
  margin-top: 14rpx;
}

.today-point {
  display: flex;
  min-height: 92rpx;
  padding: 15rpx 20rpx;
  align-items: center;
  gap: 16rpx;
}

.today-point + .today-point {
  border-top: 1rpx solid #edf0ee;
}

.point-label {
  width: 70rpx;
  flex: none;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 650;
}

.point-copy {
  min-width: 0;
  flex: 1;
}

.point-copy text {
  display: block;
}

.point-copy text:first-child {
  color: #242b27;
  font-size: 26rpx;
  font-weight: 560;
  line-height: 1.45;
}

.point-copy text:last-child {
  margin-top: 2rpx;
  color: #858c87;
  font-size: 22rpx;
}

.section-label {
  display: block;
  padding: 28rpx 4rpx 15rpx;
  color: #3a433d;
  font-size: 28rpx;
  font-weight: 650;
}

.holdings-panel {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.holding-empty,
.holding-row,
.holding-form {
  padding: 18rpx 20rpx;
}

.holding-empty text,
.holding-meta {
  display: block;
}

.holding-empty text:first-child {
  color: #2a322c;
  font-size: 27rpx;
  font-weight: 560;
}

.holding-empty text:last-child {
  margin-top: 6rpx;
  color: #858c87;
  font-size: 23rpx;
  line-height: 1.5;
}

.holding-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.holding-row + .holding-row {
  border-top: 1rpx solid #edf0ee;
}

.holding-main {
  min-width: 0;
  flex: 1;
}

.holding-name {
  display: block;
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 600;
}

.holding-meta {
  margin-top: 4rpx;
  color: #858c87;
  font-size: 22rpx;
}

.holding-delete {
  flex: none;
  color: #7a6560;
  font-size: 24rpx;
  padding: 10rpx 4rpx;
}

.holding-add {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #edf0ee;
  color: #0b7a53;
  font-size: 27rpx;
  font-weight: 600;
}

.holding-form {
  border-top: 1rpx solid #edf0ee;
}

.holding-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #1b211d;
  font-size: 27rpx;
}

.holding-form-actions {
  display: flex;
  margin-top: 14rpx;
  gap: 12rpx;
}

.holding-cancel,
.holding-save {
  display: flex;
  min-height: 76rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.holding-cancel {
  background: #eef1ef;
  color: #4a554e;
}

.holding-save {
  background: #0b7a53;
  color: #ffffff;
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.grid-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  min-height: 188rpx;
  padding: 25rpx 8rpx 21rpx;
  flex: 0 0 33.333333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #ffffff;
  text-align: center;
}

.grid-card:nth-child(3n) { border-right: 0; }
.grid-card:nth-child(n + 4) { border-bottom: 0; }

.entry-icon {
  width: 64rpx;
  height: 64rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  color: #181d1a;
  font-size: 27rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 9rpx;
  border-radius: 0 22rpx 0 13rpx;
  background: #eef5f1;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 620;
}

.workspace-strip {
  display: flex;
  min-height: 96rpx;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  align-items: center;
  gap: 16rpx;
}

.workspace-icon-wrap {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #eaf3ee;
}

.workspace-icon-wrap image {
  width: 38rpx;
  height: 38rpx;
}

.workspace-title {
  min-width: 0;
  flex: 1;
  color: #202622;
  font-size: 28rpx;
  font-weight: 620;
}

.arrow {
  flex: none;
  color: #aab1ac;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active {
  background: #eef8f2;
}

.page-footer {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.page-footer .is-stale {
  color: #8a6a3d;
  font-weight: 600;
}

@media (max-width: 340px) {
  .home-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .today-card { padding-right: 20rpx; padding-left: 20rpx; }
  .today-headline { font-size: 29rpx; }
  .today-metric text:last-child { font-size: 27rpx; }
  .grid-card { min-height: 174rpx; }
  .entry-icon { width: 58rpx; height: 58rpx; }
  .card-title { font-size: 26rpx; }
}

@media (min-width: 700px) {
  .home-shell { padding-right: 32px; padding-left: 32px; }
  .today-card { padding-right: 34px; padding-left: 34px; }
  .grid-card { min-height: 170px; }
  .entry-icon { width: 54px; height: 54px; }
}
