.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f5f7f6;
}

.today-card,
.today-detail-panel,
.entry-grid,
.workspace-strip {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.today-card {
  padding: 26rpx 24rpx 0;
  border-color: #dceee4;
  background: linear-gradient(145deg, #f3fbf7 0%, #ffffff 72%);
}

.today-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.today-title {
  color: #152019;
  font-size: 34rpx;
  font-weight: 850;
}

.today-time {
  color: #8a928d;
  font-size: 22rpx;
}

.today-headline {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 18rpx;
  color: #1d2a22;
  font-size: 31rpx;
  font-weight: 760;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.today-metrics {
  display: flex;
  margin-top: 22rpx;
  padding: 17rpx 0;
  border-radius: 18rpx;
  background: #eef7f2;
}

.today-metric {
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  padding: 0 10rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.today-metric + .today-metric {
  border-left: 1rpx solid #d8e8df;
}

.today-metric text:first-child {
  color: #7b867f;
  font-size: 22rpx;
}

.today-metric text:last-child {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #08784c;
  font-size: 29rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-toggle {
  display: flex;
  min-height: 68rpx;
  margin-top: 8rpx;
  align-items: center;
  justify-content: space-between;
  color: #4e6759;
  font-size: 23rpx;
  font-weight: 680;
}

.today-detail-panel {
  margin-top: 14rpx;
}

.today-point {
  display: flex;
  min-height: 92rpx;
  padding: 15rpx 20rpx;
  align-items: center;
  gap: 16rpx;
}

.today-point + .today-point {
  border-top: 1rpx solid #edf0ee;
}

.point-label {
  width: 70rpx;
  flex: none;
  color: #078d4b;
  font-size: 24rpx;
  font-weight: 800;
}

.point-copy {
  min-width: 0;
  flex: 1;
}

.point-copy text {
  display: block;
}

.point-copy text:first-child {
  color: #242b27;
  font-size: 26rpx;
  font-weight: 680;
  line-height: 1.45;
}

.point-copy text:last-child {
  margin-top: 2rpx;
  color: #858c87;
  font-size: 22rpx;
}

.section-label {
  display: block;
  padding: 28rpx 4rpx 15rpx;
  color: #252a27;
  font-size: 30rpx;
  font-weight: 820;
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
}

.grid-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  min-height: 188rpx;
  padding: 25rpx 8rpx 21rpx;
  flex: 0 0 33.333333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #ffffff;
  text-align: center;
}

.grid-card:nth-child(3n) { border-right: 0; }
.grid-card:nth-child(n + 4) { border-bottom: 0; }

.entry-icon {
  width: 64rpx;
  height: 64rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  margin-top: 14rpx;
  overflow: hidden;
  color: #181d1a;
  font-size: 28rpx;
  font-weight: 770;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 9rpx;
  border-radius: 0 22rpx 0 13rpx;
  background: #fff0df;
  color: #d96720;
  font-size: 22rpx;
  font-weight: 760;
}

.workspace-strip {
  display: flex;
  min-height: 96rpx;
  margin-top: 14rpx;
  padding: 14rpx 20rpx;
  align-items: center;
  gap: 16rpx;
}

.workspace-icon-wrap {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #eaf8f0;
}

.workspace-icon-wrap image {
  width: 38rpx;
  height: 38rpx;
}

.workspace-title {
  min-width: 0;
  flex: 1;
  color: #202622;
  font-size: 28rpx;
  font-weight: 760;
}

.arrow {
  flex: none;
  color: #aab1ac;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active {
  background: #eef8f2;
}

.page-footer {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .home-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .today-card { padding-right: 20rpx; padding-left: 20rpx; }
  .today-headline { font-size: 29rpx; }
  .today-metric text:last-child { font-size: 27rpx; }
  .grid-card { min-height: 174rpx; }
  .entry-icon { width: 58rpx; height: 58rpx; }
  .card-title { font-size: 26rpx; }
}

@media (min-width: 700px) {
  .home-shell { padding-right: 32px; padding-left: 32px; }
  .today-card { padding-right: 34px; padding-left: 34px; }
  .grid-card { min-height: 170px; }
  .entry-icon { width: 54px; height: 54px; }
}
