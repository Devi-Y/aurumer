/* 首页配色：蓝白灰。品牌蓝 #1d5fd1，文字三档灰，涨跌只在数字和柱子上用红绿。 */

.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f4f6f9;
}

.home-panel {
  margin: 16rpx 20rpx 0;
  padding: 6rpx 0 0;
}

/* 走势在最上面：标题行不装进卡片，灰字贴在走势卡上方。 */
.group-head.home-head {
  margin: 12rpx 20rpx 0;
  padding-right: 4rpx;
}

.home-head .group-label {
  padding-left: 4rpx;
}

/* 分组标题是灰色小字，不跟正文抢重量。 */
.group-label {
  display: block;
  padding: 18rpx 24rpx 4rpx;
  color: #8a929e;
  font-size: 24rpx;
  font-weight: 600;
}

.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-right: 24rpx;
}

.group-head .group-label {
  padding-right: 0;
}

.group-meta {
  min-width: 0;
  flex: none;
  overflow: hidden;
  color: #9aa1ab;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 九宫格 ---------- */

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  padding: 8rpx 0 20rpx;
}

/* 年费条撤掉后，九宫格是首页主要的点按区；小屏收紧内边距时仍保住 176rpx 的触控高度。 */
.grid-card {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  min-height: 176rpx;
  min-width: 0;
  flex: 0 0 33.333%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.entry-icon-chip {
  display: flex;
  width: 98rpx;
  height: 98rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #edf2fb;
}

/* 服务格不是研究栏目，底色退成灰，和研究栏目分得开。 */
.entry-icon-chip.svc {
  background: #f1f3f6;
}

/* 预留格：只留一个虚线框占住位置。 */
.entry-icon-chip.is-reserved {
  box-sizing: border-box;
  border: 2rpx dashed #d3dae5;
  background: transparent;
}

.entry-icon {
  width: 50rpx;
  height: 50rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #1a1f27;
  font-size: 27rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active {
  background: #edf2fb;
}

/* ---------- 走势：2×2，一个数 + 一张图 ---------- */

.trend-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 8rpx 20rpx 0;
}

.trend-card {
  box-sizing: border-box;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
  padding: 22rpx 22rpx 20rpx;
  border: 1rpx solid #e6e9ef;
  border-radius: 24rpx;
  background: #ffffff;
}

.trend-title {
  overflow: hidden;
  color: #8a929e;
  font-size: 23rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-figure {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.trend-value {
  flex: none;
  color: #1a1f27;
  font-size: 38rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.trend-sub {
  min-width: 0;
  overflow: hidden;
  color: #8a929e;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-sub.up { color: #c2412d; }
.trend-sub.down { color: #0b7a53; }

/* 折线图片的宽高比要和 sparklineSvg 的 300×104 一致，线才不会被拉变形。 */
.trend-bars,
.trend-line {
  display: block;
  width: 100%;
  height: 104rpx;
  margin-top: 8rpx;
}

.trend-bars {
  position: relative;
  display: flex;
  gap: 6rpx;
}

.trend-zero {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #dde2ea;
}

.trend-slot {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100%;
}

.trend-bar {
  position: absolute;
  left: 0;
  right: 0;
  border-radius: 3rpx;
  background: #c8ced8;
}

.trend-bar.up { background: #c2412d; }
.trend-bar.down { background: #0b7a53; }

.page-footer {
  display: flex;
  padding: 24rpx 28rpx 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-note {
  max-width: 560rpx;
  color: #9aa1ab;
  font-size: 22rpx;
  line-height: 1.55;
}

@media (max-width: 340px) {
  .home-panel { margin-left: 12rpx; margin-right: 12rpx; }
  .grid-card { padding: 16rpx 6rpx; gap: 10rpx; }
  .entry-icon-chip { width: 84rpx; height: 84rpx; }
  .entry-icon { width: 44rpx; height: 44rpx; }
  .card-title { font-size: 24rpx; }
  .trend-grid, .group-head.home-head { margin-left: 12rpx; margin-right: 12rpx; }
}

@media (min-width: 700px) {
  .home-panel, .trend-grid, .group-head.home-head { margin-right: 32px; margin-left: 32px; }
  .entry-icon-chip { width: 49px; height: 49px; }
  .entry-icon { width: 25px; height: 25px; }
}
