.home-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f3f5f4;
}

.today-card,
.today-detail-panel,
.holdings-panel,
.service-panel,
.action-strip {
  overflow: hidden;
  background: #ffffff;
}

.hero-panel {
  position: relative;
  padding: 28rpx 32rpx 36rpx;
  border: 0;
  border-radius: 0;
  background: linear-gradient(165deg, #08a85a 0%, #07c160 48%, #069e54 100%);
  color: #ffffff;
}

.hero-art {
  position: absolute;
  right: -12rpx;
  top: 24rpx;
  width: 280rpx;
  height: 200rpx;
  opacity: 0.95;
  pointer-events: none;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-brand {
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  font-weight: 600;
}

.hero-asof {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.today-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  font-weight: 600;
}

.today-help {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-primary {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.hero-label {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.hero-value-row {
  display: flex;
  margin-top: 8rpx;
  align-items: baseline;
  gap: 12rpx;
}

.hero-value {
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -1rpx;
}

.hero-unit {
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
  font-weight: 500;
}

.hero-note {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 600;
}

.hero-metrics {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding: 8rpx 0 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.focus-metrics {
  margin-top: 24rpx;
}

.hero-metric,
.focus-metric {
  box-sizing: border-box;
  display: flex;
  width: 50%;
  min-width: 0;
  padding: 16rpx 14rpx;
  flex-direction: column;
  gap: 6rpx;
}

.focus-metric:nth-child(odd) {
  border-right: 1rpx solid rgba(255, 255, 255, 0.14);
}

.focus-metric:nth-child(-n+2) {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-metric text:first-child,
.focus-metric text:first-child {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.hero-metric text:nth-child(2),
.focus-metric text:nth-child(2) {
  overflow: hidden;
  max-width: 100%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus-hint {
  overflow: hidden;
  max-width: 100%;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus-metric.tap-active {
  background: rgba(255, 255, 255, 0.1);
}

.action-strip {
  display: flex;
  min-height: 88rpx;
  margin: 0;
  align-items: stretch;
  border-bottom: 1rpx solid #e8ece9;
}

.action-item {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #1f2a23;
  font-size: 26rpx;
  font-weight: 600;
}

.action-item image {
  width: 36rpx;
  height: 36rpx;
}

.action-divider {
  width: 1rpx;
  margin: 18rpx 0;
  background: #e4e9e6;
}

.today-detail-panel,
.holdings-panel,
.service-panel {
  margin: 16rpx 20rpx 0;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
}

.panel-kicker {
  display: block;
  padding: 22rpx 24rpx 0;
  color: #7a847e;
  font-size: 24rpx;
  font-weight: 600;
}

.today-headline {
  display: -webkit-box;
  overflow: hidden;
  margin: 12rpx 24rpx 8rpx;
  color: #1d2a22;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.today-point {
  display: flex;
  min-height: 92rpx;
  padding: 15rpx 20rpx;
  align-items: center;
  gap: 16rpx;
}

.today-point + .today-point {
  border-top: 1rpx solid #edf0ee;
}

.point-label {
  width: 70rpx;
  flex: none;
  color: #07c160;
  font-size: 24rpx;
  font-weight: 650;
}

.point-copy {
  min-width: 0;
  flex: 1;
}

.point-copy text {
  display: block;
}

.point-copy text:first-child {
  color: #242b27;
  font-size: 26rpx;
  font-weight: 560;
  line-height: 1.45;
}

.point-copy text:last-child {
  margin-top: 2rpx;
  color: #858c87;
  font-size: 22rpx;
}

.holding-empty,
.holding-row,
.holding-form {
  padding: 18rpx 20rpx;
}

.holding-empty text,
.holding-meta {
  display: block;
}

.holding-empty text:first-child {
  color: #2a322c;
  font-size: 27rpx;
  font-weight: 560;
}

.holding-empty text:last-child {
  margin-top: 6rpx;
  color: #858c87;
  font-size: 23rpx;
  line-height: 1.5;
}

.holding-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.holding-row + .holding-row {
  border-top: 1rpx solid #edf0ee;
}

.holding-main {
  min-width: 0;
  flex: 1;
}

.holding-name {
  display: block;
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 600;
}

.holding-meta {
  margin-top: 4rpx;
  color: #858c87;
  font-size: 22rpx;
}

.holding-delete {
  flex: none;
  color: #7a6560;
  font-size: 24rpx;
  padding: 10rpx 4rpx;
}

.holding-add {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid #edf0ee;
  color: #07c160;
  font-size: 27rpx;
  font-weight: 600;
}

.holding-form {
  border-top: 1rpx solid #edf0ee;
}

.holding-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #1b211d;
  font-size: 27rpx;
}

.holding-picker {
  display: flex;
  min-height: 76rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 12rpx;
  background: #f4f6f5;
  color: #1b211d;
  font-size: 27rpx;
}

.holding-picker text:last-child {
  color: #5a6d62;
  font-weight: 600;
}

.holding-form-actions {
  display: flex;
  margin-top: 14rpx;
  gap: 12rpx;
}

.holding-cancel,
.holding-save {
  display: flex;
  min-height: 76rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.holding-cancel {
  background: #eef1ef;
  color: #4a554e;
}

.holding-save {
  background: #07c160;
  color: #ffffff;
}

.service-head {
  display: flex;
  padding: 24rpx 24rpx 8rpx;
  align-items: baseline;
  justify-content: space-between;
}

.section-label {
  color: #1a211c;
  font-size: 30rpx;
  font-weight: 700;
}

.section-sub {
  color: #8a928d;
  font-size: 22rpx;
}

.entry-grid {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  border-top: 1rpx solid #edf0ee;
}

.grid-card {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  min-height: 188rpx;
  padding: 28rpx 8rpx 24rpx;
  flex: 0 0 33.333333%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0ee;
  border-bottom: 1rpx solid #edf0ee;
  background: #ffffff;
  text-align: center;
}

.grid-card:nth-child(3n) {
  border-right: 0;
}

.grid-card:nth-child(n + 4) {
  border-bottom: 0;
}

.entry-icon {
  width: 68rpx;
  height: 68rpx;
}

.card-title {
  display: block;
  max-width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  color: #181d1a;
  font-size: 27rpx;
  font-weight: 620;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 9rpx;
  border-radius: 0 22rpx 0 13rpx;
  background: #eef8f1;
  color: #07c160;
  font-size: 20rpx;
  font-weight: 620;
}

.workspace-strip {
  display: flex;
  min-height: 96rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #edf0ee;
  border-radius: 0;
}

.workspace-icon-wrap {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 17rpx;
  background: #eaf8f0;
}

.workspace-icon-wrap image {
  width: 38rpx;
  height: 38rpx;
}

.workspace-title {
  min-width: 0;
  flex: 1;
  color: #202622;
  font-size: 28rpx;
  font-weight: 620;
}

.arrow {
  flex: none;
  color: #aab1ac;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active {
  background: #eef8f2;
}

.page-footer {
  display: flex;
  padding: 22rpx 28rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.page-footer .is-stale {
  color: #8a6a3d;
  font-weight: 600;
}

@media (max-width: 340px) {
  .hero-panel { padding-right: 22rpx; padding-left: 22rpx; }
  .hero-value { font-size: 60rpx; }
  .today-headline { font-size: 29rpx; }
  .today-detail-panel,
  .holdings-panel,
  .service-panel { margin-right: 14rpx; margin-left: 14rpx; }
  .grid-card { min-height: 174rpx; }
  .entry-icon { width: 58rpx; height: 58rpx; }
  .card-title { font-size: 26rpx; }
}

@media (min-width: 700px) {
  .today-detail-panel,
  .holdings-panel,
  .service-panel { margin-right: 32px; margin-left: 32px; }
  .hero-panel { padding-right: 34px; padding-left: 34px; }
  .grid-card { min-height: 170px; }
  .entry-icon { width: 54px; height: 54px; }
}
