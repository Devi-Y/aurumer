<view class="page-shell list-shell">
  <view class="list-summary {{meta.tone}}">
    <view class="summary-copy">
      <text class="title">{{title}}</text>
      <text class="item-count">{{items.length}}</text>
    </view>
    <view class="summary-image-wrap">
      <image class="summary-image" src="{{meta.icon}}" mode="aspectFit" aria-hidden="true"></image>
    </view>
  </view>
  <text wx:if="{{groupHelp}}" class="list-help">{{groupHelp}}</text>

  <view wx:if="{{freshness.show}}" class="freshness-banner tone-{{freshness.tone}}">
    <text class="freshness-label">{{freshness.label}}</text>
    <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
  </view>

  <view wx:if="{{items.length}}" class="item-panel">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="item-row"
      data-id="{{item.id}}"
      bindtap="openItem"
      hover-class="tap-active"
      aria-role="button"
      aria-label="{{item.shortName}}，{{item.badge}}"
    >
      <text class="item-number">{{item.positionLabel}}</text>
      <view class="item-main">
        <view class="item-top">
          <view class="item-identity">
            <text class="item-name">{{item.shortName}}</text>
            <text wx:if="{{item.code}}" class="item-code">{{item.code}}</text>
          </view>
          <view class="item-tags">
            <text wx:if="{{item.researchScoreLabel}}" class="score-chip">{{item.researchScoreLabel}}</text>
            <text class="badge">{{item.badge}}</text>
          </view>
        </view>
        <view wx:if="{{item.showBar}}" class="data-bar-block">
          <view class="data-bar-track"><view class="data-bar-value {{item.barTone}}" style="width: {{item.barWidth}}%;"></view></view>
          <view class="data-bar-copy"><text>{{item.barLabel}}</text></view>
        </view>
        <text wx:if="{{item.showOne}}" class="item-one">{{item.one}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:else class="empty">
    <image src="{{meta.icon}}" mode="aspectFit" aria-hidden="true"></image>
    <text class="empty-title">暂无资料</text>
  </view>

  <view class="page-note">
    <text>{{disclaimer}}</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
