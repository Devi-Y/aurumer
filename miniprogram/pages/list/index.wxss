.list-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}

.list-summary,
.list-insight,
.item-panel,
.empty {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.list-summary {
  display: flex;
  min-height: 96rpx;
  padding: 18rpx 20rpx 18rpx 24rpx;
  align-items: center;
  gap: 16rpx;
  border-color: #e3ebe6;
  background: #ffffff;
}

.list-summary.us,
.list-summary.a,
.list-summary.gold,
.list-summary.guru {
  background: #ffffff;
  border-color: #e3ebe6;
}

.summary-copy { min-width: 0; flex: 1; }

.title,
.item-count { display: block; }

.title {
  color: #172019;
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.35;
}

.item-count {
  margin-top: 4rpx;
  color: #7f8781;
  font-size: 22rpx;
}

.summary-image-wrap {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f3f7f4;
}

.summary-image { width: 34rpx; height: 34rpx; }

.list-insight {
  margin-top: 12rpx;
  padding: 18rpx 24rpx 20rpx;
}

.insight-label {
  display: block;
  color: #6a756e;
  font-size: 22rpx;
  font-weight: 600;
}

.insight-conclusion {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #2a322c;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.section-heading {
  display: flex;
  padding: 24rpx 4rpx 12rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading text:first-child {
  color: #3a433d;
  font-size: 28rpx;
  font-weight: 650;
}

.section-heading text:last-child {
  color: #8a918c;
  font-size: 22rpx;
}

.item-row {
  display: flex;
  min-height: 132rpx;
  padding: 19rpx 17rpx 19rpx 19rpx;
  align-items: flex-start;
  gap: 14rpx;
}

.item-row + .item-row { border-top: 1rpx solid #edf0ee; }

.item-number {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f0f5f2;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 650;
}

.item-main { min-width: 0; flex: 1; }

.item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.item-identity { min-width: 0; flex: 1; }

.item-name,
.item-code,
.answer { display: block; }

.item-name {
  color: #1a201c;
  font-size: 29rpx;
  font-weight: 620;
  line-height: 1.38;
}

.item-code {
  margin-top: 2rpx;
  color: #8a918c;
  font-size: 22rpx;
}

.badge {
  max-width: 164rpx;
  padding: 4rpx 9rpx;
  flex: none;
  border-radius: 999rpx;
  background: #fff1e6;
  color: #b95723;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.answer {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #555d58;
  font-size: 23rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.data-bar-block { margin-top: 11rpx; }

.data-bar-copy {
  color: #4d6959;
  font-size: 22rpx;
  font-weight: 680;
}

.data-bar-track {
  overflow: hidden;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: #e8eeea;
}

.data-bar-value {
  height: 100%;
  border-radius: 999rpx;
  background: #20ad68;
}

/* 港股历史表现按境内习惯着色：上涨用红，下跌用绿。 */
.data-bar-value.up { background: #d4452c; }
.data-bar-value.down { background: #20ad68; }

.arrow {
  margin-top: 4rpx;
  flex: none;
  color: #adb4af;
  font-size: 37rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active { background: #eef8f2; }

.empty {
  display: flex;
  min-height: 260rpx;
  padding: 34rpx 24rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7c837e;
  font-size: 23rpx;
  text-align: center;
}

.empty image { width: 66rpx; height: 66rpx; margin-bottom: 8rpx; }
.empty-title { color: #222823; font-size: 29rpx; font-weight: 760; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .list-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .title { font-size: 35rpx; }
  .item-row { padding-right: 13rpx; padding-left: 15rpx; }
  .badge { max-width: 138rpx; }
}

@media (min-width: 700px) {
  .list-shell { padding-right: 32px; padding-left: 32px; }
  .list-summary,
  .list-insight,
  .item-panel,
  .empty { border-radius: 20px; }
}
