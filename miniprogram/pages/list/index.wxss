.list-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}

.list-summary,
.list-insight,
.item-panel,
.empty {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.list-summary {
  display: flex;
  min-height: 132rpx;
  padding: 20rpx 22rpx 20rpx 24rpx;
  align-items: center;
  gap: 20rpx;
  border-color: #dceee4;
  background: #f1faf5;
}

.list-summary.us { background: #f0f7fb; border-color: #dceaf1; }
.list-summary.a { background: #f0f8f5; border-color: #dcebe5; }
.list-summary.gold { background: #fbf7ee; border-color: #eee5cf; }
.list-summary.guru { background: #f3f5f8; border-color: #e1e5eb; }

.summary-copy { min-width: 0; flex: 1; }

.title,
.item-count { display: block; }

.title {
  color: #172019;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.35;
}

.item-count {
  margin-top: 7rpx;
  color: #7f8781;
  font-size: 22rpx;
}

.summary-image-wrap {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .9);
}

.summary-image { width: 48rpx; height: 48rpx; }

.list-insight {
  margin-top: 14rpx;
  padding: 21rpx 24rpx 23rpx;
}

.insight-label {
  display: block;
  color: #078d4b;
  font-size: 22rpx;
  font-weight: 800;
}

.insight-conclusion {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #242a26;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.section-heading {
  display: flex;
  padding: 27rpx 4rpx 14rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading text:first-child {
  color: #252a27;
  font-size: 30rpx;
  font-weight: 820;
}

.section-heading text:last-child {
  color: #8a918c;
  font-size: 22rpx;
}

.item-row {
  display: flex;
  min-height: 132rpx;
  padding: 19rpx 17rpx 19rpx 19rpx;
  align-items: flex-start;
  gap: 14rpx;
}

.item-row + .item-row { border-top: 1rpx solid #edf0ee; }

.item-number {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf8f0;
  color: #078d4b;
  font-size: 18rpx;
  font-weight: 850;
}

.item-main { min-width: 0; flex: 1; }

.item-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.item-identity { min-width: 0; flex: 1; }

.item-name,
.item-code,
.answer { display: block; }

.item-name {
  color: #1a201c;
  font-size: 29rpx;
  font-weight: 770;
  line-height: 1.38;
}

.item-code {
  margin-top: 2rpx;
  color: #8a918c;
  font-size: 21rpx;
}

.badge {
  max-width: 164rpx;
  padding: 4rpx 9rpx;
  flex: none;
  border-radius: 999rpx;
  background: #fff1e6;
  color: #b95723;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.answer {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #555d58;
  font-size: 23rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.data-bar-block { margin-top: 11rpx; }

.data-bar-copy {
  color: #4d6959;
  font-size: 20rpx;
  font-weight: 680;
}

.data-bar-track {
  overflow: hidden;
  height: 8rpx;
  margin-top: 6rpx;
  border-radius: 999rpx;
  background: #e8eeea;
}

.data-bar-value {
  height: 100%;
  border-radius: 999rpx;
  background: #20ad68;
}

.arrow {
  margin-top: 4rpx;
  flex: none;
  color: #adb4af;
  font-size: 37rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active { background: #eef8f2; }

.empty {
  display: flex;
  min-height: 260rpx;
  padding: 34rpx 24rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7c837e;
  font-size: 23rpx;
  text-align: center;
}

.empty image { width: 66rpx; height: 66rpx; margin-bottom: 8rpx; }
.empty-title { color: #222823; font-size: 29rpx; font-weight: 760; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .list-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .title { font-size: 35rpx; }
  .item-row { padding-right: 13rpx; padding-left: 15rpx; }
  .badge { max-width: 138rpx; }
}

@media (min-width: 700px) {
  .list-shell { padding-right: 32px; padding-left: 32px; }
  .list-summary,
  .list-insight,
  .item-panel,
  .empty { border-radius: 20px; }
}
