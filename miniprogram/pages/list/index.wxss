.list-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1b211d;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #6a746e;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #eef8f2; border-color: #d7ebe1; }
.freshness-banner.tone-warn { background: #fff7ec; border-color: #f0e0c8; }
.freshness-banner.tone-bad { background: #fdf0ee; border-color: #f0d5cf; }

/* 页头。和新闻资讯页共用一套写法：绿带里放标题、数据截至、一句说明、范围标签。
   负的左右外边距是为了让绿带顶满屏宽——.list-shell 自己留了 20rpx 的边，
   下面的卡片还要靠它，所以只有这一块把边退回去。 */
.list-hero {
  margin: -20rpx -20rpx 0;
  padding: 18rpx 24rpx 34rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.list-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.list-hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.list-hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-hero-help {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.45;
}

.list-hero-stats {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.list-stat {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}

/* 筛选条压在绿带下沿上，和新闻资讯页一个位置关系。 */
.list-filters {
  position: relative;
  z-index: 1;
  margin: -24rpx -20rpx 0;
  padding: 4rpx 0;
  white-space: nowrap;
}

.list-filters-inner {
  display: inline-flex;
  padding: 0 20rpx;
  align-items: center;
  gap: 10rpx;
}

.list-filter {
  padding: 10rpx 20rpx;
  flex: 0 0 auto;
  white-space: nowrap;
  border: 1rpx solid #e2e8e5;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5a645e;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.25;
}

.list-filter.active {
  border-color: #0b7a53;
  background: #0b7a53;
  color: #ffffff;
  font-weight: 660;
}

.list-filter-tap { opacity: 0.78; }

.stats-banner {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
}

.stats-title,
.stats-body,
.stats-note {
  display: block;
}

.stats-title {
  color: #1b211d;
  font-size: 26rpx;
  font-weight: 720;
}

.stats-body {
  margin-top: 8rpx;
  color: #3f4742;
  font-size: 24rpx;
  line-height: 1.5;
}

.stats-note {
  margin-top: 8rpx;
  color: #7a847e;
  font-size: 22rpx;
  line-height: 1.4;
}

.item-panel,
.empty { margin-top: 16rpx; }

/* 一行的节奏和新闻资讯页的条目一致：头行 / 标题 / 正文 / 脚行，四段。
   原来是并排两列再在右列里竖着堆六块，看不出哪句是结论、哪句是数据。 */
.item-row {
  padding: 22rpx 24rpx;
}

.item-row + .item-row { border-top: 1rpx solid #edf0ee; }

.item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

/* 结论徽章。底色只用来区分资产类别和好坏档位，不表示涨跌——所以和新闻资讯页
   的分类标签一样，刻意避开涨跌那套高饱和红绿，全部用低饱和底色。 */
.item-kind {
  max-width: 220rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  flex: none;
  border-radius: 999rpx;
  background: #eef2f0;
  color: #4a5550;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-kind.hk { background: #e9f4ee; color: #2c6b4c; }
.item-kind.us { background: #eaf1fb; color: #2c5a94; }
.item-kind.a { background: #f6eeee; color: #8a4b4b; }
.item-kind.gold { background: #f8f1e2; color: #866223; }
.item-kind.guru { background: #eeeff9; color: #45509a; }

/* 港股和A股的分组自带好坏语义，这几档用好坏色压过类别色。 */
.item-kind.is-good { background: #eaf8f0; color: #0b7a53; }
.item-kind.is-warn { background: #fff7ec; color: #93621d; }
.item-kind.is-bad { background: #fdf0ee; color: #a34b3e; }
.item-kind.is-muted { background: #f0f2f1; color: #778079; }

.item-meta {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  /* 徽章和当前分组同名被收起时，这一列是行首唯一的孩子，space-between 会把它
     甩到左边。推回右边，行与行的数字才对得齐。 */
  margin-left: auto;
  gap: 8rpx;
}

.item-meta-line {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 10rpx;
}

.item-score {
  flex: none;
  color: #9aa19c;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.item-metric {
  flex: none;
  color: #3a433d;
  font-size: 24rpx;
  font-weight: 660;
  font-variant-numeric: tabular-nums;
}

/* 涨跌按境内习惯着色：上涨红、下跌绿。 */
.item-metric.up { color: #c4473a; }
.item-metric.down { color: #0b7a53; }

/* 对比条画的是正上方那个数在本组里的相对高低，所以它紧贴着那行数字、
   宽度固定，不再自带一行文字标签把同一个数说第二遍。 */
.item-bar {
  overflow: hidden;
  width: 150rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #eef2ef;
}

.item-bar-value {
  height: 100%;
  border-radius: 999rpx;
  background: #0b7a53;
}

.item-bar-value.up { background: #d4452c; }
.item-bar-value.down { background: #20ad68; }

.item-title-row {
  display: flex;
  margin-top: 12rpx;
  align-items: baseline;
  gap: 10rpx;
}

.item-rank {
  flex: none;
  color: #b3b9b5;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.item-name {
  min-width: 0;
  overflow: hidden;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-code {
  flex: none;
  color: #9aa19c;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.item-fact {
  display: block;
  margin-top: 8rpx;
  color: #5a645e;
  font-size: 24rpx;
  line-height: 1.5;
}

.item-foot {
  display: flex;
  margin-top: 12rpx;
  align-items: center;
  gap: 10rpx;
}

.item-strategy-label {
  max-width: 180rpx;
  padding: 3rpx 12rpx;
  overflow: hidden;
  flex: none;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 660;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-strategy-label.tone-good { background: #eaf8f0; color: #0b7a53; }
.item-strategy-label.tone-warn { background: #fff7ec; color: #93621d; }
.item-strategy-label.tone-bad { background: #fdf0ee; color: #a34b3e; }
.item-strategy-label.tone-muted { background: #f0f2f1; color: #778079; }

/* 策略说明是按档位写的，同一档的行会是同一句话。所以它待遇和新闻资讯页脚行的
   「来源 xxx」一样：压到最轻、单行截断，在那儿备查而不抢戏。 */
.item-strategy-copy {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #858c87;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tap-active { background: #eef8f2; }.empty {
  display: flex;
  min-height: 260rpx;
  padding: 34rpx 24rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #7c837e;
  font-size: 23rpx;
  text-align: center;
}

.empty image { width: 66rpx; height: 66rpx; margin-bottom: 8rpx; }
.empty-title { color: #222823; font-size: 29rpx; font-weight: 760; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .list-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .list-hero { margin-right: -14rpx; margin-left: -14rpx; }
  .list-filters { margin-right: -14rpx; margin-left: -14rpx; }
  .list-filters-inner { padding: 0 14rpx; }
  .list-hero-title { font-size: 36rpx; }
  .item-row { padding-right: 18rpx; padding-left: 18rpx; }
  .item-kind { max-width: 176rpx; }
  .item-bar { width: 120rpx; }
  .item-strategy-label { max-width: 140rpx; }
}

@media (min-width: 700px) {
  .list-shell { padding-right: 32px; padding-left: 32px; }
  .item-panel,
  .empty { border-radius: 20px; }
}

/* 数据出处。与栏目页、详情页「资料」tab 同一套：地址摆出来，点一下复制走。 */
.source-panel {
  padding: 20rpx 0 4rpx;
}

.source-head {
  display: flex;
  padding: 0 24rpx 12rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.source-title {
  color: #1f2621;
  font-size: 28rpx;
  font-weight: 680;
}

.source-meta {
  color: #9aa19c;
  font-size: 22rpx;
}

.source-link-row {
  display: flex;
  min-height: 76rpx;
  padding: 14rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid #edf0ee;
  font-size: 27rpx;
}

.source-link-name {
  min-width: 0;
  flex: 1;
  color: #1b211d;
}

.source-link-action {
  flex: none;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 620;
}
