<view class="page-shell member-shell {{state.active ? 'member-shell-active' : ''}}">
  <view class="member-status-card">
    <view class="member-hero-copy">
      <text class="status-value {{state.active ? 'active' : ''}}">{{state.active ? '会员已开通' : '会员未开通'}}</text>
      <text class="member-title">个人投资逻辑哨兵</text>
      <text wx:if="{{state.statusDetail}}" class="status-detail">{{state.statusDetail}}</text>
    </view>
    <view class="member-hero-image-wrap"><image src="/assets/home/member.svg" mode="aspectFit" aria-hidden="true"></image></view>
  </view>

  <!-- 原来是「写／理由」「盯／变化」「复／盘」，第三格把「复盘」拆成两行，
       而且三格都不告诉会员里面现在有什么。第二行换成真实计数，读完再决定点哪个。 -->
  <view wx:if="{{state.active}}" class="member-shortcuts">
    <view
      wx:for="{{shortcuts}}"
      wx:key="tab"
      class="member-shortcut"
      data-tab="{{item.tab}}"
      bindtap="openWorkspace"
      hover-class="tap-active"
      aria-role="button"
      aria-label="{{item.title}}，{{item.help}}"
    >
      <text>{{item.title}}</text>
      <text class="shortcut-help">{{item.help}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-note">正在读取会员状态…</view>

  <view wx:if="{{settling || (!state.active && lastOrderId)}}" class="settle-card">
    <text>{{settling ? '正在核对微信支付结果…' : '若已付款但权益未到，请刷新。'}}</text>
    <button class="query-button" bindtap="manualQuery" data-order="{{lastOrderId}}" loading="{{querying}}" disabled="{{querying}}">刷新权益</button>
  </view>

  <view wx:if="{{!state.active && state.plans.length}}" class="plan-card">
    <view class="plan-heading">
      <view>
        <text class="plan-name">365 天会员</text>
        <text class="plan-term">一次购买 · 不自动续费</text>
        <text class="plan-brief">写理由 · 盯变化 · 复盘</text>
      </view>
      <text class="plan-price">{{state.plans[0].priceMain}}</text>
    </view>
    <button class="legal-link" bindtap="openLegal">会员协议与退款规则 <text>›</text></button>
  </view>

  <view wx:if="{{!state.active && !state.plans.length}}" class="state-note payment-closed">{{state.paymentReason || '支付通道准备中'}}</view>

  <!-- 订单的状态、金额、单号、有效期云函数一直在返回（publicOrders），页面
       上却没有任何一处渲染：付过款的人查不到自己的记录，付款没到账的人也只
       能靠本次会话残留的 lastOrderId 去查单，退出重进就查不了了。 -->
  <view wx:if="{{state.orders.length}}" class="order-panel">
    <view class="order-head">
      <text class="order-title">购买记录</text>
      <text class="order-meta">最近 {{state.orders.length}} 笔</text>
    </view>
    <view wx:for="{{state.orders}}" wx:key="orderId" class="order-row">
      <view class="order-line">
        <text class="order-status {{item.inFlight ? 'is-pending' : ''}}">{{item.statusLabel}}</text>
        <text class="order-amount">{{item.amountLabel}}</text>
      </view>
      <text class="order-sub">{{item.paidLabel || item.createdLabel}} · 单号 {{item.orderCode}}</text>
      <text wx:if="{{item.expiresLabel}}" class="order-sub">权益有效期至 {{item.expiresLabel}}</text>
      <text wx:if="{{item.refundLabel}}" class="order-sub">{{item.refundLabel}}</text>
      <button
        wx:if="{{item.canQuery}}"
        class="order-query"
        bindtap="manualQuery"
        data-order="{{item.orderId}}"
        loading="{{querying}}"
        disabled="{{querying}}"
      >刷新这笔权益</button>
    </view>
  </view>

  <view class="member-links">
    <!-- 会员协议与退款规则原来只挂在未开通时的套餐卡里，已开通的人在这个
         页面上反而没有入口。 -->
    <button class="legal-link" bindtap="openLegal">会员协议与退款规则 <text>›</text></button>
    <button class="support-link" open-type="contact" show-message-card="true">支付问题联系客服</button>
  </view>

  <text class="disclaimer">{{disclaimer}}</text>

  <view wx:if="{{state.plans.length && !state.active}}" class="pay-dock">
    <view class="pay-dock-copy">
      <text>365 天会员</text>
      <text>¥1,288 · 不自动续费</text>
    </view>
    <button
      class="buy-button {{!state.purchaseAllowed ? 'is-disabled' : ''}}"
      data-plan="{{state.plans[0].id}}"
      bindtap="buy"
      disabled="{{paying || settling || !state.purchaseAllowed}}"
      loading="{{paying}}"
    >{{settling ? '会员开通中' : (state.purchaseAllowed ? '立即微信支付' : '支付准备中')}}</button>
    <text class="dock-consent">不含买卖建议 · 点击即确认已满 18 周岁，并同意会员协议、隐私说明和退款规则</text>
  </view>
</view>
