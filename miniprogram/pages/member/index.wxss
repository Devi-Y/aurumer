.member-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx 16rpx calc(190rpx + env(safe-area-inset-bottom));
  background: #f4f6f5;
}

.member-shell-active {
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.member-shortcuts,
.settle-card,
.active-entry,
.member-links,
.state-note {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

/* 会员状态卡：深色卡，照抄原型 .wc-membership（与首页「今日重点」
   .today-card 同一套 --wc-deep 系变量，全站深色卡统一）。 */
.member-status-card {
  box-sizing: border-box;
  width: 100%;
  display: flex;
  margin-bottom: 16rpx;
  padding: 40rpx 36rpx;
  align-items: flex-start;
  gap: 20rpx;
  border-radius: 40rpx;
  background: #204937;
}

.member-hero-copy { min-width: 0; flex: 1; }
.member-hero-image-wrap {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #ffffff1f;
}
.member-hero-image-wrap image { width: 58rpx; height: 58rpx; }

.status-value,
.status-detail { display: block; }
.status-value { color: #c1d1c5; font-size: 23rpx; font-weight: 600; }
.status-value.active { color: #e2d2a9; }
.member-title { display: block; margin-top: 8rpx; font-family: "Songti SC", "STSong", serif; color: #f4f7ef; font-size: 42rpx; font-weight: 760; line-height: 1.2; letter-spacing: 1rpx; }
.status-detail { margin-top: 9rpx; color: #c1d1c5; font-size: 24rpx; line-height: 1.5; }
.member-subtitle { display: block; margin-top: 9rpx; color: #c1d1c5; font-size: 24rpx; }

.member-price-row { margin-top: 28rpx; }
.member-price {
  font-family: Georgia, serif;
  font-size: 72rpx;
  color: #f4f7ef;
  line-height: 1.1;
}
.member-price-unit { font-family: -apple-system, sans-serif; font-size: 24rpx; color: #c1d1c5; }
.member-term { display: block; margin-top: 6rpx; color: #c1d1c5; font-size: 23rpx; }

.member-shortcuts {
  display: flex;
  overflow: hidden;
}

.member-shortcut {
  box-sizing: border-box;
  display: flex;
  width: 33.333%;
  padding: 21rpx 10rpx;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  border-right: 1rpx solid #e6ebe8;
}
.member-shortcut:last-child { border-right: 0; }
.member-shortcut text:first-child { color: #1b211d; font-size: 28rpx; font-weight: 720; }
/* 第二行原来和第一行一样重（本来是被拆开的半个词），现在它是计数说明，
   降到辅助级，别跟标题抢。 */
.member-shortcut .shortcut-help { color: #6b736e; font-size: 22rpx; font-weight: 400; line-height: 1.3; text-align: center; }

.state-note {
  display: block;
  padding: 20rpx 24rpx;
  color: #5f6a64;
  font-size: 25rpx;
  line-height: 1.5;
}

.settle-card {
  display: flex;
  padding: 20rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  color: #4d5a52;
  font-size: 24rpx;
  line-height: 1.4;
}
.settle-card > text { flex: 1; }
.query-button {
  flex: none;
  margin: 0;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #e9f7ef;
  color: #078d4b;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.4;
}

.legal-link,
.support-link {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-height: 78rpx;
  margin: 0;
  padding: 14rpx 2rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #078d4b;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.4;
  text-align: left;
}
.legal-link text { color: #a6ada9; font-size: 37rpx; font-weight: 300; }

.active-entry {
  display: flex;
  padding: 22rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  color: #078d4b;
  font-size: 28rpx;
  font-weight: 700;
}
.active-entry text:last-child { color: #a6ada9; font-size: 38rpx; font-weight: 300; }

.member-links {
  padding: 2rpx 24rpx;
}

/* 购买记录：状态、金额、订单号、有效期这些字段云函数一直在返回，页面上
   却一处都没渲染，付过 1288 元的人在这一页看不到自己的订单。 */
.order-panel {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx 8rpx;
  border-radius: 24rpx;
  background: #ffffff;
}
.order-head { display: flex; align-items: baseline; justify-content: space-between; }
.order-title { color: #1b211d; font-size: 27rpx; font-weight: 700; }
.order-meta { color: #8b938e; font-size: 21rpx; }
.order-row { padding: 18rpx 0; border-bottom: 1rpx solid #edf0ee; }
.order-row:last-child { border-bottom: 0; }
.order-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.order-status { color: #1b211d; font-size: 25rpx; font-weight: 640; }
.order-status.is-pending { color: #b4691a; }
.order-amount { color: #1b211d; font-size: 25rpx; font-weight: 640; font-variant-numeric: tabular-nums; }
.order-sub { display: block; margin-top: 7rpx; color: #78807b; font-size: 21rpx; line-height: 1.5; }
.order-query {
  margin: 12rpx 0 2rpx;
  padding: 0 22rpx;
  color: #078d4b;
  font-size: 23rpx;
  line-height: 58rpx;
  border: 1rpx solid #cfe6d9;
  border-radius: 999rpx;
  background: #f2faf6;
}
.order-query::after { border: 0; }
.member-links .legal-link { border-bottom: 1rpx solid #edf0ee; }
.support-link { justify-content: flex-start; }

.disclaimer {
  display: block;
  margin: 18rpx 8rpx;
  color: #7b847e;
  font-size: 21rpx;
  line-height: 1.55;
}

.page-nav {
  display: flex;
  gap: 12rpx;
  padding-bottom: 20rpx;
}
.page-nav-button {
  flex: 1;
  padding: 18rpx 10rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #59645d;
  font-size: 24rpx;
  text-align: center;
}

.pay-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  min-height: 150rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  flex-wrap: wrap;
  align-items: center;
  gap: 5rpx 14rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(26, 55, 41, 0.08);
}
.pay-dock-copy { min-width: 0; flex: 1; }
.pay-dock-copy text { display: block; }
.pay-dock-copy text:first-child { color: #202421; font-size: 23rpx; font-weight: 650; }
.pay-dock-copy text:last-child { margin-top: 2rpx; color: #152019; font-size: 27rpx; font-weight: 720; }
.dock-consent { display: block; width: 100%; color: #707a73; font-size: 21rpx; line-height: 1.4; }
.buy-button {
  width: 280rpx;
  min-height: 82rpx;
  margin: 0;
  padding: 17rpx 12rpx;
  border-radius: 14rpx;
  background: #078d4b;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}
.buy-button.is-disabled { background: #9ab6a8; }

@media (max-width: 340px) {
  .member-shell { padding-right: 12rpx; padding-left: 12rpx; }
  .member-status-card { padding: 30rpx 24rpx; }
  .member-hero-image-wrap { width: 72rpx; height: 72rpx; }
  .member-hero-image-wrap image { width: 44rpx; height: 44rpx; }
  .member-price { font-size: 56rpx; }
  .pay-dock { padding-right: 12rpx; padding-left: 12rpx; gap: 5rpx 9rpx; }
  .buy-button { width: 230rpx; font-size: 24rpx; }
}

@media (min-width: 700px) {
  .member-shell { padding: 24px 32px calc(188px + env(safe-area-inset-bottom)); }
  .member-shell-active { padding-bottom: calc(42px + env(safe-area-inset-bottom)); }
  .member-status-card,
  .member-shortcuts,
  .settle-card,
  .active-entry,
  .member-links,
  .state-note { max-width: 820px; margin-right: auto; margin-left: auto; }
  .pay-dock { padding-right: 32px; padding-left: 32px; }
  .buy-button { width: 260px; }
}
