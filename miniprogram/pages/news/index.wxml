<view class="page-shell news-shell">
  <view class="news-hero">
    <view class="news-hero-top">
      <text class="news-hero-title">新闻资讯</text>
      <text class="news-hero-meta">{{dataAsOf || '同步中'}}</text>
    </view>
    <view wx:if="{{activity.total}}" class="news-activity" aria-label="近 30 天 {{activity.total}} 条">
      <view class="news-activity-bars">
        <view wx:for="{{activity.bars}}" wx:key="key" class="news-activity-slot">
          <view class="news-activity-bar {{item.empty ? 'is-empty' : ''}}" style="{{item.style}}"></view>
        </view>
      </view>
      <view class="news-activity-axis">
        <text>{{activity.startLabel}}</text>
        <text class="news-activity-total">近 30 天 {{activity.total}} 条</text>
        <text>{{activity.endLabel}}</text>
      </view>
    </view>
    <view wx:if="{{newCount}}" class="news-hero-stats">
      <text
        class="news-stat is-new"
        bindtap="showNewOnly"
        hover-class="news-stat-tap"
        aria-role="button"
        aria-label="只看新增的 {{newCount}} 条"
      >较上次查看新增 {{newCount}} 条 ›</text>
    </view>
  </view>

  <view class="news-search">
    <input
      class="news-search-input"
      type="text"
      placeholder="搜索标题、标的或代码"
      value="{{searchQuery}}"
      bindinput="onSearchInput"
      confirm-type="search"
      aria-label="搜索新闻资讯"
    />
    <text
      wx:if="{{searchQuery}}"
      class="news-search-clear"
      bindtap="clearSearch"
      hover-class="tap-active"
      aria-role="button"
      aria-label="清空搜索"
    >×</text>
  </view>

  <scroll-view
    wx:if="{{filters.length > 1}}"
    class="news-filters"
    scroll-x="true"
    enable-flex="true"
    show-scrollbar="false"
    enhanced="true"
  >
    <view class="news-filters-inner">
      <text
        wx:for="{{filters}}"
        wx:key="id"
        class="news-filter {{item.id === 'new' ? 'is-new' : ''}} {{activeFilter === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectFilter"
        aria-role="button"
        aria-label="只看{{item.label}}，共{{item.count}}条"
      >{{item.label}} {{item.count}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{sections.length}}" class="page-card news-list">
    <block wx:for="{{sections}}" wx:key="id" wx:for-item="section">
      <view class="news-group">
        <text class="news-group-title">{{section.title}}</text>
        <text class="news-group-count">{{section.count}} 条</text>
      </view>
      <view
        wx:for="{{section.rows}}"
        wx:key="key"
        class="news-row"
        data-id="{{item.id}}"
        bindtap="openItem"
        hover-class="tap-active"
        aria-role="button"
        aria-label="{{item.isNew ? '新增，' : ''}}{{item.title}}，{{item.dateNote}}{{item.dateLabel}}，{{item.body}}{{item.impact ? '，' + item.impact : ''}}，{{item.routeLabel}}"
      >
        <view class="news-row-head">
          <text class="news-kind {{item.kind}}">{{item.kindLabel}}</text>
          <view class="news-date-wrap">
            <text wx:if="{{item.isNew}}" class="news-new">新</text>
            <text wx:if="{{item.dateNote}}" class="news-date-note">{{item.dateNote}}</text>
            <text class="news-date">{{item.dateLabel}}</text>
          </view>
        </view>
        <text class="news-row-title">{{item.title}}</text>
        <text wx:if="{{item.body}}" class="news-row-body">{{item.body}}</text>
        <!-- 接回栏目结论的那句（值得打、热度第几、长期业绩）收成一枚小标签，
             不再单占一行加「现在怎么看」的标题。 -->
        <text wx:if="{{item.impact}}" class="news-tag">{{item.impact}}</text>
        <view class="news-row-foot">
          <text
            class="news-source"
            data-id="{{item.id}}"
            catchtap="copySource"
            aria-role="button"
            aria-label="复制 {{item.sourceName}} 链接"
          >来源 {{item.sourceName}}<text wx:if="{{item.sourceAction}}" class="news-source-action"> · {{item.sourceAction}}</text></text>
          <!-- 原来这里只有一个光秃秃的「›」，读者不知道点下去会到哪儿。
               这一页是引流工具，落点得写出来：有标的就去详情，没有就去栏目页。 -->
          <text class="news-route">{{item.routeLabel}} ›</text>
        </view>
      </view>
    </block>

    <view
      wx:if="{{restCount}}"
      class="news-more"
      bindtap="loadMore"
      hover-class="tap-active"
      aria-role="button"
      aria-label="继续展开更早的 {{restCount}} 条"
    >继续展开更早的 {{restCount}} 条</view>
  </view>
  <view wx:elif="{{searchQuery}}" class="page-card news-empty">
    <text class="news-empty-title">没有匹配「{{searchQuery}}」的条目</text>
  </view>
  <view wx:else class="page-card news-empty">
    <text class="news-empty-title">数据同步中</text>
  </view>

  <view class="page-note">
    <text>{{footerDisclaimer}}</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
