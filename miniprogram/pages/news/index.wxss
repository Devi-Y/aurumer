.news-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f5f7f6;
}

.news-hero {
  padding: 18rpx 24rpx 34rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.news-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.news-hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.news-hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-hero-help {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.45;
}

.news-hero-stats {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.news-stat {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}

/* 「新增」是这一页唯一需要抢注意力的信息，给它一个实底；
   其余统计沿用半透明底，不跟它抢。 */
.news-stat.is-new {
  background: #ffffff;
  color: #0b6b49;
  font-weight: 660;
}

.news-stat-tap {
  opacity: 0.78;
}

/* 六个类目在 390px 宽的机型上排不进一行（实测总宽 395px > 可用 366px）。
   换行会让最后一个「美股」孤零零掉到第二行，所以沿用详情页 tab 的横向滚动写法。 */
.news-filters {
  position: relative;
  z-index: 1;
  margin: -24rpx 0 0;
  padding: 4rpx 0;
  white-space: nowrap;
}

.news-filters-inner {
  display: inline-flex;
  padding: 0 20rpx;
  align-items: center;
  gap: 10rpx;
}

.news-filter {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  white-space: nowrap;
  border: 1rpx solid #e2e8e5;
  border-radius: 999rpx;
  background: #ffffff;
  color: #5a645e;
  font-size: 24rpx;
  font-weight: 560;
  line-height: 1.25;
}

.news-filter.is-new {
  border-color: #bfe0d0;
  background: #eef8f2;
  color: #0b6b49;
  font-weight: 660;
}

.news-filter.active {
  border-color: #0b7a53;
  background: #0b7a53;
  color: #ffffff;
  font-weight: 660;
}

.news-list,
.news-empty {
  margin: 16rpx 20rpx 0;
}

/* 这条流跨度接近一年，最新一条和最老一条在同一张卡片上。没有段头的话，
   一份 2025 年报看起来和今天的金价一样"新"，那是在误导。 */
.news-group {
  display: flex;
  padding: 20rpx 24rpx 10rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.news-group + .news-row {
  border-top: 0;
}

.news-row + .news-group {
  border-top: 1rpx solid #edf0ee;
}

.news-group-title {
  color: #1f2621;
  font-size: 25rpx;
  font-weight: 680;
  letter-spacing: 0.5rpx;
}

.news-group-count {
  color: #9aa19c;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.news-row {
  padding: 22rpx 24rpx;
}

.news-row + .news-row {
  border-top: 1rpx solid #edf0ee;
}

.news-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 分类色只用来区分来源类别，不表示涨跌好坏——所以刻意避开产品里
   表示"好/坏"的那套红绿，全部用低饱和底色。 */
.news-kind {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2f0;
  color: #4a5550;
  font-size: 21rpx;
  font-weight: 650;
}

.news-kind.hk { background: #e9f4ee; color: #2c6b4c; }
.news-kind.us { background: #eaf1fb; color: #2c5a94; }
.news-kind.a { background: #f6eeee; color: #8a4b4b; }
.news-kind.gold { background: #f8f1e2; color: #866223; }
.news-kind.guru { background: #eeeff9; color: #45509a; }

.news-date-wrap {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
}

/* 同一条流里混着公告日、挂牌日、报告期三种完全不同的日期。年报的报告期是
   12-31，读者可能大半年后才看到——不写清楚这个日期是什么，就等于让人
   把"报告期"读成"刚刚发生"。 */
.news-date-note {
  flex: none;
  color: #a8afaa;
  font-size: 20rpx;
}

.news-new {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #0b7a53;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 680;
  line-height: 1.45;
}

.news-date {
  flex: none;
  color: #9aa19c;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.news-row-title {
  display: block;
  margin-top: 12rpx;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.news-row-body {
  display: block;
  margin-top: 8rpx;
  color: #5a645e;
  font-size: 24rpx;
  line-height: 1.5;
}

.news-row-foot {
  display: flex;
  margin-top: 12rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.news-source {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #858c87;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.news-source-action {
  color: #0b7a53;
  font-weight: 620;
}

.news-more {
  padding: 24rpx 24rpx 26rpx;
  border-top: 1rpx solid #edf0ee;
  color: #0b7a53;
  font-size: 25rpx;
  font-weight: 620;
  text-align: center;
}

.news-empty {
  padding: 32rpx 24rpx 36rpx;
}

.news-empty-title,
.news-empty-help {
  display: block;
}

.news-empty-title {
  color: #1f2621;
  font-size: 28rpx;
  font-weight: 650;
}

.news-empty-help {
  margin-top: 10rpx;
  color: #858c87;
  font-size: 23rpx;
  line-height: 1.55;
}

.tap-active {
  background: #eef8f2;
}

.page-note {
  padding: 22rpx 28rpx 0;
  color: #9aa19c;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 340px) {
  .news-hero { padding: 14rpx 16rpx 28rpx; }
  .news-hero-title { font-size: 34rpx; }
  .news-filters-inner { padding-left: 12rpx; padding-right: 12rpx; }
  .news-list, .news-empty { margin-left: 12rpx; margin-right: 12rpx; }
  .news-group { padding-right: 18rpx; padding-left: 18rpx; }
  .news-row { padding: 18rpx 18rpx; }
  .news-row-title { font-size: 27rpx; }
  .news-row-body { font-size: 22rpx; }
}

@media (min-width: 700px) {
  .news-hero { padding-right: 32px; padding-left: 32px; }
  .news-filters-inner { padding-right: 32px; padding-left: 32px; }
  .news-list, .news-empty { margin-right: 32px; margin-left: 32px; }
}
