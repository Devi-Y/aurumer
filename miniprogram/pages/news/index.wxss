.news-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f4f6f9;
}

.news-hero {
  padding: 18rpx 24rpx 34rpx;
  background: linear-gradient(165deg, #2466d6 0%, #1d5fd1 55%, #174ea9 100%);
}

.news-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.news-hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.news-hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 30 天柱图：一天一根，白柱压在品牌蓝页头上；没有条目的日子留一道浅底线，
   看得出那天是空的，而不是图断了。 */
.news-activity {
  margin-top: 20rpx;
}

.news-activity-bars {
  display: flex;
  height: 96rpx;
  align-items: flex-end;
  gap: 4rpx;
}

.news-activity-slot {
  display: flex;
  height: 100%;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
}

.news-activity-bar {
  width: 100%;
  border-radius: 3rpx 3rpx 0 0;
  background: rgba(255, 255, 255, 0.92);
}

.news-activity-bar.is-empty {
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.22);
}

.news-activity-axis {
  display: flex;
  margin-top: 10rpx;
  align-items: baseline;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.7);
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.news-activity-total {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 650;
}

.news-hero-stats {
  display: flex;
  margin-top: 14rpx;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.news-stat {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}

/* 「新增」是这一页唯一需要抢注意力的信息，给它一个实底；
   其余统计沿用半透明底，不跟它抢。 */
.news-stat.is-new {
  background: #ffffff;
  color: #174ea9;
  font-weight: 660;
}

.news-stat-tap {
  opacity: 0.78;
}

/* 六个类目在 390px 宽的机型上排不进一行（实测总宽 395px > 可用 366px）。
   换行会让最后一个「美股」孤零零掉到第二行，所以保留横向滚动；视觉上改用
   栏目页 .hk-tab 那套灰色分段控件样式（灰底槽 + 选中态白色浮起小块），
   六个类目还是滚动着看，只是不再是描边药丸。 */
.news-search {
  display: flex;
  margin: 14rpx 20rpx 0;
  padding: 0 8rpx 0 20rpx;
  align-items: center;
  gap: 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(37, 55, 85, 0.06);
}

.news-search-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #1e2127;
  font-size: 25rpx;
}

.news-search-clear {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #eeeff3;
  color: #6a6e76;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.news-filters {
  position: relative;
  z-index: 1;
  margin: 14rpx 20rpx 0;
  white-space: nowrap;
}

/* 六个类目横滑时右侧看不出还有更多——纯 CSS 加一道渐隐遮罩提示可以继续滑，
   不改横滑这个交互决定本身（上面注释已经解释过为什么不用换行）。遮罩挂在
   scroll-view 容器本身（不随内容滚动），颜色接口 .news-filters-inner 的
   槽底色，看起来像槽的边缘自然虚化，不是一块颜色对不上的补丁。 */
.news-filters::after {
  content: "";
  position: absolute;
  top: 6rpx;
  right: 0;
  bottom: 6rpx;
  width: 56rpx;
  background: linear-gradient(to right, rgba(230, 233, 237, 0), #e6e9ed);
  border-radius: 0 16rpx 16rpx 0;
  pointer-events: none;
}

.news-filters-inner {
  display: inline-flex;
  padding: 6rpx;
  align-items: center;
  gap: 6rpx;
  border-radius: 16rpx;
  background: #e6e9ed;
}

.news-filter {
  box-sizing: border-box;
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  white-space: nowrap;
  border-radius: 12rpx;
  color: #5e636b;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
  transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
}

.news-filter.is-new {
  color: #1d5fd1;
  font-weight: 660;
}

.news-filter.active {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(29, 95, 209, 0.14);
  color: #1d5fd1;
  font-weight: 680;
}

.news-list,
.news-empty {
  margin: 16rpx 20rpx 0;
}

/* 这条流跨度接近一年，最新一条和最老一条在同一张卡片上。没有段头的话，
   一份 2025 年报看起来和今天的金价一样"新"，那是在误导。 */
.news-group {
  display: flex;
  padding: 20rpx 24rpx 10rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.news-group + .news-row {
  border-top: 0;
}

.news-row + .news-group {
  border-top: 1rpx solid #edeef0;
}

.news-group-title {
  color: #1e2127;
  font-size: 25rpx;
  font-weight: 680;
  letter-spacing: 0.5rpx;
}

.news-group-count {
  color: #999ca2;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.news-row {
  padding: 22rpx 24rpx;
}

.news-row + .news-row {
  border-top: 1rpx solid #edeef0;
}

.news-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 分类色只用来区分来源类别，不表示涨跌好坏——所以刻意避开产品里
   表示"好/坏"的那套红绿，全部用低饱和底色。 */
.news-kind {
  flex: none;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eeeff3;
  color: #494e56;
  font-size: 21rpx;
  font-weight: 650;
}

.news-kind.hk { background: #e9edf4; color: #1f55b5; }
.news-kind.us { background: #eaf1fb; color: #2c5a94; }
.news-kind.a { background: #f6eeee; color: #8a4b4b; }
.news-kind.gold { background: #f8f1e2; color: #866223; }
.news-kind.guru { background: #eeeff9; color: #45509a; }

.news-date-wrap {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
}

/* 同一条流里混着公告日、挂牌日、报告期三种完全不同的日期。年报的报告期是
   12-31，读者可能大半年后才看到——不写清楚这个日期是什么，就等于让人
   把"报告期"读成"刚刚发生"。 */
.news-date-note {
  flex: none;
  color: #a7aab0;
  font-size: 20rpx;
}

.news-new {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #1d5fd1;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 680;
  line-height: 1.45;
}

.news-date {
  flex: none;
  color: #999ca2;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.news-row-title {
  display: block;
  margin-top: 12rpx;
  color: #1a1d22;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.news-row-body {
  display: block;
  margin-top: 8rpx;
  color: #595d65;
  font-size: 24rpx;
  line-height: 1.5;
}

.news-row-foot {
  display: flex;
  margin-top: 12rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

/* 之前是 flex:1，把这半行的可点区域撑到整行空白处，点空白也会触发
   下面的复制来源，而不是跳到落点。改成跟着文字内容收窄，多出来的
   空白就不再属于任何一个点击目标。 */
.news-source {
  min-width: 0;
  flex: 0 1 auto;
  max-width: 68%;
  overflow: hidden;
  color: #84878d;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 复制链接是次要动作（核验用），落点才是这一行的主动作。两个都用品牌绿
   会在同一行里抢，所以出处这半边退成灰色，绿色只留给下面那个落点。 */
.news-source-action {
  color: #8a8e94;
  font-weight: 500;
}

/* 落点。整行的点击目标是它，来源那半边是 catchtap 复制链接——
   两个动作在同一行，所以落点得用品牌绿写清楚，不能只留一个箭头。 */
.news-route {
  flex: none;
  color: #1d5fd1;
  font-size: 22rpx;
  font-weight: 620;
  white-space: nowrap;
}

.news-more {
  padding: 24rpx 24rpx 26rpx;
  border-top: 1rpx solid #edeef0;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 620;
  text-align: center;
}

.news-empty {
  padding: 32rpx 24rpx 36rpx;
}

.news-empty-title {
  display: block;
}

.news-empty-title {
  color: #1e2127;
  font-size: 28rpx;
  font-weight: 650;
}

.tap-active {
  background: #edf2fb;
}

.page-note {
  padding: 22rpx 28rpx 0;
  color: #999ca2;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 340px) {
  .news-hero { padding: 14rpx 16rpx 28rpx; }
  .news-hero-title { font-size: 34rpx; }
  .news-filters-inner { padding-left: 12rpx; padding-right: 12rpx; }
  .news-list, .news-empty { margin-left: 12rpx; margin-right: 12rpx; }
  .news-group { padding-right: 18rpx; padding-left: 18rpx; }
  .news-row { padding: 18rpx 18rpx; }
  .news-row-title { font-size: 27rpx; }
  .news-row-body { font-size: 22rpx; }
}

@media (min-width: 700px) {
  .news-hero { padding-right: 32px; padding-left: 32px; }
  .news-filters-inner { padding-right: 32px; padding-left: 32px; }
  .news-list, .news-empty { margin-right: 32px; margin-left: 32px; }
}

.news-tag {
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #edf2fb;
  color: #1d5fd1;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.4;
}
