<view class="page-shell section-shell">
  <!-- 页头照新闻资讯页的写法：绿带里放栏目名、数据截至、一句说明和范围标签。
       原来是一张白卡，页面上看不到这份数据是什么时候的，装饰图标反而最显眼。 -->
  <view class="section-hero">
    <view class="hero-top">
      <text class="hero-title">{{meta.title}}</text>
      <text class="hero-meta">{{dataAsOf || '同步中'}}</text>
    </view>
    <text class="hero-help">{{meta.one}}</text>
    <view wx:if="{{answers.length}}" class="hero-stats">
      <text class="hero-stat">今日答案 {{answers.length}} 条</text>
    </view>
  </view>

  <!-- 结论和关键数值单独成卡，向上压住绿带下沿——和新闻资讯页筛选条压边一样。 -->
  <view class="page-card hero-body">
    <view class="insight-panel" wx:if="{{overview.target || overview.grade}}">
      <view class="insight-line">
        <text class="insight-label">结论</text>
        <text
          class="insight-target {{overview.canOpenTarget ? 'is-link' : ''}}"
          bindtap="openInsightTarget"
          hover-class="{{overview.canOpenTarget ? 'insight-tap' : ''}}"
          aria-role="button"
          aria-label="打开标的 {{overview.target}}"
        >{{overview.target || '—'}}</text>
        <text
          class="insight-grade {{overview.canOpenGrade ? 'is-link' : ''}}"
          bindtap="openInsightGrade"
          hover-class="{{overview.canOpenGrade ? 'insight-tap' : ''}}"
          aria-role="button"
          aria-label="打开 {{overview.grade}}"
        >{{overview.grade || '—'}}</text>
      </view>
    </view>

    <view class="hero-metrics">
      <view
        wx:for="{{overview.metrics}}"
        wx:key="label"
        class="hero-metric {{item.enabled ? 'is-active' : 'is-disabled'}}"
        data-action="{{item.action}}"
        data-group="{{item.group}}"
        data-id="{{item.id}}"
        data-enabled="{{item.enabled}}"
        bindtap="openMetric"
        hover-class="{{item.enabled ? 'metric-tap' : ''}}"
        aria-role="button"
        aria-disabled="{{item.enabled ? 'false' : 'true'}}"
        aria-label="{{item.label}}，{{item.value}}"
      >
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 黄金专属：四个报价本来就在快照里，但分散成四个互不相干的数字。
       买金的人每天只算一件事——国内金比国际金贵还是便宜。把那条换算摆到
       栏目页顶部，并把换算式本身写出来，读的人可以自己复算。 -->
  <view wx:if="{{parity}}" class="page-card parity-panel">
    <view class="parity-head">
      <text class="parity-title">四口径 · 同一块金子</text>
      <text class="parity-meta">{{parity.rateText}}</text>
    </view>
    <text class="parity-headline">{{parity.headline}}</text>
    <view class="parity-grid">
      <view wx:for="{{parity.cells}}" wx:key="id" class="parity-cell">
        <text class="parity-cell-label">{{item.label}}</text>
        <view class="parity-cell-value">
          <text class="parity-cell-number">{{item.value}}</text>
          <text class="parity-cell-unit">{{item.unit}}</text>
        </view>
        <text wx:if="{{item.meta}}" class="parity-cell-meta">{{item.meta}}</text>
      </view>
    </view>
    <text class="parity-formula">{{parity.formula}}　（1 金衡盎司 = 31.1035 克）</text>
  </view>

  <view wx:if="{{freshness.show}}" class="page-card freshness-banner tone-{{freshness.tone}}">
    <view class="freshness-head">
      <text class="freshness-label">{{freshness.label}}</text>
      <view wx:if="{{freshness.showRetry}}" class="freshness-action" bindtap="retryFreshness" aria-role="button">重试</view>
    </view>
    <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
  </view>

  <view wx:if="{{answers.length}}" class="page-card answer-panel">
    <view class="answer-head">
      <text class="answer-title">今日答案</text>
      <text class="answer-meta">研究观察，不是买卖指令</text>
    </view>
    <view
      wx:for="{{answers}}"
      wx:key="id"
      class="answer-row tone-{{item.tone}} {{item.enabled ? '' : 'is-empty'}}"
      data-id="{{item.id}}"
      bindtap="openAnswer"
      hover-class="{{item.enabled ? 'tap-active' : ''}}"
      aria-role="button"
      aria-label="{{item.question}}，{{item.answer}}"
    >
      <view class="answer-copy">
        <text class="answer-q">{{item.question}}</text>
        <text class="answer-a">{{item.answer}}</text>
        <text wx:if="{{item.names}}" class="answer-names">{{item.names}}</text>
      </view>
      <text wx:if="{{item.enabled}}" class="arrow">›</text>
      <text wx:else class="group-empty-hint">—</text>
    </view>
  </view>

  <view wx:if="{{deepLinks.length}}" class="page-card deep-panel">
    <view
      wx:for="{{deepLinks}}"
      wx:key="id"
      class="deep-row {{item.enabled ? '' : 'is-empty'}}"
      data-group="{{item.group}}"
      data-enabled="{{item.enabled}}"
      bindtap="openDeepLink"
      hover-class="{{item.enabled ? 'tap-active' : ''}}"
      aria-role="button"
      aria-disabled="{{item.enabled ? 'false' : 'true'}}"
      aria-label="{{item.title}}，{{item.help}}"
    >
      <view class="deep-copy">
        <text class="deep-title">{{item.title}}</text>
        <text class="deep-help">{{item.help}}</text>
      </view>
      <text wx:if="{{item.enabled}}" class="arrow">›</text>
      <text wx:else class="group-empty-hint">—</text>
    </view>
  </view>

  <view class="page-card group-panel">
    <view
      wx:for="{{groups}}"
      wx:key="id"
      class="group-row {{item.count ? '' : 'is-empty'}}"
      data-group="{{item.id}}"
      bindtap="openGroup"
      hover-class="{{item.count ? 'tap-active' : ''}}"
      aria-role="button"
      aria-disabled="{{item.count ? 'false' : 'true'}}"
      aria-label="{{item.title}}，{{item.one}}，{{item.count ? item.count + ' 项' : '暂无'}}"
    >
      <text class="group-index">{{item.indexLabel}}</text>
      <view class="group-copy">
        <text class="group-title">{{item.title}}</text>
        <text class="group-help">{{item.one}}</text>
      </view>
      <text class="group-count">{{item.count}}</text>
      <text wx:if="{{item.count}}" class="arrow">›</text>
      <text wx:else class="group-empty-hint">—</text>
    </view>
  </view>

  <view wx:if="{{playbooks.length}}" class="page-card playbook-panel">
    <view class="playbook-head">
      <text class="playbook-title">大师策略摘要</text>
      <text class="playbook-meta">只学方法，不照抄仓位</text>
    </view>
    <view
      wx:for="{{playbooks}}"
      wx:key="id"
      class="playbook-row"
      data-id="{{item.id}}"
      bindtap="openPlaybook"
      hover-class="tap-active"
      aria-role="button"
      aria-label="{{item.name}}，{{item.tag}}"
    >
      <view class="playbook-copy">
        <view class="playbook-title-row">
          <text class="playbook-name">{{item.name}}</text>
          <text class="playbook-tag">{{item.tag}}</text>
        </view>
        <text class="playbook-principle">{{item.principle}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{sourceLinks.length}}" class="page-card source-panel">
    <view class="source-head">
      <text class="source-title">数据出处</text>
      <text class="source-meta">点一条复制走自行核对</text>
    </view>
    <view
      wx:for="{{sourceLinks}}"
      wx:key="url"
      class="source-link-row"
      data-url="{{item.url}}"
      bindtap="copySourceLink"
      hover-class="tap-active"
      aria-role="button"
      aria-label="复制 {{item.name}} 的链接"
    >
      <text class="source-link-name">{{item.name}}</text>
      <text class="source-link-action">复制链接</text>
    </view>
  </view>

  <view class="page-note">
    <text>{{disclaimer}}</text>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>
</view>
