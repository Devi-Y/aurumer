<view class="page-shell section-shell">
  <view class="section-hero {{meta.tone}}">
    <view class="hero-top">
      <text class="hero-title">{{meta.title}}</text>
      <view class="hero-image-wrap">
        <image class="hero-image" src="{{meta.icon}}" mode="aspectFit" aria-hidden="true"></image>
      </view>
    </view>
    <text class="hero-help">{{meta.one}}</text>
    <view class="hero-metrics">
      <view wx:for="{{overview.metrics}}" wx:key="label" class="hero-metric">
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="insight-panel">
    <text class="insight-label">结论</text>
    <text class="insight-conclusion">{{overview.conclusion}}</text>
    <text wx:if="{{overview.analysis}}" class="insight-analysis">{{overview.analysis}}</text>
  </view>

  <view class="section-heading">
    <text>继续看</text>
    <text>{{groups.length}} 项</text>
  </view>

  <view class="group-panel">
    <view
      wx:for="{{groups}}"
      wx:key="id"
      class="group-row {{item.count ? '' : 'is-empty'}}"
      data-group="{{item.id}}"
      bindtap="openGroup"
      hover-class="{{item.count ? 'tap-active' : ''}}"
      aria-role="button"
      aria-disabled="{{item.count ? 'false' : 'true'}}"
      aria-label="{{item.title}}，{{item.count ? '共 ' + item.count + ' 项' : '当前没有符合条件的项目，暂不可进入'}}"
    >
      <text class="group-index">{{item.indexLabel}}</text>
      <text class="group-title">{{item.title}}</text>
      <text class="group-count">{{item.count}}</text>
      <text wx:if="{{item.count}}" class="arrow">›</text>
      <text wx:else class="group-empty-hint">暂无</text>
    </view>
  </view>

  <view class="page-nav">
    <view class="page-nav-button" bindtap="goBack" hover-class="tap-active" aria-role="button" aria-label="返回上一页">‹ 上一页</view>
    <view class="page-nav-button" bindtap="goHome" hover-class="tap-active" aria-role="button" aria-label="回到首页">回到首页</view>
  </view>

  <view class="page-note">
    <text>{{source}}</text>
    <text>公开资料研究观察，供参考；不是强制下单指令，决策自负。</text>
  </view>
</view>
