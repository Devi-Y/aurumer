<view class="page-shell section-shell">
  <!-- 页头只放栏目名和数据截至。标题下那行「上新 / 值得打 / 避雷…」
       2026-09-29 按产品要求撤掉（字太多），只留作读屏标签。 -->
  <view class="section-hero">
    <view class="hero-top">
      <text class="hero-title" aria-label="{{meta.title}}：{{meta.one}}">{{meta.title}}</text>
      <text class="hero-meta">{{dataAsOf || '同步中'}}</text>
    </view>
    <!-- 原来这里还有一块「今日答案 N 条」徽章，跟正下方 tab 上的
         「今日答案 N」离得很近、说的是同一件事，删掉这块，数字交给 tab。 -->
  </view>

  <!-- 结论和关键数值单独成卡，向上压住绿带下沿——和新闻资讯页筛选条压边一样。 -->
  <view class="page-card hero-body">
    <view class="insight-panel" wx:if="{{overview.target || overview.grade}}">
      <view class="insight-line">
        <text class="insight-label">{{overview.label || '结论'}}</text>
        <text
          class="insight-target {{overview.canOpenTarget ? 'is-link' : ''}}"
          bindtap="openInsightTarget"
          hover-class="{{overview.canOpenTarget ? 'insight-tap' : ''}}"
          aria-role="button"
          aria-label="打开标的 {{overview.target}}"
        >{{overview.target || '—'}}</text>
        <text
          class="insight-grade {{overview.canOpenGrade ? 'is-link' : ''}}"
          bindtap="openInsightGrade"
          hover-class="{{overview.canOpenGrade ? 'insight-tap' : ''}}"
          aria-role="button"
          aria-label="打开 {{overview.grade}}"
        >{{overview.grade || '—'}}</text>
      </view>
    </view>

    <view wx:if="{{overview.metrics.length}}" class="hero-metrics">
      <view
        wx:for="{{overview.metrics}}"
        wx:key="label"
        class="hero-metric {{item.enabled ? 'is-active' : 'is-disabled'}}"
        data-action="{{item.action}}"
        data-group="{{item.group}}"
        data-id="{{item.id}}"
        data-enabled="{{item.enabled}}"
        bindtap="openMetric"
        hover-class="{{item.enabled ? 'metric-tap' : ''}}"
        aria-role="button"
        aria-disabled="{{item.enabled ? 'false' : 'true'}}"
        aria-label="{{item.label}}，{{item.value}}"
      >
        <text>{{item.label}}</text>
        <text>{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 「四口径 · 同一块金子」这块换算面板原来钉在这里，占掉近半屏，而它印的
       4440 和 951.5 在上面的结论行、下面的「现在什么价」卡里各已经出现过一次
       ——同一屏三遍。这一栏只答四问：什么价、能不能买、要不要卖、拐点如何。
       换算面板整块留在黄金详情页（pages/detail 有同一份 goldParity），
       从这里点「查看」一步就到，不是删内容，是挪到该在的那一层。 -->

  <view wx:if="{{freshness.show}}" class="page-card freshness-banner tone-{{freshness.tone}}">
    <view class="freshness-head">
      <text class="freshness-label">{{freshness.label}}</text>
      <view wx:if="{{freshness.showRetry}}" class="freshness-action" bindtap="retryFreshness" aria-role="button">重试</view>
    </view>
    <text wx:if="{{freshness.tip}}" class="freshness-tip">{{freshness.tip}}</text>
  </view>

  <!-- 港股打新按原型忠实复刻：只有「近期申购」「中签后」两个视图，不是
       其余四栏共用的「今日答案/分组浏览/策略摘要/数据出处」多 tab 框架。 -->
  <view wx:if="{{market === 'hk'}}" class="page-card hk-card">
    <view class="hk-tabs">
      <view
        class="hk-tab {{hkSubTab === 'apply' ? 'is-active' : ''}}"
        data-id="apply"
        bindtap="switchHkSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{hkSubTab === 'apply'}}"
      >近期申购</view>
      <view
        class="hk-tab {{hkSubTab === 'exit' ? 'is-active' : ''}}"
        data-id="exit"
        bindtap="switchHkSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{hkSubTab === 'exit'}}"
      >申购结束</view>
    </view>

    <block wx:if="{{hkSubTab === 'apply'}}">
      <!-- 近期上市新股首日涨跌，一根柱一只，从早到晚；红涨绿跌，零轴是发行价。 -->
      <view
        wx:if="{{hkFirstDayChart}}"
        class="hk-fd"
        aria-label="近{{hkFirstDayChart.count}}只新股上市首日，{{hkFirstDayChart.upText}}，{{hkFirstDayChart.flatDownText}}"
      >
        <view class="hk-fd-head">
          <text class="hk-fd-title">近{{hkFirstDayChart.count}}只新股首日</text>
          <view class="hk-fd-figs">
            <text class="hk-fd-value is-up">{{hkFirstDayChart.upText}}</text>
            <text class="hk-fd-value is-down">{{hkFirstDayChart.flatDownText}}</text>
          </view>
        </view>
        <view class="hk-fd-bars" aria-hidden="true">
          <view class="hk-fd-zero" style="{{hkFirstDayChart.zeroStyle}}"></view>
          <view wx:for="{{hkFirstDayChart.bars}}" wx:for-item="bar" wx:key="key" class="hk-fd-slot">
            <view class="hk-fd-bar {{bar.tone}}" style="{{bar.style}}"></view>
          </view>
        </view>
      </view>
      <view class="hk-stock-list" wx:if="{{hkApplyList.length}}">
        <view
          wx:for="{{hkApplyList}}"
          wx:key="id"
          class="hk-stock-row"
          data-id="{{item.id}}"
          bindtap="openHkDetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，{{item.badgeText}}，{{item.reason}}"
        >
          <view class="hk-row-between">
            <view class="hk-row-name-wrap">
              <text class="hk-stock-name">{{item.name}}</text>
              <text class="hk-code">{{item.code}}</text>
            </view>
            <view class="hk-score" wx:if="{{item.score}}">
              <text class="hk-score-value">{{item.score}}</text>
              <text class="hk-score-label">评分</text>
            </view>
            <text class="hk-badge tone-{{item.tone}}">{{item.badgeText}}</text>
          </view>
          <view class="hk-stats">
            <view wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label" class="hk-stat">
              <text class="hk-stat-label">{{stat.label}}</text>
              <text class="hk-stat-value">{{stat.value}}</text>
            </view>
          </view>
          <view class="hk-row-meta">
            <text>{{item.deadlineLabel}}</text>
            <text class="hk-row-caret">›</text>
          </view>
        </view>
      </view>
      <view class="hk-empty" wx:else><text>当前没有在售新股，稍后再来看看。</text></view>
    </block>

    <block wx:if="{{hkSubTab === 'exit'}}">
      <block wx:if="{{hkExitOptions.length}}">
        <picker
          class="hk-picker"
          mode="selector"
          range="{{hkExitOptions}}"
          range-key="text"
          value="{{hkExitIndex}}"
          bindchange="selectHkExit"
        >
          <view class="hk-picker-value">
            <text>{{hkExitView.text}}</text>
            <text class="hk-picker-caret">▾</text>
          </view>
        </picker>

        <view class="hk-exit-card" wx:if="{{hkExitView}}">
          <view class="hk-row-between">
            <view class="hk-row-name-wrap">
              <text class="hk-exit-name">{{hkExitView.name}}</text>
              <text class="hk-code" wx:if="{{hkExitView.oversubText}}">{{hkExitView.oversubText}}</text>
            </view>
            <text class="hk-badge tone-{{hkExitView.tone}}">{{hkExitView.badgeText}}</text>
          </view>

          <view class="hk-exit-rows" wx:if="{{hkExitView.plan.rows.length}}">
            <view wx:for="{{hkExitView.plan.rows}}" wx:for-item="row" wx:key="label" class="hk-exit-row">
              <text class="hk-exit-row-label">{{row.label}}</text>
              <text class="hk-exit-row-value">{{row.value}}</text>
            </view>
          </view>
        </view>
      </block>
      <view class="hk-empty is-compact" wx:else><text>暂无待配发新股</text></view>
      <view class="hk-tier-chart" wx:if="{{hkExitChart && (!hkExitView || hkExitView.showTierChart)}}">
        <text class="hk-tier-title">同类新股打中后涨跌</text>
        <view class="hk-tier-legend">
          <view wx:for="{{hkExitChart.legend}}" wx:key="key" class="hk-tier-legend-item {{hkExitView.tier === item.key ? 'is-mine' : ''}}">
            <view class="hk-tier-dot tier-{{item.key}}"></view>
            <text>{{item.label}}</text>
            <text wx:if="{{hkExitView.tier === item.key}}" class="hk-tier-mine">本股</text>
          </view>
        </view>
        <view wx:for="{{hkExitChart.groups}}" wx:for-item="group" wx:key="label" class="hk-tier-group">
          <text class="hk-tier-stage">{{group.label}}</text>
          <view class="hk-tier-bars">
            <view wx:for="{{group.bars}}" wx:for-item="bar" wx:key="tier" class="hk-tier-row {{hkExitView.tier && hkExitView.tier !== bar.tier ? 'is-dim' : ''}}">
              <view class="hk-tier-track">
                <view class="hk-tier-zero" style="left: {{hkExitChart.zero}}%;"></view>
                <view class="hk-tier-bar tier-{{bar.tier}} is-{{bar.dir}}" style="left: {{bar.left}}%; width: {{bar.width}}%;"></view>
              </view>
              <text class="hk-tier-value is-{{bar.dir}}">{{bar.valueText}}</text>
              <text class="hk-tier-ratio">{{bar.ratioText}}</text>
            </view>
          </view>
        </view>
        <text class="hk-tier-foot">{{hkExitChart.sampleText}}</text>
      </view>
      <text wx:if="{{!hkExitChart && !hkExitOptions.length}}" class="hk-empty-text">历史样本不足</text>
    </block>
  </view>

  <!-- 美股投资按原型忠实复刻：只有「七姐妹」「热门三只」两个视图。七姐妹的
       判断句复用详情页同一套 usSignal；热门三只没有新闻源、没有事件字段，
       用成交量/涨跌算出来的 heatDriver 说明「为什么热」，不编发布会剧情。 -->
  <view wx:if="{{market === 'us'}}" class="page-card us-card">
    <view class="us-tabs">
      <view
        class="us-tab {{usSubTab === 'seven' ? 'is-active' : ''}}"
        data-id="seven"
        bindtap="switchUsSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{usSubTab === 'seven'}}"
      >七姐妹</view>
      <view
        class="us-tab {{usSubTab === 'hot' ? 'is-active' : ''}}"
        data-id="hot"
        bindtap="switchUsSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{usSubTab === 'hot'}}"
      >热门三只</view>
    </view>

    <block wx:if="{{usSubTab === 'seven'}}">
      <view class="us-mix" wx:if="{{usSevenMix.length}}" aria-label="{{usSevenHint}}">
        <view class="us-mix-bar">
          <view
            wx:for="{{usSevenMix}}"
            wx:key="label"
            class="us-mix-seg tone-{{item.tone}}"
            style="flex: {{item.count}};"
          ></view>
        </view>
        <view class="us-mix-legend">
          <view wx:for="{{usSevenMix}}" wx:key="label" class="us-mix-item">
            <view class="us-mix-dot tone-{{item.tone}}"></view>
            <text>{{item.label}}</text>
            <text class="us-mix-count">{{item.count}}只</text>
          </view>
        </view>
      </view>
      <view class="us-stock-list" wx:if="{{usSevenList.length}}">
        <view
          wx:for="{{usSevenList}}"
          wx:key="id"
          class="us-stock-row"
          data-id="{{item.id}}"
          bindtap="openUsDetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，{{item.badgeText}}，{{item.reason}}"
        >
          <!-- 一行三列：名字 + 判断 | 60 日走势 | 现价 + 今日涨跌。PE、营收和
               60 日区间点位都在走势图和详情页里，列表不再逐项念一遍。 -->
          <view class="us-row-name-col">
            <text class="us-stock-name">{{item.name}}</text>
            <view class="us-row-tags">
              <text class="us-code">{{item.code}}</text>
              <text class="us-badge tone-{{item.tone}}">{{item.badgeText}}</text>
            </view>
          </view>
          <image wx:if="{{item.hasSpark}}" class="us-spark" src="{{item.sparkSrc}}" mode="scaleToFill" aria-hidden="true"></image>
          <view wx:else class="us-spark"></view>
          <view class="us-right">
            <text class="us-price">{{item.priceText}}</text>
            <text class="us-change is-{{item.changeTone}}">{{item.changeText}}</text>
          </view>
        </view>
      </view>
      <view class="us-empty" wx:else><text>七姐妹判断暂不足以显示，请稍后刷新。</text></view>
    </block>

    <block wx:if="{{usSubTab === 'hot'}}">
      <view class="us-stock-list" wx:if="{{usHotList.length}}">
        <view
          wx:for="{{usHotList}}"
          wx:key="id"
          class="us-stock-row"
          data-id="{{item.id}}"
          bindtap="openUsDetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，热度 {{item.heatText}}，{{item.why}}，{{item.takeText}}"
        >
          <view class="us-row-name-col">
            <text class="us-stock-name">{{item.name}}</text>
            <view class="us-row-tags">
              <text class="us-code">{{item.code}}</text>
              <text class="us-badge tone-{{item.takeTone}}">{{item.takeText}}</text>
            </view>
          </view>
          <image wx:if="{{item.hasSpark}}" class="us-spark" src="{{item.sparkSrc}}" mode="scaleToFill" aria-hidden="true"></image>
          <view wx:else class="us-spark"></view>
          <view class="us-right">
            <text class="us-heat-value">{{item.heatText}}</text>
            <text class="us-heat-label">热度</text>
          </view>
        </view>
      </view>
      <view class="us-empty" wx:else><text>近期没有明显热度突出的美股。</text></view>
    </block>
  </view>

  <!-- A股收息：「分红稳定性/分红收益性」前五。每行一个大指标 + 指标条，
       下方是参考买—参考卖区间条，圆点是现价落在区间里的位置。
       原型demo编了「连续分红N年」，真实数据没有这个字段，换成算出来的稳定性分。 -->
  <view wx:if="{{market === 'a'}}" class="page-card a-card">
    <view class="a-tabs">
      <view
        class="a-tab {{aSubTab === 'stable' ? 'is-active' : ''}}"
        data-id="stable"
        bindtap="switchASubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{aSubTab === 'stable'}}"
      >分红稳定性</view>
      <view
        class="a-tab {{aSubTab === 'yield' ? 'is-active' : ''}}"
        data-id="yield"
        bindtap="switchASubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{aSubTab === 'yield'}}"
      >分红收益性</view>
    </view>

    <block wx:if="{{aSubTab === 'stable'}}">
      <view class="a-rows" wx:if="{{aStableList.length}}">
        <view
          wx:for="{{aStableList}}"
          wx:key="id"
          class="a-row"
          data-id="{{item.id}}"
          bindtap="openADetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，第{{item.rank}}名，{{item.metricLabel}}{{item.metricText}}{{item.metricUnit}}"
        >
          <view class="a-row-top">
            <text class="a-rank">{{item.rank}}</text>
            <view class="a-row-main">
              <view class="a-name-row">
                <text class="a-stock-name">{{item.name}}</text>
                <text class="a-badge tone-{{item.tone}}">{{item.badgeText}}</text>
              </view>
              <text class="a-code">{{item.code}}</text>
            </view>
            <view class="a-metric">
              <view class="a-metric-num">
                <text class="a-metric-value">{{item.metricText}}</text>
                <text class="a-metric-unit" wx:if="{{item.metricUnit}}">{{item.metricUnit}}</text>
              </view>
              <view class="a-metric-track"><view class="a-metric-fill" style="width: {{item.metricBar}}%;"></view></view>
            </view>
          </view>
          <view class="a-ladder" wx:if="{{item.hasPricePos}}">
            <view class="a-ladder-side">
              <text class="a-ladder-k">参考买</text>
              <text class="a-ladder-v is-buy">{{item.buyText}}</text>
            </view>
            <view class="a-ladder-mid">
              <text class="a-ladder-now zone-{{item.priceZone}}" style="left: {{item.priceLabelPos}}%;">现价 {{item.priceText}}</text>
              <view class="a-ladder-track">
                <view class="a-ladder-dot zone-{{item.priceZone}}" style="left: {{item.pricePos}}%;"></view>
              </view>
            </view>
            <view class="a-ladder-side is-right">
              <text class="a-ladder-k">参考卖</text>
              <text class="a-ladder-v is-sell">{{item.sellText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="a-empty" wx:else><text>分红稳定性榜单暂不足以显示。</text></view>
    </block>

    <block wx:if="{{aSubTab === 'yield'}}">
      <view class="a-rows" wx:if="{{aYieldList.length}}">
        <view
          wx:for="{{aYieldList}}"
          wx:key="id"
          class="a-row"
          data-id="{{item.id}}"
          bindtap="openADetail"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，第{{item.rank}}名，{{item.metricLabel}}{{item.metricText}}{{item.metricUnit}}"
        >
          <view class="a-row-top">
            <text class="a-rank">{{item.rank}}</text>
            <view class="a-row-main">
              <view class="a-name-row">
                <text class="a-stock-name">{{item.name}}</text>
                <text class="a-badge tone-{{item.tone}}">{{item.badgeText}}</text>
              </view>
              <text class="a-code">{{item.code}}</text>
            </view>
            <view class="a-metric">
              <view class="a-metric-num">
                <text class="a-metric-value">{{item.metricText}}</text>
                <text class="a-metric-unit" wx:if="{{item.metricUnit}}">{{item.metricUnit}}</text>
              </view>
              <view class="a-metric-track"><view class="a-metric-fill" style="width: {{item.metricBar}}%;"></view></view>
            </view>
          </view>
          <view class="a-ladder" wx:if="{{item.hasPricePos}}">
            <view class="a-ladder-side">
              <text class="a-ladder-k">参考买</text>
              <text class="a-ladder-v is-buy">{{item.buyText}}</text>
            </view>
            <view class="a-ladder-mid">
              <text class="a-ladder-now zone-{{item.priceZone}}" style="left: {{item.priceLabelPos}}%;">现价 {{item.priceText}}</text>
              <view class="a-ladder-track">
                <view class="a-ladder-dot zone-{{item.priceZone}}" style="left: {{item.pricePos}}%;"></view>
              </view>
            </view>
            <view class="a-ladder-side is-right">
              <text class="a-ladder-k">参考卖</text>
              <text class="a-ladder-v is-sell">{{item.sellText}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="a-empty" wx:else><text>分红收益性榜单暂不足以显示。</text></view>
    </block>

    <!-- 红利 ETF：现价 + 今日 + 90 日走势线，跟踪指数和费率缩成一行小字。 -->
    <view class="a-fund-card" wx:if="{{aFund}}">
      <view class="a-row-between">
        <view class="a-row-name-wrap">
          <text class="a-stock-name">{{aFund.name}}</text>
          <text class="a-code">{{aFund.code}}</text>
        </view>
        <text class="a-badge tone-caution">{{aFund.badgeText}}</text>
      </view>
      <view class="a-fund-figure">
        <text class="a-fund-price">{{aFund.priceText}}</text>
        <text class="a-fund-change is-{{aFund.changeTone}}">{{aFund.changeText}}</text>
        <text wx:if="{{aFund.hasSpark}}" class="a-fund-period is-{{aFund.sparkTone}}">近{{aFund.sparkDays}}日 {{aFund.sparkChangeText}}</text>
      </view>
      <image wx:if="{{aFund.hasSpark}}" class="a-fund-spark" src="{{aFund.sparkSrc}}" mode="scaleToFill" aria-hidden="true"></image>
      <view class="a-fund-stats">
        <text wx:for="{{aFund.stats}}" wx:key="label" class="a-fund-stat"><text class="a-fund-stat-k">{{item.label}}</text> {{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 黄金追踪按原型忠实复刻：币种切换 + 观察区/走势图 + 拐点判断两块面板。
       原型默认币种是人民币金，这里改成国际金——国际金有180天真实收盘价能画
       走势图，人民币金只有2天真实数据画不出图，让用户先看数据撑得起的口径。
       走势图沿用详情页 line-chart 的 Canvas 2D 曲线画法（WXML 没有原生 svg），
       比柱状图更直观地看出价格连续变化的方向。 -->
  <view wx:if="{{market === 'gold'}}" class="page-card gold-card">
    <view class="gold-quotes">
      <view
        wx:for="{{goldQuotes}}"
        wx:key="id"
        class="gold-quote-button {{goldCurrency === item.id ? 'is-active' : ''}}"
        data-currency="{{item.id}}"
        bindtap="switchGoldCurrency"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{goldCurrency === item.id}}"
      >
        <text class="gold-quote-label">{{item.label}}</text>
        <text class="gold-quote-price">{{item.priceText}}</text>
        <text class="gold-quote-unit">{{item.unit}}</text>
      </view>
    </view>

    <view class="gold-panel">
      <!-- 这块只放价格：走势图 + 价位轴。原来标题叫「现在怎么做」、角标写「仍在观察低位」，
           跟顶上结论「等待更好价格」像两个答案；动作只在结论说一次，这里只说价格。 -->
      <view class="gold-row-between">
        <text class="gold-headline">金价走势</text>
      </view>
      <view class="gold-row-sub">
        <text wx:if="{{goldChart}}" class="gold-change is-{{goldChart.changeTone}}">{{goldChart.changeText}}</text>
        <text wx:else class="gold-currency-label">{{goldCurrencyLabel}}</text>
        <view class="gold-periods" wx:if="{{goldPeriods.length}}">
          <text
            wx:for="{{goldPeriods}}"
            wx:key="id"
            class="gold-period {{goldPeriod === item.id ? 'is-active' : ''}}"
            data-period="{{item.id}}"
            bindtap="switchGoldPeriod"
            hover-class="tap-active"
            aria-role="button"
            aria-selected="{{goldPeriod === item.id}}"
          >{{item.label}}</text>
        </view>
      </view>

      <view wx:if="{{goldChart}}" class="gold-chart">
        <canvas type="2d" id="{{goldChart.canvasId}}" class="gold-chart-canvas"></canvas>
        <view class="gold-chart-labels">
          <text>{{goldChart.lowLabel}}</text>
          <text>{{goldChart.latestLabel}}</text>
          <text>{{goldChart.highLabel}}</text>
        </view>
      </view>
      <text wx:else class="gold-chart-empty">{{goldChartNote}}</text>

      <!-- 研究价位轴：红线=风险下沿，绿段=观察低位，琥珀段=观察上沿，圆点=现价 -->
      <view class="gold-ladder" wx:if="{{goldLadder}}">
        <view class="gold-ladder-axis">
          <text class="gold-ladder-now tone-{{goldZoneTone}}" style="left: {{goldLadder.priceLabelLeft}}%;">现价 {{goldLadder.priceText}}</text>
          <view class="gold-ladder-track">
            <view class="gold-ladder-band is-watch" style="left: {{goldLadder.watchLeft}}%; width: {{goldLadder.watchWidth}}%;"></view>
            <view class="gold-ladder-band is-upper" style="left: {{goldLadder.upperLeft}}%; width: {{goldLadder.upperWidth}}%;"></view>
            <view wx:if="{{goldLadder.hasRisk}}" class="gold-ladder-risk" style="left: {{goldLadder.riskLeft}}%;"></view>
            <view class="gold-ladder-dot tone-{{goldZoneTone}}" style="left: {{goldLadder.priceLeft}}%;"></view>
          </view>
        </view>
        <view class="gold-ladder-legend">
          <view wx:for="{{goldLadder.tiles}}" wx:key="key" class="gold-ladder-key is-{{item.key}}">
            <view class="gold-ladder-key-head">
              <view class="gold-ladder-swatch"></view>
              <text class="gold-ladder-key-label">{{item.label}}</text>
            </view>
            <text class="gold-ladder-key-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 6 个宏观指标和「均线上穿/下穿」那段话原来也摆在这里，读起来全是术语；
         2026-09-29 按产品要求挪回黄金详情页（buildGoldView 里本来就有），
         这一栏只留金价、走势和买卖区间，再给一个进详情的口子。 -->
    <view
      class="gold-detail-link"
      bindtap="openInsightTarget"
      hover-class="tap-active"
      aria-role="button"
      aria-label="查看黄金宏观指标与拐点"
    >
      <text>更多指标 ›</text>
    </view>
  </view>

  <!-- 机构持仓原来把「今日答案/分组浏览/策略摘要/数据出处」摞进顶部四个 tab，
       想看共同方向/机构持仓这些核心内容得先点「分组浏览」再多点一次子tab。
       现在只有机构持仓栏目还用这套内容，直接摆成竖直顺序：今日答案在最前，
       中间是共同方向/机构持仓/持仓走势主内容，策略摘要与数据出处收进底部
       可展开区域——落地就看到该看的，不用先选 tab。 -->

  <!-- 今日答案：原来是横向卡片，得滑动才看得全，还看不出到底有几张。
       改成竖排一条接一条的列表，条数一眼看完，问题本身没有减少，
       只是不再靠滑动才能发现内容。 -->
  <view wx:if="{{market !== 'hk' && market !== 'us' && market !== 'a' && market !== 'gold' && answers.length}}" class="page-card answer-panel">
    <view class="answer-head">
      <text class="answer-title">今日答案</text>
    </view>
    <view class="answer-track">
      <view
        wx:for="{{answers}}"
        wx:key="id"
        class="answer-card tone-{{item.tone}} {{item.enabled ? '' : 'is-empty'}}"
        data-id="{{item.id}}"
        bindtap="openAnswer"
        hover-class="{{item.enabled ? 'tap-active' : ''}}"
        aria-role="button"
        aria-label="{{item.question}}，{{item.answer}}{{item.hint ? '。' + item.hint : ''}}"
      >
        <text class="answer-card-q">{{item.question}}</text>
        <text class="answer-card-a">{{item.chart.headline || item.answer}}</text>
        <!-- 聪明钱四张卡带小图：持仓占比、几家在加/减是横条，增持/减持/退出是一根分段条。
             有图就不再印名单那一行，完整名单点开看。 -->
        <view wx:if="{{item.chart.kind === 'bars'}}" class="answer-bars">
          <view wx:for="{{item.chart.items}}" wx:for-item="bar" wx:key="key" class="answer-bar-row">
            <text class="answer-bar-label">{{bar.label}}</text>
            <view class="answer-bar-track"><view class="answer-bar-fill" style="width: {{bar.width}}%"></view></view>
            <text class="answer-bar-value">{{bar.valueText}}</text>
          </view>
        </view>
        <view wx:if="{{item.chart.kind === 'mix'}}" class="answer-mix">
          <view class="answer-mix-track">
            <view wx:for="{{item.chart.items}}" wx:for-item="seg" wx:key="key" class="answer-mix-seg {{seg.tone}}" style="width: {{seg.width}}%"></view>
          </view>
          <view class="answer-mix-legend">
            <view wx:for="{{item.chart.items}}" wx:for-item="seg" wx:key="key" class="answer-mix-key">
              <view class="answer-mix-dot {{seg.tone}}"></view>
              <text class="answer-mix-label">{{seg.label}}</text>
              <text class="answer-mix-count">{{seg.countText || seg.count}}</text>
            </view>
          </view>
        </view>
        <!-- 排行榜、最热三只这类答案本身就是表：名次、依据、参考买、参考卖各占一列，
             比「甲 · 乙 · 丙 · 丁 · 戊」一行流水账好读，也省掉一次点开展开层。 -->
        <view wx:if="{{item.rows}}" class="answer-table">
          <view wx:if="{{item.rows.head.length}}" class="answer-tr answer-th">
            <text wx:for="{{item.rows.head}}" wx:for-item="col" wx:key="index" class="answer-td">{{col}}</text>
          </view>
          <block wx:for="{{item.rows.body}}" wx:for-item="row" wx:key="key">
            <view class="answer-tr {{row.tone ? 'row-' + row.tone : ''}}">
              <text wx:for="{{row.cells}}" wx:for-item="cell" wx:key="index" class="answer-td">{{cell}}</text>
            </view>
            <text wx:if="{{row.note}}" class="answer-tnote">{{row.note}}</text>
          </block>
        </view>
        <!-- namesLine 而不是 names：这一行的名字要是已经整句写在答案里了
             （「特斯拉 $368.20」下面再印一行「特斯拉」），就不再印第二遍。 -->
        <text wx:if="{{item.namesLine && !item.chart}}" class="answer-card-names">{{item.namesLine}}</text>
        <text wx:if="{{item.hint}}" class="answer-card-hint">{{item.hint}}</text>
        <!-- 空卡的答案句本身就写着「暂无值得打的新股」，底下再印一行「暂无内容」
             是同一件事说两遍。没有可点的东西时这一行整条不印。 -->
        <text wx:if="{{item.enabled}}" class="answer-card-foot">{{item.modal ? '展开 ›' : '查看 ›'}}</text>
      </view>
    </view>
  </view>

  <!-- 分组入口：原来「历史样本对照」单独一块、下面分组列表里的「已结束」又是
       一整行，两个点开是同一张列表页。改成一张网格，两边数据各来一份卡片，
       已经被历史样本卡覆盖的分组不再重复出现（在 index.js 里按目的地去重）。 -->
  <view wx:if="{{market !== 'hk' && market !== 'us' && market !== 'a' && market !== 'gold' && market !== 'guru' && (deepLinks.length || groups.length)}}" hidden="{{activeTab !== 'groups'}}" class="page-card tile-panel">
    <view class="tile-grid">
      <view
        wx:for="{{deepLinks}}"
        wx:key="id"
        class="tile-card {{item.enabled ? '' : 'is-empty'}}"
        data-group="{{item.group}}"
        data-enabled="{{item.enabled}}"
        bindtap="openDeepLink"
        hover-class="{{item.enabled ? 'tap-active' : ''}}"
        aria-role="button"
        aria-disabled="{{item.enabled ? 'false' : 'true'}}"
        aria-label="{{item.title}}，{{item.help}}"
      >
        <image class="tile-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="tile-body">
          <text class="tile-title">{{item.title}}</text>
          <text class="tile-help">{{item.help}}</text>
        </view>
      </view>
      <view
        wx:for="{{groups}}"
        wx:key="id"
        class="tile-card tone-{{item.id}} {{item.count ? '' : 'is-empty'}}"
        data-group="{{item.id}}"
        bindtap="openGroup"
        hover-class="{{item.count ? 'tap-active' : ''}}"
        aria-role="button"
        aria-disabled="{{item.count ? 'false' : 'true'}}"
        aria-label="{{item.title}}，{{item.one}}，{{item.count ? item.count + ' 项' : '暂无'}}"
      >
        <image class="tile-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="tile-body">
          <view class="tile-head">
            <text class="tile-title">{{item.title}}</text>
            <text class="tile-count">{{item.count}}项</text>
          </view>
          <text class="tile-help">{{item.one}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 机构持仓按原型忠实复刻：共同方向（跨机构加减仓聚合）+ 机构持仓（单家重仓
       前五）两个子tab。原型「本期变化」列在其虚构数据里其实是买卖方向，我们的
       changeLabel 字段是披露口径（月报/季度/半年报持有），语义不同，这里如实
       显示成普通文字，不套颜色徽章暗示涨跌方向。 -->
  <view wx:if="{{market === 'guru'}}" class="page-card guru-card">
    <view class="a-tabs">
      <view
        class="a-tab {{guruSubTab === 'trend' ? 'is-active' : ''}}"
        data-id="trend"
        bindtap="switchGuruSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{guruSubTab === 'trend'}}"
      >共同方向</view>
      <view
        class="a-tab {{guruSubTab === 'holdings' ? 'is-active' : ''}}"
        data-id="holdings"
        bindtap="switchGuruSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{guruSubTab === 'holdings'}}"
      >机构持仓</view>
      <view
        class="a-tab {{guruSubTab === 'history' ? 'is-active' : ''}}"
        data-id="history"
        bindtap="switchGuruSubTab"
        hover-class="tap-active"
        aria-role="button"
        aria-selected="{{guruSubTab === 'history'}}"
      >持仓走势</view>
    </view>

    <block wx:if="{{guruSubTab === 'trend'}}">
      <!-- 共同方向条形图直接展开：条长 = 同向机构数，颜色 = 加/减方向。 -->
      <text class="hk-picker-label">本季共同方向</text>
      <view class="guru-bars-body">
        <block wx:if="{{guruTrendRows.length}}">
          <block wx:for="{{guruTrendRows}}" wx:key="key">
            <view class="guru-direction">
              <text>{{item.label}}</text>
              <text class="a-badge tone-{{item.tone}}">{{item.badge}}</text>
            </view>
            <view class="guru-bar-track">
              <view class="guru-bar-fill tone-{{item.tone}}" style="width: {{item.widthPct}}%;"></view>
            </view>
          </block>
        </block>
        <view class="a-empty" wx:else><text>本季暂无 2 家以上同向信号</text></view>
      </view>

      <text class="hk-picker-label">跟着谁看</text>
      <view class="guru-institution-list">
        <view
          wx:for="{{guruInstitutionListShown}}"
          wx:key="id"
          class="guru-institution-row"
          data-id="{{item.id}}"
          bindtap="switchGuruInstitution"
          hover-class="tap-active"
          aria-role="button"
          aria-label="{{item.name}}，{{item.org}}{{item.hasPerf ? '，年化约 ' + item.perfText : ''}}"
        >
          <text wx:if="{{item.tag}}" class="guru-mkt">{{item.tag}}</text>
          <view class="guru-institution-copy">
            <text class="guru-institution-name">{{item.name}}</text>
            <text class="guru-institution-org">{{item.org}}</text>
          </view>
          <view wx:if="{{item.hasPerf}}" class="guru-perf">
            <text class="guru-perf-v">{{item.perfText}}</text>
            <text class="guru-perf-k">年化</text>
          </view>
          <text class="arrow">›</text>
        </view>
        <view
          wx:if="{{!guruInstitutionExpanded && guruInstitutionList.length > guruInstitutionListShown.length}}"
          class="guru-institution-row guru-institution-more"
          bindtap="toggleGuruInstitutionMore"
          hover-class="tap-active"
          aria-role="button"
          aria-label="展开其余机构"
        >
          <view class="guru-institution-copy">
            <text class="guru-institution-name guru-institution-more-text">展开其余 {{guruInstitutionList.length - guruInstitutionListShown.length}} 家</text>
          </view>
          <text class="arrow">›</text>
        </view>
        <view
          class="guru-institution-row"
          data-group="overlap"
          data-enabled="true"
          bindtap="openDeepLink"
          hover-class="tap-active"
          aria-role="button"
          aria-label="交叉重叠，多机构共同持有"
        >
          <view class="guru-institution-copy">
            <text class="guru-institution-name">交叉重叠</text>
            <text class="guru-institution-org">多机构共同持有</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </block>

    <block wx:if="{{guruSubTab === 'holdings'}}">
      <block wx:if="{{guruInstitutionList.length}}">
        <text class="hk-picker-label">选择机构</text>
        <picker
          class="hk-picker"
          mode="selector"
          range="{{guruInstitutionList}}"
          range-key="name"
          value="{{guruInstitutionIndex}}"
          bindchange="selectGuruInstitution"
        >
          <view class="hk-picker-value">
            <text>{{guruInstitutionName}}</text>
            <text class="hk-picker-caret">▾</text>
          </view>
        </picker>

        <!-- 报告期 / 披露日 / 来源 / 可靠度 四格一排，代替三行说明文字。 -->
        <view class="guru-stats" wx:if="{{guruHoldingStats.length}}">
          <view wx:for="{{guruHoldingStats}}" wx:key="label" class="guru-stat">
            <text class="guru-stat-k">{{item.label}}</text>
            <text class="guru-stat-v">{{item.value}}</text>
          </view>
        </view>

        <!-- 占比画成横条（按本家第一大仓位归一），加仓绿、减仓红。 -->
        <view class="guru-holds" wx:if="{{guruHoldingsRowsShown.length}}">
          <view class="guru-holds-head">
            <text>{{guruHoldingsHint}}</text>
            <text>占组合</text>
          </view>
          <view wx:for="{{guruHoldingsRowsShown}}" wx:key="name" class="guru-hold">
            <view class="guru-hold-top">
              <text class="guru-hold-name">{{item.name}}</text>
              <text class="guru-hold-move {{item.moveTone ? 'tone-' + item.moveTone : ''}}">{{item.moveText}}</text>
              <text class="guru-hold-weight">{{item.weightText}}</text>
            </view>
            <view class="guru-hold-track">
              <view class="guru-hold-fill" style="width: {{item.weightBar}}%;"></view>
            </view>
          </view>
          <view
            wx:if="{{!guruHoldingsExpanded && guruHoldingsRows.length > guruHoldingsRowsShown.length}}"
            class="guru-holdings-more"
            bindtap="toggleGuruHoldingsMore"
            hover-class="tap-active"
            aria-role="button"
            aria-label="展开其余持仓"
          >
            <text class="guru-institution-more-text">展开其余 {{guruHoldingsRows.length - guruHoldingsRowsShown.length}} 项</text>
          </view>
        </view>
        <view class="a-empty" wx:else><text>暂无持仓披露</text></view>
      </block>
      <view class="a-empty" wx:else><text>机构样本待更新。</text></view>
    </block>

    <block wx:if="{{guruSubTab === 'history'}}">
      <block wx:if="{{guruInstitutionList.length}}">
        <text class="hk-picker-label">选择机构</text>
        <picker
          class="hk-picker"
          mode="selector"
          range="{{guruInstitutionList}}"
          range-key="name"
          value="{{guruInstitutionIndex}}"
          bindchange="selectGuruInstitution"
        >
          <view class="hk-picker-value">
            <text>{{guruInstitutionName}}</text>
            <text class="hk-picker-caret">▾</text>
          </view>
        </picker>

        <view class="a-hint" wx:if="{{guruHistoryHint}}"><text>{{guruHistoryHint}}</text></view>

        <view wx:if="{{guruHistoryChart}}" class="guru-history-chart">
          <view class="guru-history-bars">
            <view wx:for="{{guruHistoryChart.columns}}" wx:for-item="col" wx:key="id" class="guru-history-slot">
              <view class="guru-history-bar {{col.tone}}" style="height: {{col.height}}%;"></view>
            </view>
          </view>
          <view class="guru-history-ticks">
            <text wx:for="{{guruHistoryChart.columns}}" wx:for-item="col" wx:key="id" class="guru-history-tick">{{col.label}}</text>
          </view>
          <view class="guru-history-labels">
            <text>{{guruHistoryChart.lowLabel}}</text>
            <text>{{guruHistoryChart.latestLabel}}</text>
            <text>{{guruHistoryChart.highLabel}}</text>
          </view>
        </view>
        <view class="a-empty" wx:else><text>{{guruHistoryChartEmptyText}}</text></view>

        <view class="a-table" wx:if="{{guruHistoryRowsData.length}}">
          <view class="a-table-head">
            <text class="a-col-name">报告期</text>
            <text class="a-col-metric">持仓规模</text>
            <text class="guru-col-move">较上期</text>
          </view>
          <view wx:for="{{guruHistoryRowsData}}" wx:for-item="row" wx:key="key" class="a-table-row">
            <view class="a-col-name"><text class="a-stock-name">{{row.period}}</text></view>
            <text class="a-col-metric">{{row.valueText}}</text>
            <text class="guru-col-move">{{row.moveText}}</text>
          </view>
        </view>
      </block>
      <view class="a-empty" wx:else><text>机构样本待更新。</text></view>
    </block>
  </view>

  <!-- 策略摘要（7条大师打法）和数据出处（栏目来源链接）不是这一栏要立刻看到的
       东西——核心是上面共同方向/机构持仓/持仓走势。收进底部可展开区域，
       默认收起，想看的人自己点开，不占首屏。 -->
  <view wx:if="{{market === 'guru' && (playbooks.length || sourceLinks.length)}}" class="page-card guru-more-panel">
    <view
      class="a-details-toggle guru-more-toggle"
      bindtap="toggleGuruMore"
      hover-class="tap-active"
      aria-role="button"
      aria-label="策略摘要与数据出处"
      aria-expanded="{{guruMoreOpen}}"
    >
      <text>策略摘要与数据出处</text>
      <text>{{guruMoreOpen ? '−' : '+'}}</text>
    </view>
    <view wx:if="{{guruMoreOpen}}" class="guru-more-body">
      <view wx:if="{{playbooks.length}}" class="playbook-head">
        <text class="playbook-title">大师策略摘要</text>
        <text class="playbook-meta">只学方法，不照抄仓位</text>
      </view>
      <view
        wx:for="{{playbooks}}"
        wx:key="id"
        class="playbook-row"
        data-id="{{item.id}}"
        bindtap="openPlaybook"
        hover-class="tap-active"
        aria-role="button"
        aria-label="{{item.name}}，{{item.tag}}"
      >
        <view class="playbook-copy">
          <view class="playbook-title-row">
            <text class="playbook-name">{{item.name}}</text>
            <text class="playbook-tag">{{item.tag}}</text>
          </view>
          <text class="playbook-principle">{{item.principle}}</text>
        </view>
        <text class="arrow">›</text>
      </view>

      <view wx:if="{{sourceLinks.length}}" class="source-head">
        <text class="source-title">数据出处</text>
        <text class="source-meta">点一条复制走自行核对</text>
      </view>
      <view
        wx:for="{{sourceLinks}}"
        wx:key="url"
        class="source-link-row"
        data-url="{{item.url}}"
        bindtap="copySourceLink"
        hover-class="tap-active"
        aria-role="button"
        aria-label="复制 {{item.name}} 的链接"
      >
        <text class="source-link-name">{{item.name}}</text>
        <text class="source-link-action">复制链接</text>
      </view>
    </view>
  </view>

  <view class="page-note">
    <text>{{disclaimer}}</text>
  </view>

  <view wx:if="{{answerSheet}}" class="answer-mask" bindtap="closeAnswerSheet" catchtouchmove="true">
    <view class="answer-sheet" catchtap="noop">
      <view class="answer-sheet-head">
        <text class="answer-sheet-title">{{answerSheet.title}}</text>
        <view class="answer-sheet-close" role="button" aria-label="关闭" bindtap="closeAnswerSheet">关闭</view>
      </view>
      <view class="answer-sheet-body">
        <block wx:for="{{answerSheet.lines}}" wx:key="key">
          <view wx:if="{{item.blank}}" class="answer-sheet-gap"></view>
          <text wx:elif="{{item.sub}}" class="answer-sheet-sub">{{item.text}}</text>
          <text wx:else class="answer-sheet-line">{{item.text}}</text>
        </block>
      </view>
      <view wx:if="{{answerSheet.confirmLabel}}" class="answer-sheet-foot">
        <view class="answer-sheet-confirm" role="button" bindtap="confirmAnswerSheet">{{answerSheet.confirmLabel}}</view>
      </view>
    </view>
  </view>

