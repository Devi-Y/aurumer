.gold-badge.tone-worth { background: #dcf0e4; color: #0b7a53; }
.gold-badge.tone-caution { background: #f7e9c9; color: #8b5b20; }
.gold-badge.tone-avoid { background: #f6dad4; color: #a33b2b; }

.gold-currency-label {
  color: #7a847e;
  font-size: 22rpx;
}

.gold-periods {
  display: flex;
  gap: 6rpx;
}

.gold-period {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f8f6;
  color: #6a746e;
  font-size: 21rpx;
  font-weight: 600;
}

.gold-period.is-active {
  background: #eef8f2;
  color: #0b7a53;
}

.gold-chart {
  margin-top: 16rpx;
}

.gold-chart-bars {
  display: flex;
  height: 200rpx;
  padding: 12rpx 8rpx 0;
  align-items: flex-end;
  gap: 3rpx;
  border-bottom: 1rpx solid #d7e3db;
  border-radius: 12rpx 12rpx 0 0;
  background: #f7faf8;
}

.gold-chart-slot {
  display: flex;
  height: 100%;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
  justify-content: center;
}

.gold-chart-bar {
  width: 86%;
  min-height: 8rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #2fba78;
}

.gold-chart-bar.latest { background: #0b7a53; }
.gold-chart-bar.peak { background: #d99a12; }
.gold-chart-bar.floor { background: #7eb89a; }

.gold-chart-labels {
  display: flex;
  margin-top: 8rpx;
  justify-content: space-between;
  gap: 8rpx;
  color: #7a847e;
  font-size: 22rpx;
}

.gold-chart-labels text:nth-child(2) { color: #0b7a53; font-weight: 700; text-align: center; }
.gold-chart-labels text:last-child { text-align: right; }

.gold-chart-empty {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f4f8f6;
  color: #9aa19c;
  font-size: 22rpx;
  line-height: 1.5;
}

.gold-zone-grid {
  display: flex;
  margin-top: 16rpx;
  gap: 12rpx;
}

.gold-zone {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #eef8f2;
}

.gold-zone.warn {
  background: #fdf3e3;
}

.gold-zone-label {
  display: block;
  color: #6a746e;
  font-size: 21rpx;
}

.gold-zone-value {
  display: block;
  margin-top: 6rpx;
  color: #0b7a53;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.gold-zone.warn .gold-zone-value {
  color: #8b5b20;
}

.gold-risk-line {
  display: block;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #eef8f2;
  color: #1b211d;
  font-size: 25rpx;
  line-height: 1.5;
}

.gold-trend-line {
  display: flex;
  margin-top: 16rpx;
  align-items: flex-start;
  gap: 12rpx;
}

.gold-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  background: #9aa19c;
}

.gold-dot.tone-worth { background: #0b7a53; }
.gold-dot.tone-caution { background: #d99a12; }
.gold-dot.tone-avoid { background: #a33b2b; }

.gold-trend-body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.gold-trend-title {
  color: #1b211d;
  font-size: 26rpx;
  font-weight: 680;
}

.gold-trend-detail {
  color: #7a847e;
  font-size: 22rpx;
  line-height: 1.5;
}

.gold-details {
  margin-top: 14rpx;
  padding-top: 4rpx;
  border-top: 1rpx solid #edf0ee;
}

.gold-details-toggle {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: space-between;
  color: #0b7a53;
  font-size: 25rpx;
  font-weight: 600;
}

.gold-details-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 10rpx;
}

.gold-details-body text {
  color: #8a938d;
  font-size: 22rpx;
  line-height: 1.55;
}
