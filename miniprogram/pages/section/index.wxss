.section-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f6f7;
}

.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1a1d22;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #696d75;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #edf2fb; border-color: #d7dfeb; }
.freshness-banner.tone-warn { background: #fff7ec; border-color: #f0e0c8; }
.freshness-banner.tone-bad { background: #fdf0ee; border-color: #f0d5cf; }

/* 页头绿带。和新闻资讯页同一套：负的左右外边距把带子顶到屏宽，
   .section-shell 自己那 20rpx 的边留给下面的卡片继续用。 */
.section-hero {
  margin: -20rpx -20rpx 0;
  padding: 18rpx 24rpx 40rpx;
  background: linear-gradient(165deg, #2466d6 0%, #1d5fd1 55%, #174ea9 100%);
}

.hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 结论与关键数值那张卡向上压住绿带下沿。 */
.hero-body {
  position: relative;
  z-index: 1;
  margin-top: -22rpx;
}

.hero-metrics {
  display: flex;
  padding: 16rpx 18rpx 18rpx;
}

/* 结论行在的时候，两块之间才需要那道分隔线。 */
.insight-panel + .hero-metrics {
  padding-top: 16rpx;
  border-top: 1rpx solid #edeef0;
}

.hero-metric {
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  padding: 8rpx 10rpx;
  flex-direction: column;
  align-items: center;
  border-radius: 14rpx;
  text-align: center;
}

.hero-metric + .hero-metric { border-left: 1rpx solid #edeef0; }

.hero-metric.is-disabled {
  opacity: 0.55;
}

.metric-tap {
  background: #edf2fb;
}

.hero-metric text:first-child {
  overflow: hidden;
  max-width: 100%;
  color: #7d8188;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-metric text:last-child {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #304261;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-panel {
  padding: 18rpx 24rpx 0;
}

/* 港股栏目页把「在售/值得打」两格挪进了今日答案卡片，只剩结论行，
   这时候结论行自己要补上下边距——原来这道边距是靠后面的 .hero-metrics
   兜底的，它不出现的市场不能跟着一起没了留白。 */
.insight-panel:last-child {
  padding-bottom: 18rpx;
}

.answer-panel {
  margin-top: 14rpx;
}

.answer-head {
  display: flex;
  min-height: 56rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid #edeef0;
}

.answer-title {
  color: #1a1d22;
  font-size: 28rpx;
  font-weight: 700;
}

/* 今日答案竖排卡片，一条接一条往下排，不用滑动就能看全。每张卡内容
   按需长高，不裁剪——hint 那行有时候是唯一一处合规边界文字（比如暗盘卡
   在没有在售新股时既没有展开层也没有别处能看到这句话），裁掉等于把
   免责声明删了，只能让卡片自己变高。 */
.answer-track {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx 8rpx;
}

/* 4 条今日答案原来各自一张卡（边框+圆角+底色），卡中卡看着比实际内容
   更复杂。合并成一张卡内的 4 行摘要，行间用分隔线，和下面
   .guru-institution-row 一个路数——点开详情的 openAnswer 行为不变。 */
.answer-card {
  box-sizing: border-box;
  display: flex;
  width: 100%;
  flex-direction: column;
  padding: 18rpx 2rpx;
  border-bottom: 1rpx solid #edeef0;
}

.answer-card:last-child {
  padding-bottom: 4rpx;
  border-bottom: none;
}

.answer-card.is-empty {
  opacity: 0.6;
}

.answer-card-q {
  display: block;
  color: #656971;
  font-size: 23rpx;
  font-weight: 560;
}

.answer-card-a {
  display: block;
  margin-top: 8rpx;
  color: #1a1d22;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.answer-card-names {
  display: block;
  margin-top: 6rpx;
  color: #656971;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ---------- 卡内小图：聪明钱的横条和分段条 ---------- */

.answer-bars {
  display: flex;
  margin-top: 12rpx;
  flex-direction: column;
  gap: 10rpx;
}

.answer-bar-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.answer-bar-label {
  flex: 0 0 190rpx;
  overflow: hidden;
  color: #4a505a;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.answer-bar-track {
  position: relative;
  height: 14rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf0f4;
}

.answer-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #1d5fd1;
}

.answer-bar-value {
  flex: 0 0 76rpx;
  color: #1a1f27;
  font-size: 22rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.answer-mix {
  margin-top: 14rpx;
}

.answer-mix-track {
  display: flex;
  height: 18rpx;
  overflow: hidden;
  gap: 4rpx;
  border-radius: 999rpx;
}

.answer-mix-seg {
  height: 100%;
}

.answer-mix-seg.add,
.answer-mix-dot.add { background: #1d5fd1; }

.answer-mix-seg.cut,
.answer-mix-dot.cut { background: #8fb0e8; }

.answer-mix-seg.exit,
.answer-mix-dot.exit { background: #c9ced6; }

.answer-mix-legend {
  display: flex;
  margin-top: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx 28rpx;
}

.answer-mix-key {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.answer-mix-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

.answer-mix-label {
  color: #8a929e;
  font-size: 22rpx;
}

.answer-mix-count {
  color: #1a1f27;
  font-size: 24rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ---------- 卡内小表：前五名单、最热三只 ---------- */

.answer-table {
  display: flex;
  margin-top: 12rpx;
  overflow: hidden;
  flex-direction: column;
  border-radius: 12rpx;
  background: #ffffff;
}

.answer-tr {
  display: flex;
  min-height: 56rpx;
  align-items: center;
  padding: 8rpx 12rpx;
  border-bottom: 1rpx solid #eeeff3;
  /* 到价那行左边加一条色带，行本身不整片染色——五行里一行是重点，
     整片染色会把表读成两张表。没到价的行 border 透明，列不会错位。 */
  border-left: 5rpx solid transparent;
}

.answer-tr:last-child {
  border-bottom: none;
}

.answer-th {
  background: #f4f5f7;
  color: #898d94;
  font-size: 20rpx;
  font-weight: 600;
}

.answer-td {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #292d33;
  font-size: 23rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  /* 参考买 / 参考卖 上下要对得齐，等宽数字比默认字距靠谱。 */
  font-variant-numeric: tabular-nums;
}

/* 第一列是标的名，左对齐并且给它多一点宽度——"陕西煤业"四个字加名次
   在等分列里会被切成"1 陕西煤…"。 */
.answer-td:first-child {
  flex: 1.5;
  color: #1a1d22;
  font-weight: 620;
  text-align: left;
}

.answer-tr.row-good { border-left-color: #1d5fd1; }
.answer-tr.row-warn { border-left-color: #b45309; }
.answer-tr.row-bad { border-left-color: #c4473a; }

.answer-tr.row-good .answer-td:first-child { color: #1d5fd1; }
.answer-tr.row-warn .answer-td:first-child { color: #8b5b20; }
.answer-tr.row-bad .answer-td:first-child { color: #a33b2b; }

/* 「为什么火热」挂在自己那一行下面，跨满整行——它是一句话，塞进列里
   会被截成"成交是平时的 2.3…"，等于没写。 */
.answer-tnote {
  display: block;
  padding: 0 12rpx 10rpx 17rpx;
  border-bottom: 1rpx solid #eeeff3;
  background: #ffffff;
  color: #7e8288;
  font-size: 20rpx;
  line-height: 1.45;
}

.answer-tnote:last-child {
  border-bottom: none;
}

/* 边界文字：比正文再轻一档，但常驻不折叠——它说的是「这句话不能当成什么」，
   不能因为卡片要做窄就退成要点开才看得到的东西。 */
.answer-card-hint {
  display: block;
  margin-top: 10rpx;
  padding-left: 14rpx;
  border-left: 3rpx solid #d5d9df;
  color: #898d94;
  font-size: 21rpx;
  line-height: 1.45;
}

.answer-card-foot {
  display: block;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edeef0;
  color: #7e8288;
  font-size: 21rpx;
  font-weight: 620;
}

.answer-card.tone-good .answer-card-a { color: #1d5fd1; }
.answer-card.tone-bad .answer-card-a { color: #a33b2b; }
.answer-card.tone-warn .answer-card-a { color: #8b5b20; }

.insight-line {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 14rpx;
}

.insight-label {
  flex: none;
  color: #696e76;
  font-size: 26rpx;
  font-weight: 600;
}

.insight-target {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1a1d22;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-target.is-link {
  color: #1d5fd1;
}

.insight-grade {
  flex: none;
  max-width: 42%;
  padding: 8rpx 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9f0fc;
  color: #1d5fd1;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-tap {
  opacity: 0.72;
}

.section-heading {
  display: flex;
  padding: 24rpx 4rpx 12rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading text:first-child {
  color: #393d44;
  font-size: 30rpx;
  font-weight: 650;
}

.section-heading text:last-child {
  color: #898c92;
  font-size: 24rpx;
}

/* 分组网格：deepLinks 和 groups 两路数据共用同一套卡片样式。港股的
   值得打/暂缓观察/暂不建议本来就有好坏含义（今日答案卡上已经在用同一套
   颜色），这里复用而不是新造判断；发行已取消/已结束和其余市场没有天然
   好坏之分，保持中性底色，不臆造颜色。 */
.tile-panel {
  margin-top: 14rpx;
  padding: 20rpx;
}

.tile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tile-card {
  box-sizing: border-box;
  display: flex;
  width: calc(50% - 7rpx);
  padding: 18rpx 20rpx;
  align-items: flex-start;
  gap: 14rpx;
  border: 1rpx solid #e6e9ed;
  border-radius: 16rpx;
  background: #fafbfc;
}

.tile-card.is-empty { opacity: 0.5; }

/* 落单的最后一格别再半宽晾在那里——凑不成一对就占满整行。 */
.tile-card:nth-child(odd):last-child { width: 100%; }

/* 图标带个浅色圆底，看着像个徽章而不是贴在卡片上的一个小图。 */
.tile-icon {
  box-sizing: border-box;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  padding: 11rpx;
  border-radius: 50%;
  background: #eeeff3;
}

.tile-body {
  min-width: 0;
  flex: 1;
}

.tile-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8rpx;
}

.tile-title {
  display: block;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1a1d22;
  font-size: 27rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tile-count {
  flex: none;
  color: #7e8288;
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

/* 两行截断而不是一行——历史样本对照那张卡的说明是现算的统计句
   （"样本12·首日上涨58.3%·暗盘→首日同向75.0%"），一行经常放不下，
   截没了就等于把这张卡存在的意义（比分组列表更详细）截掉了。 */
.tile-help {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  color: #696d75;
  font-size: 21rpx;
  line-height: 1.4;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tile-card.tone-worth { border-color: #cfd9e8; background: #f1f4f9; }
.tile-card.tone-worth .tile-title { color: #1d5fd1; }
.tile-card.tone-worth .tile-icon { background: #dfe9fa; }
.tile-card.tone-caution { border-color: #ecdcb8; background: #fdf7ec; }
.tile-card.tone-caution .tile-title { color: #8b5b20; }
.tile-card.tone-caution .tile-icon { background: #f7e9c9; }
.tile-card.tone-avoid { border-color: #eccbc3; background: #fdf1ef; }
.tile-card.tone-avoid .tile-title { color: #a33b2b; }
.tile-card.tone-avoid .tile-icon { background: #f6dad4; }

.playbook-head {
  display: flex;
  min-height: 76rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid #edeef0;
}

.playbook-title {
  color: #1a1d22;
  font-size: 28rpx;
  font-weight: 700;
}

.playbook-meta {
  color: #898c92;
  font-size: 22rpx;
}

.playbook-row {
  display: flex;
  min-height: 110rpx;
  padding: 18rpx 24rpx;
  align-items: center;
  gap: 12rpx;
}

.playbook-row + .playbook-row {
  border-top: 1rpx solid #edeef0;
}

.playbook-copy {
  min-width: 0;
  flex: 1;
}

.playbook-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.playbook-name {
  color: #1a1d22;
  font-size: 28rpx;
  font-weight: 650;
}

.playbook-tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eef2fb;
  color: #4256c5;
  font-size: 20rpx;
  font-weight: 600;
}

.playbook-principle {
  display: block;
  margin-top: 6rpx;
  color: #696d75;
  font-size: 23rpx;
  line-height: 1.45;
}

.tap-active { background: #edf2fb; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #898c92;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .section-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .section-hero { margin-right: -14rpx; margin-left: -14rpx; }
  .hero-title { font-size: 36rpx; }
  .hero-metric { padding-right: 6rpx; padding-left: 6rpx; }
  .hero-metric text:last-child { font-size: 28rpx; }
}

@media (min-width: 700px) {
  .section-shell { padding-right: 32px; padding-left: 32px; }
  .section-hero,
  .answer-panel,
  .tile-panel { border-radius: 20px; }
}

/* 数据出处。和新闻资讯页每条下面那行"来源 X · 复制链接"是同一件事，
   只是栏目页一次列全栏目的官方入口，不必每行重复一遍。 */
.source-head {
  display: flex;
  padding: 0 24rpx 12rpx;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.source-title {
  color: #1e2127;
  font-size: 28rpx;
  font-weight: 680;
}

.source-meta {
  color: #999ca2;
  font-size: 22rpx;
}

.source-link-row {
  display: flex;
  min-height: 76rpx;
  padding: 14rpx 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-top: 1rpx solid #edeef0;
  font-size: 27rpx;
}

.source-link-name {
  min-width: 0;
  flex: 1;
  color: #1a1d22;
}

.source-link-action {
  flex: none;
  color: #1d5fd1;
  font-size: 24rpx;
  font-weight: 620;
}

/* 今日答案展开层。原来走 wx.showModal，但那个控件会把 content 里的换行
   当空格吞掉，十几行事实会连成一堵墙——这是会员花钱看的正文，必须自己渲染。
   版式沿用详情页的决策快照抽屉（.snapshot-mask/.snapshot-sheet），两处是
   同一种「从底部升起的正文层」，不要各写一套。 */
.answer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(19, 23, 29, 0.42);
}

/* 只让正文滚，标题和「查看」不跟着滚出屏幕：七姐妹那张十七行的卡，
   按钮要是排在滚动区末尾，得翻到底才发现还能点进去看明细。 */
.answer-sheet {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
}

.answer-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.answer-sheet-title {
  flex: 1;
  color: #1a1d22;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.4;
}

/* 这页的点击区一律用 view+role，不用原生 button——button 自带固定宽度，
   审计脚本 audit-miniprogram.mjs 也按这条卡着。 */
.answer-sheet-close {
  flex: none;
  padding: 0 4rpx;
  color: #5e636b;
  font-size: 26rpx;
  line-height: 1.6;
}

.answer-sheet-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  margin-top: 20rpx;
}

.answer-sheet-line {
  display: block;
  color: #1a1d22;
  font-size: 27rpx;
  line-height: 1.62;
}

/* 正文里以全角空格开头的行是上一行的补充（某只股票的同期公告之类）。
