.section-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}

.section-hero,
.insight-panel,
.group-panel {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-hero {
  padding: 24rpx;
  border-color: #dceee4;
  background: #f1faf5;
}

.section-hero.us { background: #f0f7fb; border-color: #dceaf1; }
.section-hero.a { background: #f0f8f5; border-color: #dcebe5; }
.section-hero.gold { background: #fbf7ee; border-color: #eee5cf; }
.section-hero.guru { background: #f3f5f8; border-color: #e1e5eb; }

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  color: #172019;
  font-size: 40rpx;
  font-weight: 860;
}

.hero-image-wrap {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .9);
}

.hero-image {
  width: 48rpx;
  height: 48rpx;
}

.hero-metrics {
  display: flex;
  margin-top: 22rpx;
  padding-top: 19rpx;
  border-top: 1rpx solid rgba(57, 104, 77, .12);
}

.hero-metric {
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  padding: 0 10rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-metric + .hero-metric { border-left: 1rpx solid rgba(57, 104, 77, .12); }

.hero-metric text:first-child {
  overflow: hidden;
  max-width: 100%;
  color: #7e8781;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-metric text:last-child {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #1c3929;
  font-size: 28rpx;
  font-weight: 820;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-panel {
  margin-top: 14rpx;
  padding: 22rpx 24rpx 24rpx;
}

.insight-label {
  display: block;
  color: #078d4b;
  font-size: 22rpx;
  font-weight: 800;
}

.insight-conclusion {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 9rpx;
  color: #242a26;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.56;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.section-heading {
  display: flex;
  padding: 27rpx 4rpx 14rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading text:first-child {
  color: #252a27;
  font-size: 30rpx;
  font-weight: 820;
}

.section-heading text:last-child {
  color: #8a918c;
  font-size: 22rpx;
}

.group-row {
  display: flex;
  min-height: 96rpx;
  padding: 15rpx 18rpx 15rpx 20rpx;
  align-items: center;
  gap: 15rpx;
}

.group-row + .group-row { border-top: 1rpx solid #edf0ee; }

.group-row.is-empty { opacity: 0.45; }
.group-row.is-empty .group-index { background: #f0f2f1; color: #9aa19c; }

.group-empty-hint {
  flex: none;
  color: #9aa19c;
  font-size: 24rpx;
  font-weight: 600;
}

.group-index {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #eaf8f0;
  color: #078d4b;
  font-size: 22rpx;
  font-weight: 850;
}

.group-title {
  min-width: 0;
  flex: 1;
  color: #1b211d;
  font-size: 29rpx;
  font-weight: 740;
}

.group-count {
  flex: none;
  color: #7f8781;
  font-size: 22rpx;
}

.arrow {
  flex: none;
  color: #adb4af;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active { background: #eef8f2; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .section-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .hero-title { font-size: 37rpx; }
  .hero-metric { padding-right: 6rpx; padding-left: 6rpx; }
  .hero-metric text:last-child { font-size: 25rpx; }
}

@media (min-width: 700px) {
  .section-shell { padding-right: 32px; padding-left: 32px; }
  .section-hero,
  .insight-panel,
  .group-panel { border-radius: 20px; }
}
