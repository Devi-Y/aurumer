.section-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}

.section-hero,
.insight-panel,
.group-panel,
.answer-panel,
.deep-panel,
.playbook-panel,
.freshness-banner {
  overflow: hidden;
  border: 1rpx solid #e7ece9;
  border-radius: 24rpx;
  background: #ffffff;
}

.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1b211d;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #6a746e;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #eef8f2; border-color: #d7ebe1; }
.freshness-banner.tone-warn { background: #fff7ec; border-color: #f0e0c8; }
.freshness-banner.tone-bad { background: #fdf0ee; border-color: #f0d5cf; }

.section-hero {
  padding: 22rpx 24rpx;
  border-color: #e3ebe6;
  background: #ffffff;
}

.section-hero.us,
.section-hero.a,
.section-hero.gold,
.section-hero.guru {
  background: #ffffff;
  border-color: #e3ebe6;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  color: #172019;
  font-size: 36rpx;
  font-weight: 650;
}

.hero-help {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  color: #5a645e;
  font-size: 24rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-image-wrap {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f3f7f4;
}

.hero-image {
  width: 34rpx;
  height: 34rpx;
}

.hero-metrics {
  display: flex;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0ee;
}

.hero-metric {
  box-sizing: border-box;
  display: flex;
  width: 33.333333%;
  min-width: 0;
  padding: 8rpx 10rpx;
  flex-direction: column;
  align-items: center;
  border-radius: 14rpx;
  text-align: center;
}

.hero-metric + .hero-metric { border-left: 1rpx solid #edf0ee; }

.hero-metric.is-disabled {
  opacity: 0.55;
}

.metric-tap {
  background: #eef8f2;
}

.hero-metric text:first-child {
  overflow: hidden;
  max-width: 100%;
  color: #7e8781;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-metric text:last-child {
  overflow: hidden;
  max-width: 100%;
  margin-top: 5rpx;
  color: #1c3929;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-panel {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
}

.deep-panel {
  margin-top: 14rpx;
}

.answer-panel {
  margin-top: 14rpx;
}

.answer-head {
  display: flex;
  min-height: 76rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.answer-title {
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 700;
}

.answer-meta {
  color: #8a918c;
  font-size: 22rpx;
}

.answer-row {
  display: flex;
  min-height: 118rpx;
  padding: 18rpx 24rpx;
  align-items: center;
  gap: 12rpx;
}

.answer-row + .answer-row {
  border-top: 1rpx solid #edf0ee;
}

.answer-row.is-empty {
  opacity: 0.55;
}

.answer-copy {
  min-width: 0;
  flex: 1;
}

.answer-q,
.answer-a,
.answer-names {
  display: block;
}

.answer-q {
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 720;
}

.answer-a {
  margin-top: 6rpx;
  color: #3a433d;
  font-size: 24rpx;
  line-height: 1.45;
}

.answer-names {
  margin-top: 4rpx;
  color: #66706a;
  font-size: 22rpx;
  line-height: 1.4;
}

.answer-row.tone-good .answer-q { color: #0b7a53; }
.answer-row.tone-bad .answer-q { color: #a33b2b; }
.answer-row.tone-warn .answer-q { color: #8b5b20; }

.deep-row {
  display: flex;
  min-height: 108rpx;
  padding: 22rpx 24rpx;
  align-items: center;
  gap: 16rpx;
}

.deep-row + .deep-row {
  border-top: 1rpx solid #edf0ee;
}

.deep-row.is-empty {
  opacity: 0.55;
}

.deep-copy {
  min-width: 0;
  flex: 1;
}

.deep-title,
.deep-help {
  display: block;
}

.deep-title {
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 720;
}

.deep-help {
  margin-top: 6rpx;
  color: #66706a;
  font-size: 24rpx;
  line-height: 1.45;
}

.insight-line {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  gap: 14rpx;
}

.insight-label {
  flex: none;
  color: #6a756e;
  font-size: 26rpx;
  font-weight: 600;
}

.insight-target {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-target.is-link {
  color: #0b7a53;
}

.insight-grade {
  flex: none;
  max-width: 42%;
  padding: 8rpx 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8f6ef;
  color: #0b7a53;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-tap {
  opacity: 0.72;
}

.section-heading {
  display: flex;
  padding: 24rpx 4rpx 12rpx;
  align-items: center;
  justify-content: space-between;
}

.section-heading text:first-child {
  color: #3a433d;
  font-size: 30rpx;
  font-weight: 650;
}

.section-heading text:last-child {
  color: #8a918c;
  font-size: 24rpx;
}

.group-row {
  display: flex;
  min-height: 108rpx;
  padding: 16rpx 18rpx 16rpx 20rpx;
  align-items: center;
  gap: 15rpx;
}

.group-row + .group-row { border-top: 1rpx solid #edf0ee; }

.group-row.is-empty { opacity: 0.45; }
.group-row.is-empty .group-index { background: #f0f2f1; color: #9aa19c; }

.group-empty-hint {
  flex: none;
  color: #9aa19c;
  font-size: 26rpx;
  font-weight: 600;
}

.playbook-panel {
  margin-top: 16rpx;
}

.playbook-head {
  display: flex;
  min-height: 76rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.playbook-title {
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 700;
}

.playbook-meta {
  color: #8a918c;
  font-size: 22rpx;
}

.playbook-row {
  display: flex;
  min-height: 110rpx;
  padding: 18rpx 24rpx;
  align-items: center;
  gap: 12rpx;
}

.playbook-row + .playbook-row {
  border-top: 1rpx solid #edf0ee;
}

.playbook-copy {
  min-width: 0;
  flex: 1;
}

.playbook-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.playbook-name {
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 650;
}

.playbook-tag {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eef2fb;
  color: #4256c5;
  font-size: 20rpx;
  font-weight: 600;
}

.playbook-principle {
  display: block;
  margin-top: 6rpx;
  color: #6a746e;
  font-size: 23rpx;
  line-height: 1.45;
}

.group-index {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #f0f5f2;
  color: #0b7a53;
  font-size: 24rpx;
  font-weight: 650;
}

.group-copy {
  min-width: 0;
  flex: 1;
}

.group-title {
  display: block;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 650;
}

.group-help {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #6a746e;
  font-size: 22rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-count {
  flex: none;
  color: #7f8781;
  font-size: 24rpx;
}

.arrow {
  flex: none;
  color: #adb4af;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
}

.tap-active { background: #eef8f2; }

.page-note {
  display: flex;
  padding: 22rpx 10rpx 0;
  flex-direction: column;
  align-items: center;
  gap: 7rpx;
  color: #8a918c;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 340px) {
  .section-shell { padding-right: 14rpx; padding-left: 14rpx; }
  .hero-title { font-size: 37rpx; }
  .hero-metric { padding-right: 6rpx; padding-left: 6rpx; }
  .hero-metric text:last-child { font-size: 28rpx; }
}

@media (min-width: 700px) {
  .section-shell { padding-right: 32px; padding-left: 32px; }
  .section-hero,
  .insight-panel,
  .answer-panel,
  .group-panel { border-radius: 20px; }
}
