.today-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
}

/* 页头绿带，跟栏目页/新闻资讯页同一套视觉语言。 */
.today-hero {
  margin: -20rpx -20rpx 0;
  padding: 18rpx 24rpx 32rpx;
  background: linear-gradient(165deg, #0d8a5c 0%, #0b7a53 55%, #096844 100%);
}

.today-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.today-hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.today-hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-hero-help {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.45;
}

.today-status {
  margin-top: 16rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.today-status-text {
  display: block;
  color: #6a746e;
  font-size: 26rpx;
  line-height: 1.5;
}

.today-status-retry {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f7e9c9;
  color: #6b4a16;
  font-size: 25rpx;
  font-weight: 640;
}

.today-stack {
  display: flex;
  margin-top: 16rpx;
  flex-direction: column;
  gap: 16rpx;
}

.today-item {
  padding: 30rpx 26rpx;
}

.today-item-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.today-item-no {
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  color: #adb4af;
}

.today-item-badge {
  flex: none;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: #dcf0e4;
  color: #0b7a53;
  font-size: 21rpx;
  font-weight: 620;
}

.today-item-title {
  display: block;
  color: #1b211d;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.4;
}

.today-item-change {
  display: block;
  margin-top: 14rpx;
  color: #0b7a53;
  font-size: 25rpx;
  line-height: 1.5;
}

.today-item-reason {
  display: block;
  margin-top: 8rpx;
  color: #6a746e;
  font-size: 24rpx;
  line-height: 1.55;
}

.today-item-rule {
  margin: 18rpx 0;
  border-top: 1rpx solid #edf0ee;
}

.today-item-next {
  display: block;
  color: #1b211d;
  font-size: 24rpx;
  line-height: 1.55;
}

.today-item-next-label {
  color: #9aa19c;
}

.today-item-risk {
  display: flex;
  margin-top: 16rpx;
  align-items: flex-start;
  gap: 8rpx;
  color: #8b5b20;
  font-size: 23rpx;
  line-height: 1.5;
}

.today-item-risk-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #f7e9c9;
  color: #8b5b20;
  font-size: 21rpx;
  font-weight: 720;
  line-height: 30rpx;
  text-align: center;
}

.today-item-link {
  display: block;
  margin-top: 20rpx;
  color: #0b7a53;
  font-size: 25rpx;
  font-weight: 620;
}

.today-actions {
  display: flex;
  margin-top: 18rpx;
  gap: 12rpx;
}

.today-action {
  display: flex;
  min-height: 84rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #0b7a53;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 650;
}

.today-action.ghost {
  flex: none;
  padding: 0 32rpx;
  border: 1rpx solid #d7ddd9;
  background: #ffffff;
  color: #3d4f44;
}

.today-cta {
  display: flex;
  min-height: 84rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #0b7a53;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 680;
}

.tap-active {
  opacity: 0.82;
}

.page-note {
  padding: 22rpx 28rpx 0;
  color: #9aa19c;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 340px) {
  .today-item { padding: 24rpx 20rpx; }
  .today-item-title { font-size: 29rpx; }
}

@media (min-width: 700px) {
  .today-shell { padding-right: 0; padding-left: 0; }
}
