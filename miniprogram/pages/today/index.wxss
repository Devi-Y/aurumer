.today-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f5f6f7;
}

/* 页头绿带，跟栏目页/新闻资讯页同一套视觉语言。 */
.today-hero {
  margin: -20rpx -20rpx 0;
  padding: 18rpx 24rpx 32rpx;
  background: linear-gradient(165deg, #2466d6 0%, #1d5fd1 55%, #174ea9 100%);
}

.today-hero-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.today-hero-title {
  flex: none;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 720;
}

.today-hero-meta {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-hero-help {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.45;
}

.today-status {
  margin-top: 16rpx;
  padding: 44rpx 28rpx;
  text-align: center;
}

.today-status-text {
  display: block;
  color: #696d75;
  font-size: 26rpx;
  line-height: 1.5;
}

.today-status-retry {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f7e9c9;
  color: #6b4a16;
  font-size: 25rpx;
  font-weight: 640;
}

.today-stack {
  display: flex;
  margin-top: 16rpx;
  flex-direction: column;
  gap: 16rpx;
}

.today-item {
  padding: 30rpx 26rpx;
}

.today-item-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.today-item-no {
  font-family: Georgia, "Songti SC", serif;
  font-size: 40rpx;
  color: #acafb5;
}

.today-item-badge {
  flex: none;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  background: #dfe9fa;
  color: #1d5fd1;
  font-size: 21rpx;
  font-weight: 620;
}

.today-item-title {
  display: block;
  color: #1a1d22;
  font-size: 32rpx;
  font-weight: 680;
  line-height: 1.4;
}

.today-item-change {
  display: block;
  margin-top: 14rpx;
  color: #1d5fd1;
  font-size: 25rpx;
  line-height: 1.5;
}

.today-item-link {
  display: block;
  margin-top: 20rpx;
  color: #1d5fd1;
  font-size: 25rpx;
  font-weight: 620;
}

.today-actions {
  display: flex;
  margin-top: 18rpx;
  gap: 12rpx;
}

.today-action {
  display: flex;
  min-height: 84rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #1d5fd1;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 650;
}

.today-action.ghost {
  flex: none;
  padding: 0 32rpx;
  border: 1rpx solid #d6d9de;
  background: #ffffff;
  color: #3b4351;
}

.today-cta {
  display: flex;
  min-height: 84rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #1d5fd1;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 680;
}

.tap-active {
  opacity: 0.82;
}

.page-note {
  padding: 22rpx 28rpx 0;
  color: #999ca2;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

@media (max-width: 340px) {
  .today-item { padding: 24rpx 20rpx; }
  .today-item-title { font-size: 29rpx; }
}

@media (min-width: 700px) {
  .today-shell { padding-right: 0; padding-left: 0; }
}
