.workspace-shell {
  padding: 20rpx 20rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f4f6f5;
}

.workspace-status-card,
.locked-card,
.migrate-card,
.tab-bar,
.form-panel,
.record-panel,
.empty-card,
.management-panel,
.preview-panel,
.addon-hint,
.hint-card,
.freshness-banner {
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-divider {
  margin: 28rpx 4rpx 8rpx;
  color: #5f6a64;
  font-size: 24rpx;
  font-weight: 680;
  letter-spacing: 0.04em;
}

.task-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.task-actions .mini-action {
  margin: 0;
}

.brief-card {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.brief-card.is-clear {
  background: #eef8f2;
}

.brief-title {
  display: block;
  color: #1b211d;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.4;
}

.brief-line {
  display: block;
  margin-top: 10rpx;
  color: #4d5751;
  font-size: 25rpx;
  line-height: 1.5;
}

.addon-hint {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  color: #0b7a53;
  font-size: 26rpx;
  line-height: 1.5;
  background: #eef8f2;
}

.preview-panel {
  margin-top: 16rpx;
}

.preview-head {
  display: flex;
  min-height: 78rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0ee;
  color: #1b211d;
  font-size: 28rpx;
  font-weight: 680;
}

.preview-head text:last-child {
  color: #7a847e;
  font-size: 24rpx;
  font-weight: 500;
}

.preview-row {
  display: flex;
  min-height: 96rpx;
  padding: 18rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.preview-row + .preview-row { border-top: 1rpx solid #edf0ee; }

.preview-main { min-width: 0; flex: 1; }
.preview-market {
  display: block;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 650;
}
.preview-title {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #171b18;
  font-size: 30rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preview-side { flex: none; text-align: right; }
.preview-metric {
  display: block;
  color: #244f3b;
  font-size: 26rpx;
  font-weight: 700;
}
.preview-deadline {
  display: block;
  margin-top: 4rpx;
  color: #8a5a2b;
  font-size: 22rpx;
  font-weight: 620;
}

.workspace-status-card {
  display: flex;
  padding: 25rpx 27rpx;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(145deg, #e9f8f0 0%, #f9fcfa 100%);
}

.migrate-card {
  display: flex;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid #dceee4;
  background: #f3fbf7;
}

.migrate-copy {
  min-width: 0;
  flex: 1;
}

.migrate-copy text {
  display: block;
}

.migrate-copy text:first-child {
  color: #1d2a22;
  font-size: 26rpx;
  font-weight: 650;
}

.migrate-copy text:last-child {
  margin-top: 4rpx;
  color: #5a6d62;
  font-size: 22rpx;
  line-height: 1.45;
}

.migrate-button {
  flex: none;
  min-height: 68rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #0b7a53;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}
.workspace-hero-copy { min-width: 0; flex: 1; }
.workspace-hero-image-wrap {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #ffffff;
}
.workspace-hero-image-wrap image { width: 53rpx; height: 53rpx; }
.status-value,
.title,
.status-detail { display: block; }
.status-value { color: #777e79; font-size: 22rpx; font-weight: 600; }
.status-value.active { color: #0b7a53; }
.title { margin-top: 6rpx; color: #171b18; font-size: 34rpx; font-weight: 650; line-height: 1.35; }
.status-detail { margin-top: 6rpx; color: #606762; font-size: 23rpx; line-height: 1.5; }
.expire-label {
  display: block;
  margin-top: 8rpx;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 620;
}

.freshness-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
}
.freshness-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.freshness-banner .freshness-label,
.freshness-banner .freshness-tip { display: block; }
.freshness-banner .freshness-label {
  color: #1b211d;
  font-size: 24rpx;
  font-weight: 650;
}
.freshness-banner .freshness-tip {
  margin-top: 4rpx;
  color: #6a746e;
  font-size: 22rpx;
  line-height: 1.45;
}
.freshness-action {
  flex: none;
  padding: 5rpx 14rpx;
  border: 1rpx solid #d4c3a6;
  border-radius: 999rpx;
  color: #8b5b20;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}
.freshness-banner.tone-ok { background: #eef8f2; }
.freshness-banner.tone-warn { background: #fff7ec; }
.freshness-banner.tone-bad { background: #fdf0ee; }

/* 小程序的 button 默认是整行宽，flex-basis:auto 就等于「每个 tab 都想占满整条」，
   再配上 flex-shrink:0（1 0 auto 的那个 0），三个 tab 加起来是三屏宽——第三个
   「复盘」整格落在屏幕外，只有横向拖动才看得见。三等分改掉的就是这个。 */
.tab-bar-wide {
  display: flex;
  gap: 0;
}
.tab-bar-wide .tab {
  flex: 1 1 0;
  min-width: 0;
  padding: 0 12rpx;
  font-size: 24rpx;
}

.panel-tools {
  display: flex;
  min-height: 72rpx;
  padding: 0 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border-bottom: 1rpx solid #edf0ee;
  color: #1b211d;
  font-size: 26rpx;
  font-weight: 650;
}
.mini-action {
  margin: 12rpx 0 0;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: #eef8f2;
  color: #0b7a53;
  font-size: 22rpx;
  font-weight: 620;
  line-height: 1.3;
}
.record-row.is-changed {
  background: #fffaf4;
}
.evidence-line,
.source-line,
.lag-note {
  display: block;
  margin-top: 8rpx;
  color: #5a6d62;
  font-size: 22rpx;
  line-height: 1.45;
}
.lag-note { color: #6a746e; font-weight: 620; }
.diff-list { margin-top: 8rpx; }
.diff-item {
  display: block;
  margin-top: 4rpx;
  color: #3d4a43;
  font-size: 22rpx;
  line-height: 1.4;
}
.hint-card {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #f3f7f5;
  color: #4d5a53;
  font-size: 24rpx;
  line-height: 1.5;
}
.muted-panel { opacity: 0.88; }
.nested-form {
  margin: 0;
  border-radius: 0;
  box-shadow: none;
}
.nested-form .primary-button {
  margin-top: 12rpx;
}

.locked-card {
  display: flex;
  min-height: 78rpx;
  margin-top: 15rpx;
  padding: 14rpx 18rpx 14rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  background: #f7f4f1;
  color: #5c534c;
  font-size: 23rpx;
}
.locked-card text { min-width: 0; flex: 1; }
.locked-card button {
  min-height: 58rpx;
  margin: 0;
  padding: 10rpx 15rpx;
  flex: none;
  border-radius: 10rpx;
  background: #0b7a53;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.tab-bar { display: flex; margin-top: 20rpx; padding: 7rpx; background: #e9eeeb; }
.tab {
  min-height: 70rpx;
  margin: 0;
  padding: 12rpx 14rpx;
  flex: 1;
  border-radius: 18rpx;
  background: transparent;
  color: #69706b;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}
.tab.active { background: #ffffff; color: #0b7a53; }

.tab-content { margin-top: 15rpx; }

.form-toggle {
  display: flex;
  min-height: 84rpx;
  margin-top: 12rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: space-between;
  border-radius: 24rpx;
  background: #ffffff;
  color: #3d4f44;
  font-size: 27rpx;
  font-weight: 600;
}
.form-toggle.is-open {
  margin: 0 0 8rpx;
  padding: 0;
  min-height: 64rpx;
  border-radius: 0;
  background: transparent;
  color: #5a6d62;
  font-size: 24rpx;
}
.form-toggle.tap-active { background: #eef3f0; }
.form-toggle.is-open.tap-active { background: transparent; }

.form-panel {
  display: flex;
  margin-top: 12rpx;
  padding: 18rpx 22rpx 22rpx;
  flex-direction: column;
  align-items: stretch;
}
.picker-field,
.input-row,
.textarea-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  padding: 0 16rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0ee;
  color: #222723;
  font-size: 25rpx;
}
.picker-field { justify-content: space-between; }
.picker-field text:first-child,
.input-row > text,
.textarea-row > text { width: 82rpx; flex: none; color: #7b827d; }
.picker-field text:last-child { color: #078d4b; font-weight: 700; }
.textarea-row { padding-top: 16rpx; padding-bottom: 16rpx; align-items: flex-start; }
.textarea-row > text { padding-top: 1rpx; }
.text-field,
.text-area { box-sizing: border-box; min-width: 0; flex: 1; background: transparent; color: #222723; font-size: 25rpx; }
.text-field { height: 78rpx; }
.text-area { min-height: 96rpx; line-height: 1.6; }
.decision-area { min-height: 170rpx; }
.primary-button {
  width: calc(100vw - 80rpx) !important;
  min-height: 84rpx;
  margin: 18rpx 0 0;
  padding: 15rpx 20rpx;
  border-radius: 14rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.45;
}
.primary-button[disabled] { opacity: .72; }

.record-panel { margin-top: 14rpx; }
.record-row { position: relative; padding: 20rpx 21rpx 18rpx; }
.record-row + .record-row { border-top: 1rpx solid #edf0ee; }
.record-top { display: flex; padding-right: 70rpx; align-items: center; justify-content: space-between; gap: 12rpx; }
.record-tag { padding: 4rpx 10rpx; border-radius: 10rpx; background: #eaf8f0; color: #078d4b; font-size: 22rpx; font-weight: 700; }
.decision-card .record-tag { background: #f0f3f1; color: #4a5c52; }
.record-date { color: #919792; font-size: 22rpx; }
.record-title,
.record-note { display: block; padding-right: 70rpx; }
.record-title { margin-top: 11rpx; color: #222723; font-size: 28rpx; font-weight: 620; line-height: 1.45; overflow-wrap: anywhere; }
.record-title text { color: #777e79; font-size: 22rpx; font-weight: 500; }
.record-note { margin-top: 6rpx; color: #4b514d; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
.delete-button {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  min-height: 50rpx;
  margin: 0;
  padding: 7rpx 12rpx;
  border-radius: 9rpx;
  background: #f5f2f0;
  color: #7a6560;
  font-size: 22rpx;
  line-height: 1.4;
}

.empty-card { display: flex; margin-top: 14rpx; padding: 28rpx 22rpx; flex-direction: column; align-items: center; gap: 4rpx; color: #7b827d; text-align: center; }
.empty-card text:first-child { color: #292e2a; font-size: 27rpx; font-weight: 750; }
.empty-card text:last-child { font-size: 22rpx; line-height: 1.5; }

.management-panel { display: flex; margin-top: 22rpx; flex-direction: column; align-items: stretch; }
.export-button,
.delete-all-button {
  display: flex;
  width: 100%;
  min-height: 82rpx;
  margin: 0;
  padding: 15rpx 21rpx;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #ffffff;
  color: #078d4b;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: left;
}
.delete-all-button { border-top: 1rpx solid #edf0ee; color: #b44431; }
.export-button,
.delete-all-button { width: calc(100vw - 40rpx) !important; margin-right: 0; margin-left: 0; }
.export-button text:last-child,
.delete-all-button text:last-child { color: #afb5b1; font-size: 38rpx; font-weight: 300; }
.privacy-note,
.disclaimer { display: block; margin: 17rpx auto 0; color: #7b827d; font-size: 24rpx; line-height: 1.55; text-align: center; }
.disclaimer { margin-top: 5rpx; }

@media (max-width: 340px) {
  .workspace-shell { padding-right: 15rpx; padding-left: 15rpx; }
  .workspace-status-card { padding-right: 22rpx; padding-left: 22rpx; }
  .workspace-hero-image-wrap { width: 76rpx; height: 76rpx; }
  .workspace-hero-image-wrap image { width: 48rpx; height: 48rpx; }
  .title { font-size: 35rpx; }
  .form-panel { padding-right: 14rpx; padding-left: 14rpx; }
  .picker-field,
  .input-row,
  .textarea-row { padding-right: 10rpx; padding-left: 10rpx; gap: 10rpx; }
  .picker-field text:first-child,
  .input-row > text,
  .textarea-row > text { width: 70rpx; }
  .primary-button { width: calc(100vw - 58rpx) !important; }
  .export-button,
  .delete-all-button { width: calc(100vw - 30rpx) !important; }
}

@media (min-width: 700px) {
  .workspace-shell { padding: 24px 32px calc(42px + env(safe-area-inset-bottom)); }
  .tab-content { display: flex; align-items: flex-start; gap: 18px; }
  .form-panel { width: 46%; flex: none; }
  .record-panel,
  .empty-card { min-width: 0; flex: 1; margin-top: 0; }
  .primary-button { width: calc(46vw - 78px) !important; }
  .export-button,
  .delete-all-button { width: calc(100vw - 64px) !important; }
}
